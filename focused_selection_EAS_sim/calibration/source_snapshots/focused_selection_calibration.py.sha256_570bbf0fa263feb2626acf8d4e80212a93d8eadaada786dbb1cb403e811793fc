    "slim_scaling_factor",
    "candidate_pool_diploids",
    "draw_index",
    "seed",
)


@dataclass(frozen=True)
class HanSelectionEndCalibrationDesign:
    selection_coefficients: tuple[float, ...] = DEFAULT_SELECTION_COEFFICIENTS
    target_frequencies: tuple[float, ...] = DEFAULT_TARGET_FREQUENCIES
    duration_multipliers: tuple[float, ...] = DEFAULT_DURATION_MULTIPLIERS
    draws_per_candidate: int = DEFAULT_DRAWS_PER_CANDIDATE
    slim_scaling_factor: float = DEFAULT_SLIM_SCALING_FACTOR
    candidate_pool_diploids: int = DEFAULT_POOL_DIPLOIDS
    af_half_width: float = DEFAULT_AF_HALF_WIDTH
    base_seed: int = BASE_SEED

    def validate(self) -> None:
        if int(self.draws_per_candidate) < 1:
            raise ValueError("draws_per_candidate must be positive")
        if int(self.candidate_pool_diploids) < 100:
            raise ValueError("candidate_pool_diploids must be at least 100")
        if not math.isfinite(self.slim_scaling_factor) or self.slim_scaling_factor <= 0:
            raise ValueError("SLiM scaling factor must be finite and positive")
        if not 0 < self.af_half_width < 0.5:
            raise ValueError("AF half width must lie in (0, 0.5)")
        if len(set(self.selection_coefficients)) != len(self.selection_coefficients):
            raise ValueError("selection coefficients must be unique")
        if len(set(self.target_frequencies)) != len(self.target_frequencies):
            raise ValueError("target frequencies must be unique")
        if len(set(self.duration_multipliers)) != len(self.duration_multipliers):
            raise ValueError("duration multipliers must be unique")
        if any(value <= 0 for value in self.selection_coefficients):
            raise ValueError("selection coefficients must be positive")
        if any(not 0 < value < 1 for value in self.target_frequencies):
            raise ValueError("target frequencies must lie in (0, 1)")
        if any(not 0 < value <= 1 for value in self.duration_multipliers):
            raise ValueError("duration multipliers must lie in (0, 1]")


def _atomic_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        temporary.write_text(
            json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _atomic_frame(path: Path, frame: pd.DataFrame) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        frame.to_csv(temporary, sep="\t", index=False, lineterminator="\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _round_to_q(value: float, q: float) -> float:
    return float(math.floor(float(value) / float(q) + 0.5) * float(q))


def _analytic_endpoint(selection_coefficient: float, target: float) -> float:
    """Reproduce the pre-calibration Q=10 one-copy logistic endpoint."""

    initial = 0.0296 / (2.0 * 8.0)
    rate = DOMINANCE_COEFFICIENT * float(selection_coefficient)
    duration = (
        math.log(target / (1.0 - target)) - math.log(initial / (1.0 - initial))
    ) / rate
    return float(INTROGRESSION_PULSE_GENERATIONS - duration)


def build_calibration_plan(
    design: HanSelectionEndCalibrationDesign,
    *,
    production_seeds: Sequence[int],
) -> pd.DataFrame:
    """Build the immutable 840-draw default calibration plan."""

    design.validate()
    production = {int(value) for value in production_seeds}
    rows: list[dict[str, Any]] = []
    per_cell_endpoints: dict[tuple[float, float], set[float]] = {}
    for coefficient in design.selection_coefficients:
        for target in design.target_frequencies:
            analytic_end = _analytic_endpoint(coefficient, target)
            analytic_duration = INTROGRESSION_PULSE_GENERATIONS - analytic_end
            endpoints = per_cell_endpoints.setdefault((coefficient, target), set())
            for multiplier in design.duration_multipliers:
                requested = float(
                    INTROGRESSION_PULSE_GENERATIONS
                    - float(multiplier) * analytic_duration
                )
                realized = _round_to_q(requested, design.slim_scaling_factor)
                if not 0 < realized < INTROGRESSION_PULSE_GENERATIONS:
                    raise ValueError("calibration endpoint lies outside the episode")
                if realized in endpoints:
                    raise ValueError(
                        "Q rounding produced duplicate endpoints within a calibration cell"
                    )
                endpoints.add(realized)
                for draw_index in range(int(design.draws_per_candidate)):
                    identity = (
                        f"han_calibration__s{coefficient:.6f}__af{target:.6f}__"
                        f"m{multiplier:.6f}__q{design.slim_scaling_factor:g}__"
                        f"draw{draw_index:03d}"
                    )
                    seed = _stable_seed(int(design.base_seed), identity)
                    if seed in production:
                        raise ValueError("calibration seed collides with production")
                    rows.append(
                        {
                            "calibration_id": identity,
                            "selection_coefficient": float(coefficient),
                            "target_allele_frequency": float(target),
                            "population_af_lower": float(target - design.af_half_width),
                            "population_af_upper": float(target + design.af_half_width),
                            "duration_multiplier": float(multiplier),
                            "analytic_selection_end_generations_ago": analytic_end,
                            "analytic_selection_duration_generations": analytic_duration,
                            "requested_selection_end_generations_ago": requested,
                            "realized_selection_end_generations_ago": realized,
                            "slim_scaling_factor": float(design.slim_scaling_factor),
                            "candidate_pool_diploids": int(
                                design.candidate_pool_diploids
                            ),
                            "draw_index": int(draw_index),
                            "seed": int(seed),
                        }
                    )
    frame = pd.DataFrame(rows, columns=PLAN_COLUMNS)
    if frame["calibration_id"].duplicated().any() or frame["seed"].duplicated().any():
        raise RuntimeError("calibration IDs and seeds must be unique")
    return frame


apply_han_selection_end = focused_simulation.apply_han_selection_end


def _unit_for_plan_row(row: Mapping[str, Any]) -> dict[str, Any]:
    target = float(row["target_allele_frequency"])
    return {
        "unit_id": str(row["calibration_id"]),
        "demography_id": "ancient_eurasia_han_introgression",
        "demography_kind": "introgression",
        "population": "Han",
        "source_model": "stdpopsim AncientEurasia_9K19",
        "selection_origin": "archaic_specific_introgressed_standing_variation",
        "simulation_class": "selected",
        "selection_coefficient": float(row["selection_coefficient"]),
        "target_allele_frequency": target,
        "population_af_lower": float(row["population_af_lower"]),
        "population_af_upper": float(row["population_af_upper"]),
        "exact_sample_alt_count": round(200 * target),
        "sample_diploids": 100,
        "replicate_index": int(row["draw_index"]) + 1,
        "seed": int(row["seed"]),
        "sequence_length_bp": 10_000_000,
        "focal_position_bp": 5_000_000,
    }


def _draw_contract(
    row: Mapping[str, Any], repo_root: Path, slim_path: Path
) -> dict[str, Any]:
    source = Path(__file__).resolve()
    simulation_source = (
        repo_root / "python/gamma_smc_aou/focused_selection_simulation.py"
    )
    return {
        "schema": SCHEMA_VERSION,
        "plan_row": {key: row[key] for key in PLAN_COLUMNS},
        "slim_burn_in": DEFAULT_SLIM_BURN_IN,
        "calibration_contig": {
            "mode": CALIBRATION_CONTIG_MODE,
            "sequence_length_bp": CALIBRATION_CONTIG_LENGTH_BP,
            "focal_position_bp": CALIBRATION_FOCAL_POSITION_BP,
            "production_use_permitted": False,
            "selection_endpoint_statistic": "terminal_focal_allele_frequency_only",
            "ten_mb_sensitivity_required_before_freeze": True,
        },
        "sources": {
            str(source.relative_to(repo_root).as_posix()): sha256_file(source),
            str(simulation_source.relative_to(repo_root).as_posix()): sha256_file(
                simulation_source
            ),
        },
        "slim": {"path": str(slim_path), "sha256": sha256_file(slim_path)},
        "python": platform.python_version(),
        "stdpopsim": stdpopsim.__version__,
    }


def _run_draw(task: Mapping[str, Any]) -> dict[str, Any]:
    row = dict(task["row"])
    repo_root = Path(task["repo_root"]).resolve()
    slim_path = Path(task["slim_path"]).resolve()
    work_root = Path(task["work_root"]).resolve()
    timeout_seconds = float(task["timeout_seconds"])
    directory = work_root / str(row["calibration_id"])
    directory.mkdir(parents=True, exist_ok=True)
    completion_path = directory / "completion.json"
    contract = _draw_contract(row, repo_root, slim_path)
    with exclusive_unit_lock(
        directory / ".calibration.lock",
        unit_id=str(row["calibration_id"]),
        phase="han_selection_end_calibration",
    ):
        if completion_path.is_file():
            payload = json.loads(completion_path.read_text(encoding="utf-8"))
            if (
                payload.get("schema") != SCHEMA_VERSION
                or payload.get("contract_sha256") != _canonical_sha256(contract)
                or payload.get("contract") != contract
            ):
                raise ValueError("cached calibration draw is incompatible")
            return dict(payload["result"])
        unit = _unit_for_plan_row(row)
        q = float(row["slim_scaling_factor"])
        pool_diploids = int(row["candidate_pool_diploids"])
        endpoint = float(row["realized_selection_end_generations_ago"])
        model, sweep, samples, model_record = _selected_objects(
            unit,
            repo_root,
            q,
            pool_diploids,
            han_selection_end_generations_ago=endpoint,
        )
        interval_record = model_record["selection_endpoint"]["cessation"]
        sweep = replace(
            sweep,
            contig=build_focal_contig(
                sequence_length=CALIBRATION_CONTIG_LENGTH_BP,
                focal_position=CALIBRATION_FOCAL_POSITION_BP,
            ),
        )
        expectation = _selected_focal_expectation(model, sweep, q)
        expectation["focal_position_0based"] = CALIBRATION_FOCAL_POSITION_BP
        engine = stdpopsim.get_engine("slim")
        started = perf_counter()
        try:
            with _wall_clock_timeout(timeout_seconds):
                ts = engine.simulate(
                    model,
                    sweep.contig,
                    samples,
                    seed=int(row["seed"]),
                    extended_events=list(sweep.extended_events),
                    slim_path=str(slim_path),
                    slim_scaling_factor=q,
                    slim_burn_in=DEFAULT_SLIM_BURN_IN,
                    logfile=str(directory / "trajectory.csv"),
                    logfile_interval=100,
                    keep_mutation_ids_as_alleles=False,
                )
        except SimulationDrawTimeout as error:
            result = {
                **row,
                "status": "timed_out",
                "evaluable": False,
                "terminal_class": "timed_out",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "elapsed_seconds": perf_counter() - started,
                "error": str(error),
            }
        else:
            focused_simulation.FOCAL_POSITION_BP = CALIBRATION_FOCAL_POSITION_BP
            try:
                identity = focused_simulation.inspect_selected_focal_identity(
                    ts, expectation
                )
            finally:
                focused_simulation.FOCAL_POSITION_BP = 5_000_000
            if identity["status"] != "valid":
                alt_count = 0
                pool_af = 0.0
                terminal_class = "loss"
                gate_passed = False
                panel_feasible = False
            else:
                pairs = build_diploid_pair_table(ts, CALIBRATION_FOCAL_POSITION_BP)
                counts = pairs["focal_selected_allele_count"].to_numpy(dtype=int)
                if len(counts) != pool_diploids:
                    raise ValueError("calibration candidate pool has wrong size")
                alt_count = int(counts.sum())
                pool_af = float(alt_count / (2 * pool_diploids))
                terminal_class = (
                    "fixed" if alt_count == 2 * pool_diploids else "segregating"
                )
                gate_passed = bool(
                    float(row["population_af_lower"])
                    <= pool_af
                    <= float(row["population_af_upper"])
                )
                panel_feasible = bool(
                    feasible_exact_panel_genotype_triples(
                        counts,
                        sample_diploids=100,
                        exact_alt_count=int(unit["exact_sample_alt_count"]),
                    )
                )
            result = {
                **row,
                "status": "complete",
                "evaluable": True,
                "terminal_class": terminal_class,
                "candidate_pool_alt_count": alt_count,
                "candidate_pool_af": pool_af,
                "candidate_pool_frequency_gate_passed": gate_passed,
                "exact_panel_feasible": panel_feasible,
                "elapsed_seconds": perf_counter() - started,
                "error": "",
                "selection_intervals_json": json.dumps(
                    interval_record["population_intervals"],
                    sort_keys=True,
                    separators=(",", ":"),
                ),
            }
        payload = {
            "schema": SCHEMA_VERSION,
            "contract": contract,
            "contract_sha256": _canonical_sha256(contract),
            "result": result,
        }
        if result["evaluable"]:
            _atomic_json(completion_path, payload)
            (directory / "last_failure.json").unlink(missing_ok=True)
        else:
            # A timeout is an execution failure rather than a biological
            # terminal state. Preserve it, but allow a later invocation to
            # retry the same fixed seed under a larger runtime budget.
            _atomic_json(directory / "last_failure.json", payload)
        return result


def run_calibration(
    plan: pd.DataFrame,
    repo_root: str | Path,
    work_root: str | Path,
    *,
    slim_path: str | Path,
    workers: int = 4,
    timeout_seconds: float = 300.0,
) -> pd.DataFrame:
    if list(plan.columns) != list(PLAN_COLUMNS):
        raise ValueError("calibration plan columns are incompatible")
    tasks = [
        {
            "row": row,
            "repo_root": str(Path(repo_root).resolve()),
            "work_root": str(Path(work_root).resolve()),
            "slim_path": str(Path(slim_path).resolve()),
            "timeout_seconds": float(timeout_seconds),
        }
        for row in plan.to_dict(orient="records")
    ]
    rows: list[dict[str, Any]] = []
    if int(workers) == 1:
        rows = [_run_draw(task) for task in tasks]
    else:
        with ProcessPoolExecutor(max_workers=int(workers)) as pool:
            futures = {pool.submit(_run_draw, task): task for task in tasks}
            for future in as_completed(futures):
                task = futures[future]
                try:
                    rows.append(future.result())
                except Exception as error:  # noqa: BLE001 - preserve every draw failure
                    rows.append(
                        {
                            **task["row"],
                            "status": "failed",
                            "evaluable": False,
                            "terminal_class": "failed",
                            "candidate_pool_alt_count": None,
                            "candidate_pool_af": None,
                            "candidate_pool_frequency_gate_passed": False,
                            "exact_panel_feasible": False,
                            "elapsed_seconds": np.nan,
                            "error": f"{type(error).__name__}: {error}",
                        }
                    )
    return pd.DataFrame(rows).sort_values("calibration_id").reset_index(drop=True)


def summarize_terminal_draws(plan: pd.DataFrame, ledger: pd.DataFrame) -> pd.DataFrame:
    if set(plan["calibration_id"]) != set(ledger["calibration_id"]):
        raise ValueError("terminal ledger does not cover the calibration plan exactly")
    if ledger["calibration_id"].duplicated().any():
        raise ValueError("terminal ledger contains duplicate calibration IDs")
    merged = plan.merge(
        ledger[
            [
                "calibration_id",
                "status",
                "evaluable",
                "terminal_class",
                "candidate_pool_alt_count",
                "candidate_pool_af",
                "candidate_pool_frequency_gate_passed",
                "exact_panel_feasible",
                "elapsed_seconds",
                "error",
            ]
        ],
        on="calibration_id",
        how="left",
        validate="one_to_one",
    )
    rows: list[dict[str, Any]] = []
    group_columns = [
        "selection_coefficient",
        "target_allele_frequency",
        "population_af_lower",
        "population_af_upper",
        "duration_multiplier",
        "requested_selection_end_generations_ago",
        "realized_selection_end_generations_ago",
        "slim_scaling_factor",
    ]
    for keys, group in merged.groupby(group_columns, sort=True):
        key = dict(zip(group_columns, keys, strict=True))
        evaluable = group["evaluable"].fillna(False).astype(bool)
        band = group["candidate_pool_frequency_gate_passed"].fillna(False).astype(bool)
        panel = group["exact_panel_feasible"].fillna(False).astype(bool)
        segregating = group.loc[
            evaluable & group["terminal_class"].eq("segregating"),
            "candidate_pool_alt_count",
        ].astype(float)
        if len(segregating):
            median_count = float(np.median(segregating))
            median_af = median_count / (2 * DEFAULT_POOL_DIPLOIDS)
            adjusted = (median_count + 0.5) / (2 * DEFAULT_POOL_DIPLOIDS + 1)
            target = float(key["target_allele_frequency"])
            logit_error = abs(
                math.log(adjusted / (1 - adjusted)) - math.log(target / (1 - target))
            )
        else:
            median_af = np.nan
            logit_error = math.inf
        rows.append(
            {
                **key,
                "n_planned": len(group),
                "n_evaluable": int(evaluable.sum()),
                "n_loss": int(group["terminal_class"].eq("loss").sum()),
                "n_segregating": int(group["terminal_class"].eq("segregating").sum()),
                "n_fixed": int(group["terminal_class"].eq("fixed").sum()),
                "n_band_hits": int((evaluable & band & panel).sum()),
                "band_hit_rate": float((evaluable & band & panel).mean()),
                "median_segregating_pool_af": median_af,
                "absolute_logit_median_error": logit_error,
                "total_elapsed_seconds": float(
                    pd.to_numeric(group["elapsed_seconds"], errors="coerce").sum()
                ),
            }
        )
    return pd.DataFrame(rows)


def select_calibration_endpoints(summary: pd.DataFrame) -> pd.DataFrame:
    rows = []
    for _, group in summary.groupby(
        ["selection_coefficient", "target_allele_frequency"], sort=True
    ):
        ordered = group.sort_values(
            [
                "band_hit_rate",
                "absolute_logit_median_error",
                "duration_multiplier",
            ],
            ascending=[False, True, True],
            kind="mergesort",
        )
        rows.append(ordered.iloc[0].to_dict())
    return pd.DataFrame(rows).sort_values(
        ["selection_coefficient", "target_allele_frequency"], ascending=[False, True]
    )


def _plot_summary(summary: pd.DataFrame, output_prefix: Path) -> None:
    plt.rcParams.update(
        {
            "font.size": 15,
            "axes.titlesize": 17,
            "axes.labelsize": 16,
            "legend.fontsize": 12,
        }
    )
    figure, axes = plt.subplots(2, 3, figsize=(11, 8.5), sharex=True)
    for column, target in enumerate(DEFAULT_TARGET_FREQUENCIES):
        subset = summary[np.isclose(summary["target_allele_frequency"], target)]
        for coefficient, marker in ((0.01, "o"), (0.005, "s")):
            cell = subset[np.isclose(subset["selection_coefficient"], coefficient)]
            axes[0, column].plot(
                cell["duration_multiplier"],
                cell["band_hit_rate"],
                marker=marker,
                linewidth=2.5,
                label=f"s={coefficient:g}",
            )
            axes[1, column].plot(
                cell["duration_multiplier"],
                cell["median_segregating_pool_af"],
                marker=marker,
                linewidth=2.5,
            )
        axes[0, column].axhline(0.20, color="black", linestyle="--", linewidth=1.5)
        axes[1, column].axhspan(
            target - DEFAULT_AF_HALF_WIDTH,
            target + DEFAULT_AF_HALF_WIDTH,
            color="grey",
            alpha=0.2,
        )
        axes[0, column].set_title(f"Target AF {target:.0%}")
        axes[1, column].set_xlabel("Selection-duration multiplier")
    axes[0, 0].set_ylabel("Pool-band + panel hit rate")
    axes[1, 0].set_ylabel("Median segregating pool AF")
    axes[0, 0].legend(frameon=False)
    figure.suptitle("Han selection-end calibration (terminal AF only)", fontsize=20)
    figure.tight_layout(rect=(0, 0, 1, 0.95))
    figure.savefig(output_prefix.with_suffix(".png"), dpi=300)
    figure.savefig(output_prefix.with_suffix(".pdf"))
    plt.close(figure)


def finalize_calibration(
    plan: pd.DataFrame,
    ledger: pd.DataFrame,
    output_dir: str | Path,
    *,
    production_seed_digest: str,
    minimum_band_hit_rate: float = DEFAULT_MINIMUM_BAND_HIT_RATE,
    sensitivity_artifacts: Mapping[str, str] | None = None,
    sensitivity_passed: bool = False,
) -> dict[str, Any]:
    output = Path(output_dir).resolve()
    output.mkdir(parents=True, exist_ok=True)
    summary = summarize_terminal_draws(plan, ledger)
    selected = select_calibration_endpoints(summary)
    plan_path = output / "han_selection_end_plan.tsv"
    ledger_path = output / "han_selection_end_terminal_draws.tsv"
    summary_path = output / "han_selection_end_summary.tsv"
    selected_path = output / "han_selection_end_selected.tsv"
    frozen_path = output / "han_selection_end_frozen.json"
    _atomic_frame(plan_path, plan)
    _atomic_frame(ledger_path, ledger.sort_values("calibration_id"))
    _atomic_frame(summary_path, summary)
    _atomic_frame(selected_path, selected)
    _plot_summary(summary, output / "han_selection_end_response")
    complete = bool((selected["n_evaluable"] == selected["n_planned"]).all())
    adequate = bool((selected["band_hit_rate"] >= minimum_band_hit_rate).all())
    sensitivity_complete = bool(sensitivity_passed and sensitivity_artifacts)
    mapping = {
        f"s={row.selection_coefficient:.6f}|af={row.target_allele_frequency:.6f}": {
            "selection_coefficient": float(row.selection_coefficient),
            "target_allele_frequency": float(row.target_allele_frequency),
            "duration_multiplier": float(row.duration_multiplier),
            "requested_selection_end_generations_ago": float(
                row.requested_selection_end_generations_ago
            ),
            "realized_selection_end_generations_ago": float(
                row.realized_selection_end_generations_ago
            ),
            "band_hit_rate": float(row.band_hit_rate),
            "n_band_hits": int(row.n_band_hits),
            "n_evaluable": int(row.n_evaluable),
        }
        for row in selected.itertuples(index=False)
    }
    artifacts = {
        path.name: sha256_file(path)
        for path in (plan_path, ledger_path, summary_path, selected_path)
    }
    if sensitivity_artifacts is not None:
        artifacts.update(
            {str(key): str(value) for key, value in sensitivity_artifacts.items()}
        )
    payload = {
        "schema": SCHEMA_VERSION,
        "status": (
            "frozen" if complete and adequate and sensitivity_complete else "not_frozen"
        ),
        "selection_rule": (
            "maximize pool-band-and-panel hit rate; then minimize absolute logit "
            "median segregating AF error; then choose shorter duration multiplier"
        ),
        "minimum_band_hit_rate": float(minimum_band_hit_rate),
        "gamma_smc_statistics_used": False,
        "production_seed_digest": str(production_seed_digest),
        "production_contract": {
            "schema": focused_simulation.HAN_SELECTION_PRODUCTION_CONTRACT_SCHEMA,
            "slim_scaling_factor": float(plan["slim_scaling_factor"].iloc[0]),
            "candidate_pool_diploids": int(plan["candidate_pool_diploids"].iloc[0]),
            "af_half_width": float(
                plan["target_allele_frequency"].iloc[0]
                - plan["population_af_lower"].iloc[0]
            ),
            "selection_coefficients": sorted(
                float(value) for value in plan["selection_coefficient"].unique()
            ),
            "target_allele_frequencies": sorted(
                float(value) for value in plan["target_allele_frequency"].unique()
            ),
            "selection_endpoint_mode": (
                "fixed_endpoint_from_disjoint_terminal_af_calibration"
            ),
            "post_pulse_recipient_nonloss_conditioning": True,
            "screen_contig_mode": CALIBRATION_CONTIG_MODE,
            "screen_contig_production_use_permitted": False,
            "ten_mb_sensitivity_required_before_freeze": True,
            "ten_mb_sensitivity_passed": sensitivity_complete,
        },
        "mapping": mapping,
        "artifacts": artifacts,
    }
    if payload["status"] == "frozen":
        _atomic_json(frozen_path, payload)
    else:
        frozen_path.unlink(missing_ok=True)
        _atomic_json(output / "han_selection_end_not_frozen.json", payload)
    return payload


def _read_plan(path: Path) -> pd.DataFrame:
    frame = pd.read_csv(path, sep="\t")
    if list(frame.columns) != list(PLAN_COLUMNS):
        raise ValueError("calibration plan columns are incompatible")
    return frame


def _production_seed_digest(units: pd.DataFrame) -> str:
    seeds = sorted(int(value) for value in units["seed"])
    return hashlib.sha256(json.dumps(seeds, separators=(",", ":")).encode()).hexdigest()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("phase", choices=("plan", "run", "finalize"))
    parser.add_argument("--repo-root", type=Path, default=Path.cwd())
    parser.add_argument("--campaign-dir", type=Path)
    parser.add_argument("--slim-bin", type=Path)
    parser.add_argument("--workers", type=int, default=4)
    parser.add_argument("--timeout-minutes", type=float, default=5.0)
    parser.add_argument("--slim-scaling-factor", type=float, default=5.0)
    parser.add_argument("--draws-per-candidate", type=int, default=20)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    root = args.repo_root.resolve()
    campaign = (args.campaign_dir or root / "focused_selection_EAS_sim").resolve()
    if any("onedrive" in part.casefold() for part in campaign.parts):
        raise ValueError("calibration output must not be inside OneDrive")
    campaign.relative_to(root)
    units_path = campaign / "execution_units.tsv"
    units = pd.read_csv(units_path, sep="\t")
    result_dir = campaign / "calibration"
    work_root = campaign / "work" / "han_selection_end_calibration"
    plan_path = result_dir / "han_selection_end_plan.tsv"
    if args.phase == "plan":
        design = HanSelectionEndCalibrationDesign(
            draws_per_candidate=args.draws_per_candidate,
            slim_scaling_factor=args.slim_scaling_factor,
        )
        plan = build_calibration_plan(design, production_seeds=units["seed"])
        _atomic_frame(plan_path, plan)
        return 0
    plan = _read_plan(plan_path)
    if args.phase == "run":
        if args.slim_bin is None:
            raise ValueError("calibration run requires --slim-bin")
        ledger = run_calibration(
            plan,
            root,
            work_root,
            slim_path=args.slim_bin,
            workers=args.workers,
            timeout_seconds=args.timeout_minutes * 60,
        )
        _atomic_frame(result_dir / "han_selection_end_terminal_draws.tsv", ledger)
        return 0 if ledger["evaluable"].all() else 1
    ledger = pd.read_csv(result_dir / "han_selection_end_terminal_draws.tsv", sep="\t")
    payload = finalize_calibration(
        plan,
        ledger,
        result_dir,
        production_seed_digest=_production_seed_digest(units),
    )
    return 0 if payload["status"] == "frozen" else 1


