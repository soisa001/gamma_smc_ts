SCHEMA_VERSION = "gamma-smc.han-selection-end-calibration/v1"
DEFAULT_SELECTION_COEFFICIENTS = (0.01, 0.005)
DEFAULT_TARGET_FREQUENCIES = (0.10, 0.20, 0.30)
DEFAULT_DURATION_MULTIPLIERS = (0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.50)
DEFAULT_DRAWS_PER_CANDIDATE = 20
DEFAULT_SLIM_SCALING_FACTOR = 5.0
DEFAULT_POOL_DIPLOIDS = 500
DEFAULT_AF_HALF_WIDTH = 0.025
DEFAULT_MINIMUM_BAND_HIT_RATE = 0.20
CALIBRATION_CONTIG_MODE = "calibration_only_focal_2bp"
CALIBRATION_CONTIG_LENGTH_BP = 2
CALIBRATION_FOCAL_POSITION_BP = 1
PLAN_COLUMNS = (
    "calibration_id",
    "selection_coefficient",
    "target_allele_frequency",
    "population_af_lower",
    "population_af_upper",
    "duration_multiplier",
