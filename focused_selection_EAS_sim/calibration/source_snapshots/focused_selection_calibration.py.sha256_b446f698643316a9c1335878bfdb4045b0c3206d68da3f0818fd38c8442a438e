        upstream_artifact_sha256=upstream_artifact_sha256,
        reserved_seed_groups=reserved_seed_groups,
        base_seed=base_seed,
    )


def _round_to_q(value: float, q: float) -> float:
    return float(math.floor(float(value) / float(q) + 0.5) * float(q))


def _analytic_endpoint(selection_coefficient: float, target: float) -> float:
    """Reproduce the pre-calibration Q=10 one-copy logistic endpoint."""

    initial = 0.0296 / (2.0 * 8.0)
    rate = DOMINANCE_COEFFICIENT * float(selection_coefficient)
    duration = (
        math.log(target / (1.0 - target)) - math.log(initial / (1.0 - initial))
    ) / rate
    return float(INTROGRESSION_PULSE_GENERATIONS - duration)


def build_calibration_plan(
    design: HanSelectionEndCalibrationDesign,
    *,
    production_seeds: Sequence[int],
) -> pd.DataFrame:
    """Build the immutable 840-draw default calibration plan."""

    design.validate()
    production = {int(value) for value in production_seeds}
    rows: list[dict[str, Any]] = []
    per_cell_endpoints: dict[tuple[float, float], set[float]] = {}
    for coefficient in design.selection_coefficients:
        for target in design.target_frequencies:
            analytic_end = _analytic_endpoint(coefficient, target)
            analytic_duration = INTROGRESSION_PULSE_GENERATIONS - analytic_end
            endpoints = per_cell_endpoints.setdefault((coefficient, target), set())
            for multiplier in design.duration_multipliers:
                requested = float(
                    INTROGRESSION_PULSE_GENERATIONS
                    - float(multiplier) * analytic_duration
                )
                realized = _round_to_q(requested, design.slim_scaling_factor)
                if not 0 < realized < INTROGRESSION_PULSE_GENERATIONS:
                    raise ValueError("calibration endpoint lies outside the episode")
                if realized in endpoints:
                    raise ValueError(
                        "Q rounding produced duplicate endpoints within a calibration cell"
                    )
                endpoints.add(realized)
                for draw_index in range(int(design.draws_per_candidate)):
                    identity = (
                        f"han_calibration__s{coefficient:.6f}__af{target:.6f}__"
                        f"m{multiplier:.6f}__q{design.slim_scaling_factor:g}__"
                        f"draw{draw_index:03d}"
                    )
                    seed = _stable_seed(int(design.base_seed), identity)
                    if seed in production:
                        raise ValueError("calibration seed collides with production")
                    rows.append(
                        {
                            "calibration_id": identity,
                            "selection_coefficient": float(coefficient),
                            "target_allele_frequency": float(target),
                            "population_af_lower": float(target - design.af_half_width),
                            "population_af_upper": float(target + design.af_half_width),
                            "duration_multiplier": float(multiplier),
                            "analytic_selection_end_generations_ago": analytic_end,
                            "analytic_selection_duration_generations": analytic_duration,
                            "requested_selection_end_generations_ago": requested,
                            "realized_selection_end_generations_ago": realized,
                            "slim_scaling_factor": float(design.slim_scaling_factor),
                            "candidate_pool_diploids": int(
                                design.candidate_pool_diploids
                            ),
                            "draw_index": int(draw_index),
                            "seed": int(seed),
                        }
                    )
    frame = pd.DataFrame(rows, columns=PLAN_COLUMNS)
    if frame["calibration_id"].duplicated().any() or frame["seed"].duplicated().any():
        raise RuntimeError("calibration IDs and seeds must be unique")
    return frame


