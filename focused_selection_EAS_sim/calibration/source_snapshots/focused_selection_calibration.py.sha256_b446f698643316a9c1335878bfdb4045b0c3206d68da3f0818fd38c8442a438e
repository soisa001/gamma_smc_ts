@dataclass(frozen=True)
class HanSelectionEndCalibrationDesign:
    selection_coefficients: tuple[float, ...] = DEFAULT_SELECTION_COEFFICIENTS
    target_frequencies: tuple[float, ...] = DEFAULT_TARGET_FREQUENCIES
    duration_multipliers: tuple[float, ...] = DEFAULT_DURATION_MULTIPLIERS
    draws_per_candidate: int = DEFAULT_DRAWS_PER_CANDIDATE
    slim_scaling_factor: float = DEFAULT_SLIM_SCALING_FACTOR
    candidate_pool_diploids: int = DEFAULT_POOL_DIPLOIDS
    af_half_width: float = DEFAULT_AF_HALF_WIDTH
    base_seed: int = BASE_SEED

    def validate(self) -> None:
        if int(self.draws_per_candidate) < 1:
            raise ValueError("draws_per_candidate must be positive")
        if int(self.candidate_pool_diploids) < 100:
            raise ValueError("candidate_pool_diploids must be at least 100")
        if not math.isfinite(self.slim_scaling_factor) or self.slim_scaling_factor <= 0:
            raise ValueError("SLiM scaling factor must be finite and positive")
        if not 0 < self.af_half_width < 0.5:
            raise ValueError("AF half width must lie in (0, 0.5)")
        if len(set(self.selection_coefficients)) != len(self.selection_coefficients):
            raise ValueError("selection coefficients must be unique")
        if len(set(self.target_frequencies)) != len(self.target_frequencies):
            raise ValueError("target frequencies must be unique")
        if len(set(self.duration_multipliers)) != len(self.duration_multipliers):
            raise ValueError("duration multipliers must be unique")
        if any(value <= 0 for value in self.selection_coefficients):
            raise ValueError("selection coefficients must be positive")
        if any(not 0 < value < 1 for value in self.target_frequencies):
            raise ValueError("target frequencies must lie in (0, 1)")
        if any(not 0 < value <= 1 for value in self.duration_multipliers):
            raise ValueError("duration multipliers must lie in (0, 1]")


def _atomic_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        temporary.write_text(
            json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _atomic_frame(path: Path, frame: pd.DataFrame) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        frame.to_csv(temporary, sep="\t", index=False, lineterminator="\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _atomic_copy(source: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(f"{destination.name}.tmp.{os.getpid()}")
    try:
        shutil.copyfile(source, temporary)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def _coerce_boolean(value: Any) -> bool:
    if isinstance(value, (bool, np.bool_)):
        return bool(value)
    if isinstance(value, str):
        normalized = value.strip().casefold()
        if normalized in {"true", "1"}:
            return True
        if normalized in {"false", "0"}:
            return False
    if isinstance(value, (int, np.integer)) and int(value) in {0, 1}:
        return bool(value)
    raise ValueError(f"value is not an explicit boolean: {value!r}")


def _require_sha256(value: str, *, label: str) -> str:
    normalized = str(value).strip().casefold()
    if len(normalized) != 64 or any(
        character not in "0123456789abcdef" for character in normalized
    ):
        raise ValueError(f"{label} must be a SHA-256 digest")
    return normalized


def _screen_contract_binding(
    ledger: pd.DataFrame,
    screen_work_root: str | Path,
) -> dict[str, Any]:
    """Audit the common immutable contract of the evaluable screen draws."""

    work_root = Path(screen_work_root).resolve()
    source_hashes: dict[str, set[str]] = {
        "calibration": set(),
        "simulation": set(),
        "slim": set(),
        "contig_mode": set(),
    }
    audited = 0
    for row in ledger.to_dict(orient="records"):
        if not _coerce_boolean(row["evaluable"]):
            continue
        completion = work_root / str(row["calibration_id"]) / "completion.json"
        if not completion.is_file():
            raise ValueError(f"screen completion is missing: {completion}")
        payload = json.loads(completion.read_text(encoding="utf-8"))
        contract = payload.get("contract")
        if not isinstance(contract, Mapping):
            raise ValueError(f"screen completion contract is malformed: {completion}")
        if payload.get("contract_sha256") != _canonical_sha256(contract):
            raise ValueError(f"screen completion contract hash differs: {completion}")
        sources = contract.get("sources")
        if not isinstance(sources, Mapping):
            raise ValueError(f"screen source binding is malformed: {completion}")
        calibration = [
            str(value)
            for key, value in sources.items()
            if str(key).endswith("focused_selection_calibration.py")
        ]
        simulation = [
            str(value)
            for key, value in sources.items()
            if str(key).endswith("focused_selection_simulation.py")
        ]
        if len(calibration) != 1 or len(simulation) != 1:
            raise ValueError(f"screen source binding is incomplete: {completion}")
        source_hashes["calibration"].add(calibration[0])
        source_hashes["simulation"].add(simulation[0])
        source_hashes["slim"].add(str(contract["slim"]["sha256"]))
        source_hashes["contig_mode"].add(str(contract["calibration_contig"]["mode"]))
        audited += 1
    if audited < 1:
        raise ValueError("screen has no evaluable completion contracts to audit")
    if any(len(values) != 1 for values in source_hashes.values()):
        raise ValueError("screen completion contracts do not share one binding")
    contig_mode = next(iter(source_hashes["contig_mode"]))
    if contig_mode != CALIBRATION_CONTIG_MODE:
        raise ValueError(f"unexpected screen contig mode: {contig_mode}")
    return {
        "original_calibration_source_sha256": next(iter(source_hashes["calibration"])),
        "original_simulation_source_sha256": next(iter(source_hashes["simulation"])),
        "original_slim_sha256": next(iter(source_hashes["slim"])),
        "original_screen_contracts_audited": int(audited),
    }


def build_reconciliation_plan(
    plan: pd.DataFrame,
    original_ledger: pd.DataFrame,
    *,
    original_plan_sha256: str,
    original_ledger_sha256: str,
    screen_contract_binding: Mapping[str, Any],
) -> pd.DataFrame:
    """Select only screen failures caused by the post-SLiM focal overlay."""

    if list(plan.columns) != list(PLAN_COLUMNS):
        raise ValueError("calibration plan columns are incompatible")
    if original_ledger["calibration_id"].duplicated().any():
        raise ValueError("original screen ledger contains duplicate calibration IDs")
    if set(plan["calibration_id"]) != set(original_ledger["calibration_id"]):
        raise ValueError("original screen ledger does not cover the plan exactly")
    plan_digest = _require_sha256(original_plan_sha256, label="original plan")
    ledger_digest = _require_sha256(original_ledger_sha256, label="original ledger")
    calibration_source = _require_sha256(
        str(screen_contract_binding["original_calibration_source_sha256"]),
        label="original calibration source",
    )
    simulation_source = _require_sha256(
        str(screen_contract_binding["original_simulation_source_sha256"]),
        label="original simulation source",
    )
    slim_digest = _require_sha256(
        str(screen_contract_binding["original_slim_sha256"]),
        label="original SLiM binary",
    )
    contracts_audited = int(
        screen_contract_binding["original_screen_contracts_audited"]
    )
    if contracts_audited < 1:
        raise ValueError("at least one screen completion contract must be audited")
    unevaluable = original_ledger[
        ~original_ledger["evaluable"].map(_coerce_boolean)
    ].copy()
    unrelated = unevaluable[
        ~(
            unevaluable["status"].astype(str).eq("failed")
            & unevaluable["error"].astype(str).eq(RECONCILABLE_IDENTITY_ERROR)
        )
    ]
    if len(unrelated):
        identifiers = ", ".join(unrelated["calibration_id"].astype(str).head(3))
        raise ValueError(
            "screen contains unevaluable draws outside the approved reconciliation "
            f"scope: {identifiers}"
        )
    merged = plan.merge(
        unevaluable[["calibration_id", "status", "terminal_class", "error"]],
        on="calibration_id",
        how="inner",
        validate="one_to_one",
    )
    rows = []
    for row in merged.to_dict(orient="records"):
        rows.append(
            {
                **{key: row[key] for key in PLAN_COLUMNS},
                "reconciliation_id": f"no_overlay__{row['calibration_id']}",
                "original_status": str(row["status"]),
                "original_terminal_class": str(row["terminal_class"]),
                "original_error": str(row["error"]),
                "original_plan_sha256": plan_digest,
                "original_ledger_sha256": ledger_digest,
                "original_calibration_source_sha256": calibration_source,
                "original_simulation_source_sha256": simulation_source,
                "original_slim_sha256": slim_digest,
                "original_screen_contracts_audited": contracts_audited,
            }
        )
    frame = pd.DataFrame(rows, columns=RECONCILIATION_PLAN_COLUMNS)
    if len(frame) and (
        frame["calibration_id"].duplicated().any()
        or frame["reconciliation_id"].duplicated().any()
    ):
        raise RuntimeError("reconciliation plan identities must be unique")
    return frame


def audit_disjoint_seed_groups(
    seed_groups: Mapping[str, Sequence[int]],
) -> dict[str, Any]:
    """Require unique, pairwise-disjoint seeds and return a stable registry."""

    if not seed_groups:
        raise ValueError("at least one seed group is required")
    normalized: dict[str, list[int]] = {}
    for raw_name, raw_values in seed_groups.items():
        name = str(raw_name).strip()
        if not name or name in normalized:
            raise ValueError("seed-group names must be nonempty and unique")
        values = [int(value) for value in raw_values]
        if len(values) != len(set(values)):
            raise ValueError(f"seed group {name!r} contains duplicate seeds")
        if any(value < 1 or value >= 2**31 for value in values):
            raise ValueError(f"seed group {name!r} contains an invalid seed")
        normalized[name] = sorted(values)
    names = sorted(normalized)
    intersections = []
    for left_index, left in enumerate(names):
        left_values = set(normalized[left])
        for right in names[left_index + 1 :]:
            overlap = sorted(left_values.intersection(normalized[right]))
            if overlap:
                intersections.append(
                    {"left": left, "right": right, "seeds": overlap[:10]}
                )
    if intersections:
        first = intersections[0]
        raise ValueError(
            "seed groups are not disjoint: "
            f"{first['left']} vs {first['right']} share {first['seeds']}"
        )
    registry = {
        name: {
            "count": len(normalized[name]),
            "seed_sha256": hashlib.sha256(
                json.dumps(normalized[name], separators=(",", ":")).encode()
            ).hexdigest(),
            "minimum_seed": min(normalized[name]) if normalized[name] else None,
            "maximum_seed": max(normalized[name]) if normalized[name] else None,
        }
        for name in names
    }
    return {
        "schema": "gamma-smc.disjoint-seed-registry/v1",
        "status": "pairwise_disjoint",
        "groups": registry,
        "registry_sha256": _canonical_sha256(
            {name: normalized[name] for name in names}
        ),
    }


def _require_seed_groups(
    seed_groups: Mapping[str, Sequence[int]], required: Sequence[str]
) -> None:
    missing = sorted(set(required).difference(seed_groups))
    if missing:
        raise ValueError("reserved seed groups are missing: " + ", ".join(missing))


def _calibration_cells(frame: pd.DataFrame) -> set[tuple[float, float]]:
    return {
        (float(row.selection_coefficient), float(row.target_allele_frequency))
        for row in frame[["selection_coefficient", "target_allele_frequency"]]
        .drop_duplicates()
        .itertuples(index=False)
    }


def build_extension_plan(
    screen_plan: pd.DataFrame,
    canonical_screen_ledger: pd.DataFrame,
    *,
    upstream_artifact_sha256: str,
    reserved_seed_groups: Mapping[str, Sequence[int]],
    duration_multipliers: Sequence[float] = DEFAULT_EXTENSION_MULTIPLIERS,
    draws_per_candidate: int = DEFAULT_EXTENSION_DRAWS_PER_CANDIDATE,
    minimum_band_hit_rate: float = DEFAULT_MINIMUM_BAND_HIT_RATE,
    base_seed: int = BASE_SEED,
) -> pd.DataFrame:
    """Build the prespecified extension only for screen-failed cells."""

    if list(screen_plan.columns) != list(PLAN_COLUMNS):
        raise ValueError("screen plan columns are incompatible")
    if tuple(float(value) for value in duration_multipliers) != tuple(
        DEFAULT_EXTENSION_MULTIPLIERS
    ):
        raise ValueError("extension multipliers must match the frozen grid")
    if int(draws_per_candidate) != DEFAULT_EXTENSION_DRAWS_PER_CANDIDATE:
        raise ValueError("extension requires exactly 20 draws per endpoint")
    upstream = _require_sha256(
        upstream_artifact_sha256, label="canonical screen ledger"
    )
    _require_seed_groups(reserved_seed_groups, ("production", "screen"))
    audit_disjoint_seed_groups(reserved_seed_groups)
    screen_summary = summarize_terminal_draws(screen_plan, canonical_screen_ledger)
    if not (screen_summary["n_evaluable"] == screen_summary["n_planned"]).all():
        raise ValueError("screen must be fully evaluable before extension planning")
    best = screen_summary.groupby(
        ["selection_coefficient", "target_allele_frequency"], sort=True
    )["band_hit_rate"].max()
    failed_cells = {
        (float(coefficient), float(target))
        for (coefficient, target), rate in best.items()
        if float(rate) < float(minimum_band_hit_rate)
    }
    rows: list[dict[str, Any]] = []
    for coefficient, target in sorted(failed_cells, reverse=True):
        cell = screen_plan[
            np.isclose(screen_plan["selection_coefficient"], coefficient)
            & np.isclose(screen_plan["target_allele_frequency"], target)
        ]
        if len(cell) < 1:
            raise ValueError("failed screen cell is absent from the plan")
        q_values = set(cell["slim_scaling_factor"].astype(float))
        pool_values = set(cell["candidate_pool_diploids"].astype(int))
        lower_values = set(cell["population_af_lower"].astype(float))
        upper_values = set(cell["population_af_upper"].astype(float))
        if any(
            len(values) != 1
            for values in (q_values, pool_values, lower_values, upper_values)
        ):
            raise ValueError("screen cell parameters are not constant")
        q = next(iter(q_values))
        analytic_end = _analytic_endpoint(coefficient, target)
        analytic_duration = INTROGRESSION_PULSE_GENERATIONS - analytic_end
        occupied = set(cell["realized_selection_end_generations_ago"].astype(float))
        for multiplier in DEFAULT_EXTENSION_MULTIPLIERS:
            requested = float(
                INTROGRESSION_PULSE_GENERATIONS - multiplier * analytic_duration
            )
            realized = _round_to_q(requested, q)
            if not 0 < realized < INTROGRESSION_PULSE_GENERATIONS:
                raise ValueError("extension endpoint lies outside the episode")
            if realized in occupied:
                raise ValueError(
                    "extension endpoint duplicates a Q-rounded screen endpoint"
                )
            occupied.add(realized)
            for draw_index in range(DEFAULT_EXTENSION_DRAWS_PER_CANDIDATE):
                identity = (
                    f"han_extension__s{coefficient:.6f}__af{target:.6f}__"
                    f"m{multiplier:.6f}__q{q:g}__draw{draw_index:03d}"
                )
                seed = _stable_seed(int(base_seed), identity)
                rows.append(
                    {
                        "calibration_id": identity,
                        "selection_coefficient": coefficient,
                        "target_allele_frequency": target,
                        "population_af_lower": next(iter(lower_values)),
                        "population_af_upper": next(iter(upper_values)),
                        "duration_multiplier": multiplier,
                        "analytic_selection_end_generations_ago": analytic_end,
                        "analytic_selection_duration_generations": analytic_duration,
                        "requested_selection_end_generations_ago": requested,
                        "realized_selection_end_generations_ago": realized,
                        "slim_scaling_factor": q,
                        "candidate_pool_diploids": next(iter(pool_values)),
                        "draw_index": draw_index,
                        "seed": seed,
                        "calibration_phase": "extension",
                        "simulation_mode": FOCAL_ONLY_FORWARD_MODE,
                        "sequence_length_bp": CALIBRATION_CONTIG_LENGTH_BP,
                        "focal_position_bp": CALIBRATION_FOCAL_POSITION_BP,
                        "seed_namespace": "han_selection_extension_v1",
                        "upstream_artifact_sha256": upstream,
                        "reserved_seed_registry_sha256": "",
                    }
                )
    frame = pd.DataFrame(rows, columns=FOLLOWUP_PLAN_COLUMNS)
    if not len(frame):
        return frame
    if frame["calibration_id"].duplicated().any() or frame["seed"].duplicated().any():
        raise RuntimeError("extension IDs and seeds must be unique")
    groups = {**reserved_seed_groups, "extension": frame["seed"].astype(int)}
    seed_audit = audit_disjoint_seed_groups(groups)
    frame["reserved_seed_registry_sha256"] = seed_audit["registry_sha256"]
    return frame


def combine_screen_and_extension(
    screen_plan: pd.DataFrame,
    canonical_screen_ledger: pd.DataFrame,
    extension_plan: pd.DataFrame,
    extension_ledger: pd.DataFrame,
    *,
    minimum_band_hit_rate: float = DEFAULT_MINIMUM_BAND_HIT_RATE,
) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    """Select one endpoint per cell from the prespecified combined grid."""

    if list(screen_plan.columns) != list(PLAN_COLUMNS):
        raise ValueError("screen plan columns are incompatible")
    if list(extension_plan.columns) != list(FOLLOWUP_PLAN_COLUMNS):
        raise ValueError("extension plan columns are incompatible")
    if set(extension_plan["calibration_phase"].astype(str)) not in (
        set(),
        {"extension"},
    ):
        raise ValueError("follow-up plan is not an extension plan")
    screen_summary = summarize_terminal_draws(screen_plan, canonical_screen_ledger)
    if not (screen_summary["n_evaluable"] == screen_summary["n_planned"]).all():
        raise ValueError("screen is incomplete")
    failed_cells = {
        (float(coefficient), float(target))
        for (coefficient, target), rate in screen_summary.groupby(
            ["selection_coefficient", "target_allele_frequency"]
        )["band_hit_rate"]
        .max()
        .items()
        if float(rate) < float(minimum_band_hit_rate)
    }
    if _calibration_cells(extension_plan) != failed_cells:
        raise ValueError("extension plan does not exactly cover failed screen cells")
    if (
        set(extension_plan["calibration_id"]) != set(extension_ledger["calibration_id"])
        or extension_ledger["calibration_id"].duplicated().any()
    ):
        raise ValueError("extension ledger does not exactly cover its plan")
    if (
        len(extension_ledger)
        and not extension_ledger["evaluable"].map(_coerce_boolean).all()
    ):
        raise ValueError("extension ledger must be fully evaluable")
    combined_plan = pd.concat(
        [screen_plan, extension_plan[list(PLAN_COLUMNS)]], ignore_index=True
    )
    combined_ledger = pd.concat(
        [canonical_screen_ledger, extension_ledger], ignore_index=True, sort=False
    )
    if combined_plan["calibration_id"].duplicated().any():
        raise ValueError("combined plan contains duplicate identities")
    endpoint_counts = combined_plan.groupby(
        ["selection_coefficient", "target_allele_frequency"]
    )["realized_selection_end_generations_ago"].apply(lambda values: values.nunique())
    candidate_counts = combined_plan.groupby(
        ["selection_coefficient", "target_allele_frequency"]
    )["duration_multiplier"].nunique()
    if not endpoint_counts.equals(candidate_counts):
        raise ValueError("combined plan has duplicate Q-rounded endpoints")
    summary = summarize_terminal_draws(combined_plan, combined_ledger)
    selected = select_calibration_endpoints(summary)
    expected_cells = {
        (coefficient, target)
        for coefficient in DEFAULT_SELECTION_COEFFICIENTS
        for target in DEFAULT_TARGET_FREQUENCIES
    }
    if _calibration_cells(selected) != expected_cells:
        raise ValueError("combined endpoint selection does not cover six Han cells")
    if not (selected["band_hit_rate"] >= float(minimum_band_hit_rate)).all():
        raise ValueError("at least one Han cell still fails the 20% endpoint gate")
    return combined_plan, combined_ledger, summary, selected


def _build_endpoint_validation_plan(
    selected: pd.DataFrame,
    *,
    phase: str,
    draws_per_endpoint: int,
    upstream_artifact_sha256: str,
    reserved_seed_groups: Mapping[str, Sequence[int]],
    base_seed: int,
) -> pd.DataFrame:
    if phase not in {"confirmation", "sensitivity_10mb"}:
        raise ValueError("unknown endpoint-validation phase")
    expected_draws = (
        DEFAULT_CONFIRMATION_DRAWS_PER_ENDPOINT
        if phase == "confirmation"
        else DEFAULT_SENSITIVITY_DRAWS_PER_ENDPOINT
    )
    if int(draws_per_endpoint) != expected_draws:
        raise ValueError(
            f"{phase} requires exactly {expected_draws} draws per endpoint"
        )
    upstream = _require_sha256(upstream_artifact_sha256, label="selected endpoints")
    expected_cells = {
        (coefficient, target)
        for coefficient in DEFAULT_SELECTION_COEFFICIENTS
        for target in DEFAULT_TARGET_FREQUENCIES
    }
    if _calibration_cells(selected) != expected_cells or len(selected) != 6:
        raise ValueError("selected endpoints must contain exactly the six Han cells")
    if selected.duplicated(["selection_coefficient", "target_allele_frequency"]).any():
        raise ValueError("selected endpoints contain duplicate Han cells")
    if not (
        selected["band_hit_rate"].astype(float) >= DEFAULT_MINIMUM_BAND_HIT_RATE
    ).all():
        raise ValueError("selected endpoint failed the prespecified 20% screen gate")
    sequence_length = (
        CALIBRATION_CONTIG_LENGTH_BP if phase == "confirmation" else 10_000_000
    )
    focal_position = (
        CALIBRATION_FOCAL_POSITION_BP if phase == "confirmation" else 5_000_000
    )
    simulation_mode = (
        FOCAL_ONLY_FORWARD_MODE
        if phase == "confirmation"
        else PRODUCTION_10MB_SENSITIVITY_MODE
    )
    seed_namespace = f"han_selection_{phase}_v1"
    rows = []
    for selected_row in selected.sort_values(
        ["selection_coefficient", "target_allele_frequency"],
        ascending=[False, True],
    ).to_dict(orient="records"):
        q = float(selected_row["slim_scaling_factor"])
        endpoint = float(selected_row["realized_selection_end_generations_ago"])
        if endpoint != _round_to_q(endpoint, q):
            raise ValueError("selected endpoint is not Q-rounded")
        for draw_index in range(expected_draws):
            coefficient = float(selected_row["selection_coefficient"])
            target = float(selected_row["target_allele_frequency"])
            multiplier = float(selected_row["duration_multiplier"])
            analytic_end = _analytic_endpoint(coefficient, target)
            analytic_duration = INTROGRESSION_PULSE_GENERATIONS - analytic_end
            identity = (
                f"han_{phase}__s{coefficient:.6f}__af{target:.6f}__"
                f"m{multiplier:.6f}__q{q:g}__draw{draw_index:03d}"
            )
            rows.append(
                {
                    "calibration_id": identity,
                    "selection_coefficient": coefficient,
                    "target_allele_frequency": target,
                    "population_af_lower": float(selected_row["population_af_lower"]),
                    "population_af_upper": float(selected_row["population_af_upper"]),
                    "duration_multiplier": multiplier,
                    "analytic_selection_end_generations_ago": analytic_end,
                    "analytic_selection_duration_generations": analytic_duration,
                    "requested_selection_end_generations_ago": float(
                        selected_row["requested_selection_end_generations_ago"]
                    ),
                    "realized_selection_end_generations_ago": endpoint,
                    "slim_scaling_factor": q,
                    "candidate_pool_diploids": DEFAULT_POOL_DIPLOIDS,
                    "draw_index": draw_index,
                    "seed": _stable_seed(int(base_seed), identity),
                    "calibration_phase": phase,
                    "simulation_mode": simulation_mode,
                    "sequence_length_bp": sequence_length,
                    "focal_position_bp": focal_position,
                    "seed_namespace": seed_namespace,
                    "upstream_artifact_sha256": upstream,
                    "reserved_seed_registry_sha256": "",
                }
            )
    frame = pd.DataFrame(rows, columns=FOLLOWUP_PLAN_COLUMNS)
    if frame["calibration_id"].duplicated().any() or frame["seed"].duplicated().any():
        raise RuntimeError(f"{phase} IDs and seeds must be unique")
    groups = {**reserved_seed_groups, phase: frame["seed"].astype(int)}
    seed_audit = audit_disjoint_seed_groups(groups)
    frame["reserved_seed_registry_sha256"] = seed_audit["registry_sha256"]
    return frame


def build_confirmation_plan(
    selected: pd.DataFrame,
    *,
    upstream_artifact_sha256: str,
    reserved_seed_groups: Mapping[str, Sequence[int]],
    draws_per_endpoint: int = DEFAULT_CONFIRMATION_DRAWS_PER_ENDPOINT,
    base_seed: int = BASE_SEED,
) -> pd.DataFrame:
    _require_seed_groups(reserved_seed_groups, ("production", "screen", "extension"))
    audit_disjoint_seed_groups(reserved_seed_groups)
    return _build_endpoint_validation_plan(
        selected,
        phase="confirmation",
        draws_per_endpoint=draws_per_endpoint,
        upstream_artifact_sha256=upstream_artifact_sha256,
        reserved_seed_groups=reserved_seed_groups,
        base_seed=base_seed,
    )


def build_sensitivity_plan(
    selected: pd.DataFrame,
    *,
    upstream_artifact_sha256: str,
    reserved_seed_groups: Mapping[str, Sequence[int]],
    draws_per_endpoint: int = DEFAULT_SENSITIVITY_DRAWS_PER_ENDPOINT,
    base_seed: int = BASE_SEED,
