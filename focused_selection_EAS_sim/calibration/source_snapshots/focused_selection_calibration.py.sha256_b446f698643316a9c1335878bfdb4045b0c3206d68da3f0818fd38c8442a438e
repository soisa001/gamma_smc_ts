def _inspect_raw_selected_focal_identity(
    ts: tskit.TreeSequence,
    expectation: Mapping[str, Any],
) -> dict[str, Any]:
    """Validate the type-1 DrawMutation before stdpopsim post-processing."""

    coordinate = float(expectation["focal_position_0based"])
    focal_sites = [
        site
        for site in ts.sites()
        if math.isclose(float(site.position), coordinate, rel_tol=0.0, abs_tol=1e-9)
    ]
    entries: list[tuple[tskit.Mutation, Mapping[str, Any]]] = []
    malformed_metadata = False
    for site in focal_sites:
        for mutation in site.mutations:
            metadata = mutation.metadata
            if not isinstance(metadata, Mapping):
                malformed_metadata = True
                continue
            mutation_list = metadata.get("mutation_list")
            if not isinstance(mutation_list, list) or not mutation_list:
                malformed_metadata = True
                continue
            for entry in mutation_list:
                if not isinstance(entry, Mapping):
                    malformed_metadata = True
                    continue
                entries.append((mutation, entry))
    expected_type = int(expectation["expected_mutation_type"])
    selected = [
        (mutation, entry)
        for mutation, entry in entries
        if int(entry.get("mutation_type", -1)) == expected_type
    ]
    base = {
        "status": "selected_focal_mutation_absent",
        "focal_position_0based": coordinate,
        "expected_mutation_type": expected_type,
        "expected_source_subpopulation": int(expectation["source_subpopulation"]),
        "expected_origin_time_generations": float(
            expectation["realized_origin_time_generations"]
        ),
        "observed_focal_site_count": len(focal_sites),
        "observed_tskit_mutation_count": sum(
            len(site.mutations) for site in focal_sites
        ),
        "observed_metadata_entry_count": len(entries),
        "observed_mutation_types": sorted(
            {
                int(entry["mutation_type"])
                for _, entry in entries
                if "mutation_type" in entry
            }
        ),
    }
    if not selected:
        if malformed_metadata:
            raise focused_simulation.SelectedFocalIdentityError(
                "raw selected focal identity metadata is absent or malformed"
            )
        status = (
            "selected_focal_mutation_absent"
            if not focal_sites
            else "selected_focal_mutation_absent_background_only"
        )
        return {**base, "status": status, "observed_mutation_node": None}
    if len(focal_sites) != 1 or len(focal_sites[0].mutations) != 1 or len(entries) != 1:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity requires one nonrecurrent mutation and "
            "metadata entry"
        )
    if len(selected) != 1:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity contains multiple type-1 entries"
        )
    mutation, entry = selected[0]
    required = {
        "mutation_type",
        "selection_coeff",
        "subpopulation",
        "slim_time",
        "nucleotide",
    }
    missing = sorted(required.difference(entry))
    if missing:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity metadata is missing: " + ", ".join(missing)
        )
    if mutation.parent != tskit.NULL:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity must be a single root mutation"
        )
    expected_source = int(expectation["source_subpopulation"])
    observed_source = int(entry["subpopulation"])
    if observed_source != expected_source:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity source subpopulation differs from expectation"
        )
    expected_coefficient = float(expectation["expected_selection_coeff"])
    observed_coefficient = float(entry["selection_coeff"])
    if not math.isclose(
        observed_coefficient, expected_coefficient, rel_tol=0.0, abs_tol=1e-12
    ):
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal mutation selection coefficient is invalid"
        )
    q = float(expectation["slim_scaling_factor"])
    raw_age = float(mutation.time)
    observed_age = raw_age * q
    expected_age = float(expectation["realized_origin_time_generations"])
    if not math.isclose(observed_age, expected_age, rel_tol=0.0, abs_tol=1e-9):
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal origin time differs from expectation"
        )
    try:
        slim = ts.metadata["SLiM"]
        cycle = int(slim["cycle"])
        observed_q = float(slim["user_metadata"]["Q"][0])
    except (KeyError, TypeError, ValueError, IndexError) as error:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity lacks SLiM cycle/Q provenance"
        ) from error
    if not math.isclose(observed_q, q, rel_tol=0.0, abs_tol=1e-12):
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal identity Q differs from expectation"
        )
    slim_time = int(entry["slim_time"])
    if slim_time != round(cycle - raw_age):
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal slim_time is inconsistent with cycle, age, and Q"
        )
    nucleotide = int(entry["nucleotide"])
    if nucleotide not in {-1, 0, 1, 2, 3}:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal nucleotide metadata is invalid"
        )
    try:
        raw_mutation_id = int(mutation.derived_state)
    except ValueError as error:
        raise focused_simulation.SelectedFocalIdentityError(
            "raw selected focal allele is not one SLiM mutation ID"
        ) from error
    return {
        **base,
        "status": "valid",
        "observed_mutation_node": int(mutation.node),
        "observed_raw_mutation_id": raw_mutation_id,
        "observed_source_subpopulation": observed_source,
        "observed_origin_time_raw_scaled_generations": raw_age,
        "observed_origin_time_generations": observed_age,
        "observed_selection_coeff": observed_coefficient,
        "observed_slim_time": slim_time,
        "observed_slim_cycle": cycle,
        "observed_slim_scaling_factor": observed_q,
        "observed_nucleotide": nucleotide,
    }


def _selected_counts_from_raw_tree(
    ts: tskit.TreeSequence,
    identity: Mapping[str, Any],
) -> np.ndarray:
    sample_nodes = {int(node) for node in ts.samples()}
    mutation_node = identity.get("observed_mutation_node")
    carriers: set[int]
    if mutation_node is None:
        carriers = set()
    else:
        tree = ts.at(float(identity["focal_position_0based"]))
        carriers = {int(node) for node in tree.samples(int(mutation_node))}
    counts = []
    assigned = []
    for individual in ts.individuals():
        nodes = [int(node) for node in individual.nodes if int(node) in sample_nodes]
        if not nodes:
            continue
        if len(nodes) != 2:
            raise ValueError("remembered calibration sample is not diploid")
        assigned.extend(nodes)
        counts.append(sum(node in carriers for node in nodes))
    if (
        not counts
        or set(assigned) != sample_nodes
        or len(assigned) != len(set(assigned))
    ):
        raise ValueError("remembered calibration samples are not exact diploid pairs")
    return np.asarray(counts, dtype=np.int8)


def _run_reconciliation_draw(task: Mapping[str, Any]) -> dict[str, Any]:
    row = dict(task["row"])
    repo_root = Path(task["repo_root"]).resolve()
    slim_path = Path(task["slim_path"]).resolve()
    work_root = Path(task["work_root"]).resolve()
    timeout_seconds = float(task["timeout_seconds"])
    directory = work_root / str(row["reconciliation_id"])
    directory.mkdir(parents=True, exist_ok=True)
    completion_path = directory / "completion.json"
    contract = _reconciliation_contract(row, repo_root, slim_path)
    result_base = {
        **{key: row[key] for key in PLAN_COLUMNS},
        "reconciliation_id": str(row["reconciliation_id"]),
        "reconciliation_mode": RECONCILIATION_MODE,
        "original_status": str(row["original_status"]),
        "original_terminal_class": str(row["original_terminal_class"]),
        "original_error": str(row["original_error"]),
        "original_plan_sha256": str(row["original_plan_sha256"]),
        "original_ledger_sha256": str(row["original_ledger_sha256"]),
        "stdpopsim_recapitation_applied": False,
        "post_slim_neutral_mutation_overlay_applied": False,
    }
    with exclusive_unit_lock(
        directory / ".reconciliation.lock",
        unit_id=str(row["reconciliation_id"]),
        phase="han_selection_end_reconciliation",
    ):
        if completion_path.is_file():
            payload = json.loads(completion_path.read_text(encoding="utf-8"))
            if (
                payload.get("schema") != RECONCILIATION_SCHEMA_VERSION
                or payload.get("contract_sha256") != _canonical_sha256(contract)
                or payload.get("contract") != contract
            ):
                raise ValueError("cached reconciliation draw is incompatible")
            return dict(payload["result"])
        started = perf_counter()
        trajectory_path = directory / "trajectory.csv"
        try:
            unit = _unit_for_plan_row(row)
            q = float(row["slim_scaling_factor"])
            pool_diploids = int(row["candidate_pool_diploids"])
            endpoint = float(row["realized_selection_end_generations_ago"])
            model, sweep, samples, model_record = _selected_objects(
                unit,
                repo_root,
                q,
                pool_diploids,
                han_selection_end_generations_ago=endpoint,
            )
            interval_record = model_record["selection_endpoint"]["cessation"]
            sweep = replace(
                sweep,
                contig=build_focal_contig(
                    sequence_length=CALIBRATION_CONTIG_LENGTH_BP,
                    focal_position=CALIBRATION_FOCAL_POSITION_BP,
                ),
            )
            expectation = _selected_focal_expectation(model, sweep, q)
            expectation["focal_position_0based"] = CALIBRATION_FOCAL_POSITION_BP
            engine = stdpopsim.get_engine("slim")
            with _wall_clock_timeout(timeout_seconds):
                raw = engine.simulate(
                    model,
                    sweep.contig,
                    samples,
                    seed=int(row["seed"]),
                    extended_events=list(sweep.extended_events),
                    slim_path=str(slim_path),
                    slim_scaling_factor=q,
                    slim_burn_in=DEFAULT_SLIM_BURN_IN,
                    logfile=str(trajectory_path),
                    logfile_interval=100,
                    keep_mutation_ids_as_alleles=True,
                    _recap_and_rescale=False,
                )
                ts = engine._simplify_remembered(raw)
            identity = _inspect_raw_selected_focal_identity(ts, expectation)
            counts = _selected_counts_from_raw_tree(ts, identity)
            if len(counts) != pool_diploids:
                raise ValueError("reconciliation candidate pool has wrong size")
            build_diploid_pair_table(
                ts,
                CALIBRATION_FOCAL_POSITION_BP,
                focal_genotype_counts=counts,
            )
            alt_count = int(counts.sum())
            pool_af = float(alt_count / (2 * pool_diploids))
            terminal_class = (
                "loss"
                if alt_count == 0
                else "fixed"
                if alt_count == 2 * pool_diploids
                else "segregating"
            )
            gate_passed = bool(
                float(row["population_af_lower"])
                <= pool_af
                <= float(row["population_af_upper"])
            )
            panel_feasible = bool(
                feasible_exact_panel_genotype_triples(
                    counts,
                    sample_diploids=100,
                    exact_alt_count=int(unit["exact_sample_alt_count"]),
                )
            )
            result = {
                **result_base,
                "status": "complete",
                "evaluable": True,
                "terminal_class": terminal_class,
                "candidate_pool_alt_count": alt_count,
                "candidate_pool_af": pool_af,
                "candidate_pool_frequency_gate_passed": gate_passed,
                "exact_panel_feasible": panel_feasible,
                "elapsed_seconds": perf_counter() - started,
                "error": "",
                "selected_focal_identity_json": json.dumps(
                    identity, sort_keys=True, separators=(",", ":")
                ),
                "selection_intervals_json": json.dumps(
                    interval_record["population_intervals"],
                    sort_keys=True,
                    separators=(",", ":"),
                ),
                "trajectory_sha256": (
                    sha256_file(trajectory_path) if trajectory_path.is_file() else ""
                ),
            }
        except SimulationDrawTimeout as error:
            result = {
                **result_base,
                "status": "timed_out",
                "evaluable": False,
                "terminal_class": "timed_out",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "elapsed_seconds": perf_counter() - started,
                "error": str(error),
            }
        except Exception as error:  # noqa: BLE001 - preserve exact reconciliation failure
            result = {
                **result_base,
                "status": "failed",
                "evaluable": False,
                "terminal_class": "failed",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "elapsed_seconds": perf_counter() - started,
                "error": f"{type(error).__name__}: {error}",
            }
        payload = {
            "schema": RECONCILIATION_SCHEMA_VERSION,
            "contract": contract,
            "contract_sha256": _canonical_sha256(contract),
            "result": result,
        }
        if result["evaluable"]:
            _atomic_json(completion_path, payload)
            (directory / "last_failure.json").unlink(missing_ok=True)
        else:
            _atomic_json(directory / "last_failure.json", payload)
        return result


def _followup_contract(
    row: Mapping[str, Any], repo_root: Path, slim_path: Path
) -> dict[str, Any]:
    phase = str(row["calibration_phase"])
    mode = str(row["simulation_mode"])
    expected_mode = (
        FOCAL_ONLY_FORWARD_MODE
        if phase in {"extension", "confirmation"}
        else PRODUCTION_10MB_SENSITIVITY_MODE
    )
    if phase not in FOLLOWUP_PHASES or mode != expected_mode:
        raise ValueError("follow-up phase and simulation mode are incompatible")
    expected_geometry = (
        (CALIBRATION_CONTIG_LENGTH_BP, CALIBRATION_FOCAL_POSITION_BP)
        if mode == FOCAL_ONLY_FORWARD_MODE
        else (10_000_000, 5_000_000)
    )
    observed_geometry = (
        int(row["sequence_length_bp"]),
        int(row["focal_position_bp"]),
    )
    if observed_geometry != expected_geometry:
        raise ValueError("follow-up contig geometry is incompatible with its mode")
    source = Path(__file__).resolve()
    simulation_source = (
        repo_root / "python/gamma_smc_aou/focused_selection_simulation.py"
    )
    return {
        "schema": FOLLOWUP_SCHEMA_VERSION,
        "plan_row": {key: row[key] for key in FOLLOWUP_PLAN_COLUMNS},
        "phase_contract": {
            "calibration_phase": phase,
            "simulation_mode": mode,
            "terminal_statistic_only": True,
            "gamma_smc_statistics_used": False,
            "post_pulse_recipient_nonloss_conditioning": True,
            "production_use_permitted": False,
            "stdpopsim_recapitation_applied": mode == PRODUCTION_10MB_SENSITIVITY_MODE,
            "post_slim_neutral_mutation_overlay_applied": mode
            == PRODUCTION_10MB_SENSITIVITY_MODE,
            "strict_selected_focal_identity": True,
            "candidate_pool_frequency_gate": True,
            "exact_panel": (
                "actual_production_sampler_and_roundtrip_artifact_validation"
                if mode == PRODUCTION_10MB_SENSITIVITY_MODE
                else "feasibility_enumeration"
            ),
        },
        "slim_burn_in": DEFAULT_SLIM_BURN_IN,
        "sources": {
            str(source.relative_to(repo_root).as_posix()): sha256_file(source),
            str(simulation_source.relative_to(repo_root).as_posix()): sha256_file(
                simulation_source
            ),
        },
        "slim": {"path": str(slim_path), "sha256": sha256_file(slim_path)},
        "python": platform.python_version(),
        "stdpopsim": stdpopsim.__version__,
    }


def _normal_production_endpoint_result(
    ts: tskit.TreeSequence,
    expectation: Mapping[str, Any],
    unit: Mapping[str, Any],
    row: Mapping[str, Any],
    directory: Path,
) -> dict[str, Any]:
    """Run the strict production identity, pool gate, and exact-panel path."""

    try:
        identity = focused_simulation.inspect_selected_focal_identity(ts, expectation)
    except focused_simulation.SelectedFocalIdentityError as error:
        # A normal-processing recurrence/collision is itself a failed 10-Mb
        # sensitivity draw. It stays in the denominator and is never retried.
        return {
            "terminal_class": "identity_collision",
            "candidate_pool_alt_count": None,
            "candidate_pool_af": None,
            "candidate_pool_frequency_gate_passed": False,
            "exact_panel_feasible": False,
            "sensitivity_draw_passed": False,
            "strict_selected_identity_passed": False,
            "normal_production_processing_validated": False,
            "production_exact_panel_artifact_validated": False,
            "selected_focal_identity_json": "",
            "candidate_pool_frequency_gate_json": "",
            "exact_panel_record_json": "",
            "panel_tree_path": "",
            "panel_tree_sha256": "",
            "panel_manifest_path": "",
            "panel_manifest_sha256": "",
            "identity_collision_error": f"{type(error).__name__}: {error}",
        }
    if identity["status"] != "valid":
        counts = np.zeros(int(row["candidate_pool_diploids"]), dtype=np.int8)
    else:
        pool_table = build_diploid_pair_table(ts, int(row["focal_position_bp"]))
        counts = pool_table["focal_selected_allele_count"].to_numpy(dtype=int)
    if len(counts) != int(row["candidate_pool_diploids"]):
        raise ValueError("10-Mb sensitivity candidate pool has wrong size")
    gate = candidate_pool_frequency_gate(unit, counts)
    feasible = (
        feasible_exact_panel_genotype_triples(
            counts,
            sample_diploids=int(unit["sample_diploids"]),
            exact_alt_count=int(unit["exact_sample_alt_count"]),
        )
        if gate["passed"]
        else []
    )
    panel_record: Mapping[str, Any] | None = None
    panel_tree_path = directory / "accepted_panel.trees"
    panel_manifest_path = directory / "accepted_panel_manifest.tsv"
    artifact_validated = False
    if gate["passed"] and feasible:
        panel_seed = _stable_seed(int(row["seed"]), "sensitivity-exact-panel")
        panel_ts, panel_record = select_exact_sample_panel(
            ts,
            sample_diploids=int(unit["sample_diploids"]),
            exact_alt_count=int(unit["exact_sample_alt_count"]),
            seed=panel_seed,
        )
        validate_selected_focal_identity(panel_ts, expectation)
        panel_manifest = build_diploid_pair_table(
            panel_ts, int(row["focal_position_bp"])
        )
        panel_counts = panel_manifest["focal_selected_allele_count"].to_numpy(dtype=int)
        if (
            len(panel_manifest) != int(unit["sample_diploids"])
            or int(panel_counts.sum()) != int(unit["exact_sample_alt_count"])
            or np.count_nonzero(panel_counts == 0) < 2
            or np.count_nonzero(panel_counts == 1) < 1
            or np.count_nonzero(panel_counts == 2) < 2
        ):
            raise ValueError("10-Mb sensitivity exact panel violates production QC")
        _atomic_tree(panel_tree_path, panel_ts)
        _atomic_frame(panel_manifest_path, panel_manifest)
        reloaded = tskit.load(panel_tree_path)
        validate_selected_focal_identity(reloaded, expectation)
        rebuilt = build_diploid_pair_table(
            reloaded, int(row["focal_position_bp"])
        ).reset_index(drop=True)
        persisted = pd.read_csv(panel_manifest_path, sep="\t")
        pd.testing.assert_frame_equal(
            rebuilt,
            persisted,
            check_dtype=False,
            check_exact=False,
            rtol=0.0,
            atol=1e-12,
        )
        artifact_validated = True
    else:
        panel_tree_path.unlink(missing_ok=True)
        panel_manifest_path.unlink(missing_ok=True)
    alt_count = int(counts.sum())
    terminal_class = (
        "loss"
        if alt_count == 0
        else "fixed"
        if alt_count == 2 * len(counts)
        else "segregating"
    )
    passed = bool(gate["passed"] and feasible and artifact_validated)
    return {
        "terminal_class": terminal_class,
        "candidate_pool_alt_count": alt_count,
        "candidate_pool_af": float(alt_count / (2 * len(counts))),
        "candidate_pool_frequency_gate_passed": bool(gate["passed"]),
        "exact_panel_feasible": bool(feasible),
        "sensitivity_draw_passed": passed,
        "strict_selected_identity_passed": identity["status"] == "valid",
        "normal_production_processing_validated": True,
        "production_exact_panel_artifact_validated": artifact_validated,
        "selected_focal_identity_json": json.dumps(
            identity, sort_keys=True, separators=(",", ":")
        ),
        "candidate_pool_frequency_gate_json": json.dumps(
            gate, sort_keys=True, separators=(",", ":")
        ),
        "exact_panel_record_json": (
            json.dumps(panel_record, sort_keys=True, separators=(",", ":"))
            if panel_record is not None
            else ""
        ),
        "panel_tree_path": panel_tree_path.name if artifact_validated else "",
        "panel_tree_sha256": (
            sha256_file(panel_tree_path) if artifact_validated else ""
        ),
        "panel_manifest_path": (panel_manifest_path.name if artifact_validated else ""),
        "panel_manifest_sha256": (
            sha256_file(panel_manifest_path) if artifact_validated else ""
        ),
        "identity_collision_error": "",
    }


def _run_followup_draw(task: Mapping[str, Any]) -> dict[str, Any]:
    row = dict(task["row"])
    repo_root = Path(task["repo_root"]).resolve()
    slim_path = Path(task["slim_path"]).resolve()
    work_root = Path(task["work_root"]).resolve()
    timeout_seconds = float(task["timeout_seconds"])
    directory = work_root / str(row["calibration_id"])
    directory.mkdir(parents=True, exist_ok=True)
    completion_path = directory / "completion.json"
    contract = _followup_contract(row, repo_root, slim_path)
    result_base = {
        **{key: row[key] for key in FOLLOWUP_PLAN_COLUMNS},
        "stdpopsim_recapitation_applied": str(row["simulation_mode"])
        == PRODUCTION_10MB_SENSITIVITY_MODE,
        "post_slim_neutral_mutation_overlay_applied": str(row["simulation_mode"])
        == PRODUCTION_10MB_SENSITIVITY_MODE,
    }
    with exclusive_unit_lock(
        directory / ".followup.lock",
        unit_id=str(row["calibration_id"]),
        phase=f"han_selection_end_{row['calibration_phase']}",
    ):
        if completion_path.is_file():
            payload = json.loads(completion_path.read_text(encoding="utf-8"))
            if (
                payload.get("schema") != FOLLOWUP_SCHEMA_VERSION
                or payload.get("contract_sha256") != _canonical_sha256(contract)
                or payload.get("contract") != contract
            ):
                raise ValueError("cached follow-up draw is incompatible")
            cached = dict(payload["result"])
            for path_key, hash_key in (
                ("panel_tree_path", "panel_tree_sha256"),
                ("panel_manifest_path", "panel_manifest_sha256"),
            ):
                if cached.get(path_key):
                    artifact = directory / str(cached[path_key])
                    if not artifact.is_file() or sha256_file(artifact) != cached.get(
                        hash_key
                    ):
                        raise ValueError("cached follow-up panel artifact differs")
            return cached
        started = perf_counter()
        trajectory_path = directory / "trajectory.csv"
        try:
            unit = _unit_for_plan_row(row)
            q = float(row["slim_scaling_factor"])
            pool_diploids = int(row["candidate_pool_diploids"])
            endpoint = float(row["realized_selection_end_generations_ago"])
            model, sweep, samples, model_record = _selected_objects(
                unit,
                repo_root,
                q,
                pool_diploids,
                han_selection_end_generations_ago=endpoint,
            )
            interval_record = model_record["selection_endpoint"]["cessation"]
            sweep = replace(
                sweep,
                contig=build_focal_contig(
                    sequence_length=int(row["sequence_length_bp"]),
                    focal_position=int(row["focal_position_bp"]),
                ),
            )
            expectation = _selected_focal_expectation(model, sweep, q)
            expectation["focal_position_0based"] = int(row["focal_position_bp"])
            engine = stdpopsim.get_engine("slim")
            with _wall_clock_timeout(timeout_seconds):
                if str(row["simulation_mode"]) == FOCAL_ONLY_FORWARD_MODE:
                    raw = engine.simulate(
                        model,
                        sweep.contig,
                        samples,
                        seed=int(row["seed"]),
                        extended_events=list(sweep.extended_events),
                        slim_path=str(slim_path),
                        slim_scaling_factor=q,
                        slim_burn_in=DEFAULT_SLIM_BURN_IN,
                        logfile=str(trajectory_path),
                        logfile_interval=100,
                        keep_mutation_ids_as_alleles=True,
                        _recap_and_rescale=False,
                    )
                    ts = engine._simplify_remembered(raw)
                else:
                    ts = engine.simulate(
                        model,
                        sweep.contig,
                        samples,
                        seed=int(row["seed"]),
                        extended_events=list(sweep.extended_events),
                        slim_path=str(slim_path),
                        slim_scaling_factor=q,
                        slim_burn_in=DEFAULT_SLIM_BURN_IN,
                        logfile=str(trajectory_path),
                        logfile_interval=100,
                        keep_mutation_ids_as_alleles=False,
                    )
            if str(row["simulation_mode"]) == FOCAL_ONLY_FORWARD_MODE:
                identity = _inspect_raw_selected_focal_identity(ts, expectation)
                counts = _selected_counts_from_raw_tree(ts, identity)
                if len(counts) != pool_diploids:
                    raise ValueError("follow-up candidate pool has wrong size")
                build_diploid_pair_table(
                    ts,
                    int(row["focal_position_bp"]),
                    focal_genotype_counts=counts,
                )
                gate = candidate_pool_frequency_gate(unit, counts)
                feasible = feasible_exact_panel_genotype_triples(
                    counts,
                    sample_diploids=int(unit["sample_diploids"]),
                    exact_alt_count=int(unit["exact_sample_alt_count"]),
                )
                alt_count = int(counts.sum())
                endpoint_result = {
                    "terminal_class": (
                        "loss"
                        if alt_count == 0
                        else "fixed"
                        if alt_count == 2 * pool_diploids
                        else "segregating"
                    ),
                    "candidate_pool_alt_count": alt_count,
                    "candidate_pool_af": float(alt_count / (2 * pool_diploids)),
                    "candidate_pool_frequency_gate_passed": bool(gate["passed"]),
                    "exact_panel_feasible": bool(feasible),
                    "selected_focal_identity_json": json.dumps(
                        identity, sort_keys=True, separators=(",", ":")
                    ),
                    "candidate_pool_frequency_gate_json": json.dumps(
                        gate, sort_keys=True, separators=(",", ":")
                    ),
                }
            else:
                endpoint_result = _normal_production_endpoint_result(
                    ts, expectation, unit, row, directory
                )
            result = {
                **result_base,
                "status": "complete",
                "evaluable": True,
                **endpoint_result,
                "elapsed_seconds": perf_counter() - started,
                "error": endpoint_result.get("identity_collision_error", ""),
                "selection_intervals_json": json.dumps(
                    interval_record["population_intervals"],
                    sort_keys=True,
                    separators=(",", ":"),
                ),
                "trajectory_sha256": (
                    sha256_file(trajectory_path) if trajectory_path.is_file() else ""
                ),
            }
        except SimulationDrawTimeout as error:
            result = {
                **result_base,
                "status": "timed_out",
                "evaluable": False,
                "terminal_class": "timed_out",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "elapsed_seconds": perf_counter() - started,
                "error": str(error),
            }
        except Exception as error:  # noqa: BLE001 - preserve exact phase failure
            result = {
                **result_base,
                "status": "failed",
                "evaluable": False,
                "terminal_class": "failed",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "elapsed_seconds": perf_counter() - started,
                "error": f"{type(error).__name__}: {error}",
            }
        payload = {
            "schema": FOLLOWUP_SCHEMA_VERSION,
            "contract": contract,
            "contract_sha256": _canonical_sha256(contract),
            "result": result,
        }
        if result["evaluable"]:
            _atomic_json(completion_path, payload)
            (directory / "last_failure.json").unlink(missing_ok=True)
        else:
            _atomic_json(directory / "last_failure.json", payload)
        return result


def _run_draw(task: Mapping[str, Any]) -> dict[str, Any]:
    row = dict(task["row"])
    repo_root = Path(task["repo_root"]).resolve()
    slim_path = Path(task["slim_path"]).resolve()
    work_root = Path(task["work_root"]).resolve()
    timeout_seconds = float(task["timeout_seconds"])
    directory = work_root / str(row["calibration_id"])
    directory.mkdir(parents=True, exist_ok=True)
    completion_path = directory / "completion.json"
    contract = _draw_contract(row, repo_root, slim_path)
    with exclusive_unit_lock(
        directory / ".calibration.lock",
        unit_id=str(row["calibration_id"]),
        phase="han_selection_end_calibration",
    ):
        if completion_path.is_file():
            payload = json.loads(completion_path.read_text(encoding="utf-8"))
            if (
                payload.get("schema") != SCHEMA_VERSION
                or payload.get("contract_sha256") != _canonical_sha256(contract)
                or payload.get("contract") != contract
            ):
                raise ValueError("cached calibration draw is incompatible")
            return dict(payload["result"])
        unit = _unit_for_plan_row(row)
        q = float(row["slim_scaling_factor"])
        pool_diploids = int(row["candidate_pool_diploids"])
        endpoint = float(row["realized_selection_end_generations_ago"])
        model, sweep, samples, model_record = _selected_objects(
            unit,
            repo_root,
            q,
            pool_diploids,
            han_selection_end_generations_ago=endpoint,
        )
        interval_record = model_record["selection_endpoint"]["cessation"]
        sweep = replace(
            sweep,
            contig=build_focal_contig(
                sequence_length=CALIBRATION_CONTIG_LENGTH_BP,
                focal_position=CALIBRATION_FOCAL_POSITION_BP,
            ),
        )
        expectation = _selected_focal_expectation(model, sweep, q)
        expectation["focal_position_0based"] = CALIBRATION_FOCAL_POSITION_BP
        engine = stdpopsim.get_engine("slim")
        started = perf_counter()
        try:
            with _wall_clock_timeout(timeout_seconds):
                ts = engine.simulate(
                    model,
                    sweep.contig,
                    samples,
                    seed=int(row["seed"]),
                    extended_events=list(sweep.extended_events),
                    slim_path=str(slim_path),
                    slim_scaling_factor=q,
                    slim_burn_in=DEFAULT_SLIM_BURN_IN,
                    logfile=str(directory / "trajectory.csv"),
                    logfile_interval=100,
                    keep_mutation_ids_as_alleles=False,
                )
        except SimulationDrawTimeout as error:
            result = {
                **row,
                "status": "timed_out",
                "evaluable": False,
                "terminal_class": "timed_out",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "elapsed_seconds": perf_counter() - started,
                "error": str(error),
            }
        else:
            focused_simulation.FOCAL_POSITION_BP = CALIBRATION_FOCAL_POSITION_BP
            try:
                identity = focused_simulation.inspect_selected_focal_identity(
                    ts, expectation
                )
            finally:
                focused_simulation.FOCAL_POSITION_BP = 5_000_000
            if identity["status"] != "valid":
                alt_count = 0
                pool_af = 0.0
                terminal_class = "loss"
                gate_passed = False
                panel_feasible = False
            else:
                pairs = build_diploid_pair_table(ts, CALIBRATION_FOCAL_POSITION_BP)
                counts = pairs["focal_selected_allele_count"].to_numpy(dtype=int)
                if len(counts) != pool_diploids:
                    raise ValueError("calibration candidate pool has wrong size")
                alt_count = int(counts.sum())
                pool_af = float(alt_count / (2 * pool_diploids))
                terminal_class = (
                    "fixed" if alt_count == 2 * pool_diploids else "segregating"
                )
                gate_passed = bool(
                    float(row["population_af_lower"])
                    <= pool_af
                    <= float(row["population_af_upper"])
                )
                panel_feasible = bool(
                    feasible_exact_panel_genotype_triples(
                        counts,
                        sample_diploids=100,
                        exact_alt_count=int(unit["exact_sample_alt_count"]),
                    )
                )
            result = {
                **row,
                "status": "complete",
                "evaluable": True,
                "terminal_class": terminal_class,
                "candidate_pool_alt_count": alt_count,
                "candidate_pool_af": pool_af,
                "candidate_pool_frequency_gate_passed": gate_passed,
                "exact_panel_feasible": panel_feasible,
                "elapsed_seconds": perf_counter() - started,
                "error": "",
                "selection_intervals_json": json.dumps(
                    interval_record["population_intervals"],
                    sort_keys=True,
                    separators=(",", ":"),
                ),
            }
        payload = {
            "schema": SCHEMA_VERSION,
            "contract": contract,
            "contract_sha256": _canonical_sha256(contract),
            "result": result,
        }
        if result["evaluable"]:
            _atomic_json(completion_path, payload)
            (directory / "last_failure.json").unlink(missing_ok=True)
        else:
            # A timeout is an execution failure rather than a biological
            # terminal state. Preserve it, but allow a later invocation to
            # retry the same fixed seed under a larger runtime budget.
            _atomic_json(directory / "last_failure.json", payload)
        return result


def run_calibration(
    plan: pd.DataFrame,
    repo_root: str | Path,
    work_root: str | Path,
    *,
    slim_path: str | Path,
    workers: int = 4,
    timeout_seconds: float = 300.0,
) -> pd.DataFrame:
    if list(plan.columns) != list(PLAN_COLUMNS):
        raise ValueError("calibration plan columns are incompatible")
    tasks = [
        {
            "row": row,
            "repo_root": str(Path(repo_root).resolve()),
            "work_root": str(Path(work_root).resolve()),
            "slim_path": str(Path(slim_path).resolve()),
            "timeout_seconds": float(timeout_seconds),
        }
        for row in plan.to_dict(orient="records")
    ]
    rows: list[dict[str, Any]] = []
    if int(workers) == 1:
        rows = [_run_draw(task) for task in tasks]
    else:
        with ProcessPoolExecutor(max_workers=int(workers)) as pool:
            futures = {pool.submit(_run_draw, task): task for task in tasks}
            for future in as_completed(futures):
                task = futures[future]
                try:
                    rows.append(future.result())
                except Exception as error:  # noqa: BLE001 - preserve every draw failure
                    rows.append(
                        {
                            **task["row"],
                            "status": "failed",
                            "evaluable": False,
                            "terminal_class": "failed",
                            "candidate_pool_alt_count": None,
                            "candidate_pool_af": None,
                            "candidate_pool_frequency_gate_passed": False,
                            "exact_panel_feasible": False,
                            "elapsed_seconds": np.nan,
                            "error": f"{type(error).__name__}: {error}",
                        }
                    )
    return pd.DataFrame(rows).sort_values("calibration_id").reset_index(drop=True)


def run_reconciliation(
    plan: pd.DataFrame,
    repo_root: str | Path,
    work_root: str | Path,
    *,
    slim_path: str | Path,
    workers: int = 1,
    timeout_seconds: float = 900.0,
) -> pd.DataFrame:
    """Rerun approved screen failures before recapitation/neutral overlay."""

    if list(plan.columns) != list(RECONCILIATION_PLAN_COLUMNS):
        raise ValueError("reconciliation plan columns are incompatible")
    if int(workers) < 1:
        raise ValueError("reconciliation workers must be positive")
    tasks = [
        {
            "row": row,
            "repo_root": str(Path(repo_root).resolve()),
            "work_root": str(Path(work_root).resolve()),
            "slim_path": str(Path(slim_path).resolve()),
            "timeout_seconds": float(timeout_seconds),
        }
        for row in plan.to_dict(orient="records")
    ]
    rows: list[dict[str, Any]] = []
    if int(workers) == 1:
        rows = [_run_reconciliation_draw(task) for task in tasks]
    else:
        with ProcessPoolExecutor(max_workers=int(workers)) as pool:
            futures = {
                pool.submit(_run_reconciliation_draw, task): task for task in tasks
            }
            for future in as_completed(futures):
                task = futures[future]
                try:
                    rows.append(future.result())
                except Exception as error:  # noqa: BLE001 - preserve worker failure
                    row = task["row"]
                    rows.append(
                        {
                            **{key: row[key] for key in PLAN_COLUMNS},
                            "reconciliation_id": str(row["reconciliation_id"]),
                            "reconciliation_mode": RECONCILIATION_MODE,
                            "original_status": str(row["original_status"]),
                            "original_terminal_class": str(
                                row["original_terminal_class"]
                            ),
                            "original_error": str(row["original_error"]),
                            "original_plan_sha256": str(row["original_plan_sha256"]),
                            "original_ledger_sha256": str(
                                row["original_ledger_sha256"]
                            ),
                            "stdpopsim_recapitation_applied": False,
                            "post_slim_neutral_mutation_overlay_applied": False,
                            "status": "failed",
                            "evaluable": False,
                            "terminal_class": "failed",
                            "candidate_pool_alt_count": None,
                            "candidate_pool_af": None,
                            "candidate_pool_frequency_gate_passed": False,
                            "exact_panel_feasible": False,
                            "elapsed_seconds": np.nan,
                            "error": f"{type(error).__name__}: {error}",
                        }
                    )
    if not rows:
        return pd.DataFrame(columns=[*PLAN_COLUMNS, "reconciliation_id"])
    return pd.DataFrame(rows).sort_values("calibration_id").reset_index(drop=True)


def run_followup_phase(
    plan: pd.DataFrame,
    repo_root: str | Path,
    work_root: str | Path,
    *,
    slim_path: str | Path,
    workers: int = 4,
    timeout_seconds: float = 900.0,
) -> pd.DataFrame:
    """Run one immutable extension, confirmation, or sensitivity plan."""

    if list(plan.columns) != list(FOLLOWUP_PLAN_COLUMNS):
        raise ValueError("follow-up plan columns are incompatible")
    phases = set(plan["calibration_phase"].astype(str))
    if len(phases) != 1 or not phases.issubset(FOLLOWUP_PHASES):
        raise ValueError("follow-up plan must contain exactly one valid phase")
    if plan["calibration_id"].duplicated().any() or plan["seed"].duplicated().any():
        raise ValueError("follow-up plan identities and seeds must be unique")
    if plan["reserved_seed_registry_sha256"].nunique() != 1:
        raise ValueError("follow-up plan has inconsistent seed-registry binding")
    if int(workers) < 1:
        raise ValueError("follow-up workers must be positive")
    tasks = [
        {
            "row": row,
            "repo_root": str(Path(repo_root).resolve()),
            "work_root": str(Path(work_root).resolve()),
            "slim_path": str(Path(slim_path).resolve()),
            "timeout_seconds": float(timeout_seconds),
        }
        for row in plan.to_dict(orient="records")
    ]
    rows: list[dict[str, Any]] = []
    if int(workers) == 1:
        rows = [_run_followup_draw(task) for task in tasks]
    else:
        with ProcessPoolExecutor(max_workers=int(workers)) as pool:
            futures = {pool.submit(_run_followup_draw, task): task for task in tasks}
            for future in as_completed(futures):
                task = futures[future]
                try:
                    rows.append(future.result())
                except Exception as error:  # noqa: BLE001 - preserve worker failure
                    row = task["row"]
                    rows.append(
                        {
                            **row,
                            "stdpopsim_recapitation_applied": str(
                                row["simulation_mode"]
                            )
                            == PRODUCTION_10MB_SENSITIVITY_MODE,
                            "post_slim_neutral_mutation_overlay_applied": str(
                                row["simulation_mode"]
                            )
                            == PRODUCTION_10MB_SENSITIVITY_MODE,
                            "status": "failed",
                            "evaluable": False,
                            "terminal_class": "failed",
                            "candidate_pool_alt_count": None,
                            "candidate_pool_af": None,
                            "candidate_pool_frequency_gate_passed": False,
                            "exact_panel_feasible": False,
                            "elapsed_seconds": np.nan,
                            "error": f"{type(error).__name__}: {error}",
                        }
                    )
    if not rows:
        return pd.DataFrame(columns=FOLLOWUP_PLAN_COLUMNS)
    return pd.DataFrame(rows).sort_values("calibration_id").reset_index(drop=True)


def merge_reconciliation_results(
    plan: pd.DataFrame,
    original_ledger: pd.DataFrame,
    reconciliation_plan: pd.DataFrame,
    reconciliation_ledger: pd.DataFrame,
) -> pd.DataFrame:
    """Build a single-count screen ledger while preserving original failures."""

    if list(plan.columns) != list(PLAN_COLUMNS):
        raise ValueError("calibration plan columns are incompatible")
    if list(reconciliation_plan.columns) != list(RECONCILIATION_PLAN_COLUMNS):
        raise ValueError("reconciliation plan columns are incompatible")
    for label, frame in (
        ("original screen", original_ledger),
        ("reconciliation", reconciliation_ledger),
    ):
        if frame["calibration_id"].duplicated().any():
            raise ValueError(f"{label} ledger contains duplicate calibration IDs")
    if set(plan["calibration_id"]) != set(original_ledger["calibration_id"]):
        raise ValueError("original screen ledger does not cover the plan exactly")
    expected = set(reconciliation_plan["calibration_id"])
    if expected != set(reconciliation_ledger["calibration_id"]):
        raise ValueError("reconciliation ledger does not cover its plan exactly")
    approved = set(
        original_ledger.loc[
            (~original_ledger["evaluable"].map(_coerce_boolean))
            & original_ledger["status"].astype(str).eq("failed")
            & original_ledger["error"].astype(str).eq(RECONCILABLE_IDENTITY_ERROR),
            "calibration_id",
        ]
    )
    if expected != approved:
        raise ValueError(
            "reconciliation plan does not exactly match approved screen failures"
        )
    original_indexed = original_ledger.set_index("calibration_id", drop=False)
    plan_indexed = plan.set_index("calibration_id", drop=False)
    for row in reconciliation_ledger.to_dict(orient="records"):
        identity = str(row["calibration_id"])
        if int(row["seed"]) != int(plan_indexed.loc[identity, "seed"]):
            raise ValueError("reconciliation seed differs from the original plan")
        if str(row["original_status"]) != str(
            original_indexed.loc[identity, "status"]
        ) or str(row["original_error"]) != str(original_indexed.loc[identity, "error"]):
            raise ValueError("reconciliation provenance differs from original failure")
        if str(row["reconciliation_mode"]) != RECONCILIATION_MODE:
            raise ValueError("reconciliation result mode is incompatible")
        if _coerce_boolean(row["stdpopsim_recapitation_applied"]):
            raise ValueError("reconciliation unexpectedly applied recapitation")
        if _coerce_boolean(row["post_slim_neutral_mutation_overlay_applied"]):
            raise ValueError("reconciliation unexpectedly applied neutral overlay")
    retained = original_ledger[~original_ledger["calibration_id"].isin(expected)].copy()
    retained["canonical_result_source"] = "original_screen"
    replacement = reconciliation_ledger.copy()
    replacement["canonical_result_source"] = "reconciled_forward_only_no_overlay"
    canonical = pd.concat([retained, replacement], ignore_index=True, sort=False)
    if len(canonical) != len(plan) or canonical["calibration_id"].duplicated().any():
        raise RuntimeError(
            "canonical reconciliation ledger is not one row per plan draw"
        )
    if set(canonical["calibration_id"]) != set(plan["calibration_id"]):
        raise RuntimeError("canonical reconciliation ledger does not cover the plan")
    return canonical.sort_values("calibration_id").reset_index(drop=True)


def summarize_terminal_draws(plan: pd.DataFrame, ledger: pd.DataFrame) -> pd.DataFrame:
    if set(plan["calibration_id"]) != set(ledger["calibration_id"]):
        raise ValueError("terminal ledger does not cover the calibration plan exactly")
    if ledger["calibration_id"].duplicated().any():
        raise ValueError("terminal ledger contains duplicate calibration IDs")
    merged = plan.merge(
        ledger[
            [
                "calibration_id",
                "status",
                "evaluable",
                "terminal_class",
                "candidate_pool_alt_count",
                "candidate_pool_af",
                "candidate_pool_frequency_gate_passed",
                "exact_panel_feasible",
                "elapsed_seconds",
                "error",
            ]
        ],
        on="calibration_id",
        how="left",
        validate="one_to_one",
    )
    rows: list[dict[str, Any]] = []
    group_columns = [
        "selection_coefficient",
        "target_allele_frequency",
        "population_af_lower",
        "population_af_upper",
        "duration_multiplier",
        "requested_selection_end_generations_ago",
        "realized_selection_end_generations_ago",
        "slim_scaling_factor",
    ]
    for keys, group in merged.groupby(group_columns, sort=True):
        key = dict(zip(group_columns, keys, strict=True))
        evaluable = group["evaluable"].fillna(False).astype(bool)
        band = group["candidate_pool_frequency_gate_passed"].fillna(False).astype(bool)
        panel = group["exact_panel_feasible"].fillna(False).astype(bool)
        segregating = group.loc[
            evaluable & group["terminal_class"].eq("segregating"),
            "candidate_pool_alt_count",
        ].astype(float)
        if len(segregating):
            median_count = float(np.median(segregating))
            median_af = median_count / (2 * DEFAULT_POOL_DIPLOIDS)
            adjusted = (median_count + 0.5) / (2 * DEFAULT_POOL_DIPLOIDS + 1)
            target = float(key["target_allele_frequency"])
            logit_error = abs(
                math.log(adjusted / (1 - adjusted)) - math.log(target / (1 - target))
            )
        else:
            median_af = np.nan
            logit_error = math.inf
        rows.append(
            {
                **key,
                "n_planned": len(group),
                "n_evaluable": int(evaluable.sum()),
                "n_loss": int(group["terminal_class"].eq("loss").sum()),
                "n_segregating": int(group["terminal_class"].eq("segregating").sum()),
                "n_fixed": int(group["terminal_class"].eq("fixed").sum()),
                "n_band_hits": int((evaluable & band & panel).sum()),
                "band_hit_rate": float((evaluable & band & panel).mean()),
                "median_segregating_pool_af": median_af,
                "absolute_logit_median_error": logit_error,
                "total_elapsed_seconds": float(
                    pd.to_numeric(group["elapsed_seconds"], errors="coerce").sum()
                ),
            }
        )
    return pd.DataFrame(rows)


def summarize_endpoint_validation_phase(
    plan: pd.DataFrame,
    ledger: pd.DataFrame,
    *,
    minimum_band_hit_rate: float = DEFAULT_MINIMUM_BAND_HIT_RATE,
) -> pd.DataFrame:
    """Fail closed and summarize one confirmation or 10-Mb sensitivity plan."""

    if list(plan.columns) != list(FOLLOWUP_PLAN_COLUMNS):
        raise ValueError("endpoint-validation plan columns are incompatible")
    phases = set(plan["calibration_phase"].astype(str))
    if len(phases) != 1 or not phases.issubset({"confirmation", "sensitivity_10mb"}):
        raise ValueError("plan is not an endpoint-validation phase")
    phase = next(iter(phases))
    if set(plan["calibration_id"]) != set(ledger["calibration_id"]):
        raise ValueError("endpoint-validation ledger does not cover its plan")
    if ledger["calibration_id"].duplicated().any():
        raise ValueError("endpoint-validation ledger contains duplicate IDs")
    if not ledger["evaluable"].map(_coerce_boolean).all():
        raise ValueError("endpoint-validation ledger is not fully evaluable")
    expected_per_cell = (
        DEFAULT_CONFIRMATION_DRAWS_PER_ENDPOINT
        if phase == "confirmation"
        else DEFAULT_SENSITIVITY_DRAWS_PER_ENDPOINT
    )
    planned = plan.groupby(["selection_coefficient", "target_allele_frequency"]).size()
    if len(planned) != 6 or set(planned.astype(int)) != {expected_per_cell}:
        raise ValueError("endpoint-validation plan has the wrong per-cell draw count")
    merged = plan[["calibration_id", "calibration_phase", "simulation_mode"]].merge(
        ledger,
        on="calibration_id",
        how="left",
        suffixes=("_plan", ""),
        validate="one_to_one",
    )
    if (
        not (
            merged["calibration_phase_plan"].astype(str)
            == merged["calibration_phase"].astype(str)
        ).all()
        or not (
            merged["simulation_mode_plan"].astype(str)
            == merged["simulation_mode"].astype(str)
        ).all()
    ):
        raise ValueError("endpoint-validation result differs from its phase plan")
    if phase == "sensitivity_10mb":
        expected_mode = PRODUCTION_10MB_SENSITIVITY_MODE
        if set(merged["simulation_mode"].astype(str)) != {expected_mode}:
            raise ValueError("10-Mb sensitivity did not use normal production mode")
        if not merged["stdpopsim_recapitation_applied"].map(_coerce_boolean).all():
            raise ValueError("10-Mb sensitivity did not apply recapitation")
        if (
            not merged["post_slim_neutral_mutation_overlay_applied"]
            .map(_coerce_boolean)
            .all()
        ):
            raise ValueError("10-Mb sensitivity did not apply the neutral overlay")
        collision = merged["terminal_class"].astype(str).eq("identity_collision")
        ordinary = ~collision
        if (
            ordinary.any()
            and not merged.loc[ordinary, "normal_production_processing_validated"]
            .map(_coerce_boolean)
            .all()
        ):
            raise ValueError("ordinary sensitivity draws lack production validation")
        if (
            collision.any()
            and not merged.loc[collision, "error"]
            .astype(str)
            .str.startswith("SelectedFocalIdentityError:")
            .all()
        ):
            raise ValueError("identity-collision sensitivity failure is not explicit")
        hit = merged["candidate_pool_frequency_gate_passed"].map(
            _coerce_boolean
        ) & merged["exact_panel_feasible"].map(_coerce_boolean)
        if not (merged["sensitivity_draw_passed"].map(_coerce_boolean) == hit).all():
            raise ValueError("sensitivity pass field differs from pool+panel outcome")
        if (
            hit.any()
            and not merged.loc[hit, "production_exact_panel_artifact_validated"]
            .map(_coerce_boolean)
            .all()
        ):
            raise ValueError("passing sensitivity draw lacks validated panel artifact")
    else:
        if set(merged["simulation_mode"].astype(str)) != {FOCAL_ONLY_FORWARD_MODE}:
            raise ValueError("confirmation did not use the focal-only forward mode")
        if merged["stdpopsim_recapitation_applied"].map(_coerce_boolean).any():
            raise ValueError("confirmation unexpectedly applied recapitation")
        if (
            merged["post_slim_neutral_mutation_overlay_applied"]
            .map(_coerce_boolean)
            .any()
        ):
            raise ValueError("confirmation unexpectedly applied neutral overlay")
    summary = summarize_terminal_draws(plan[list(PLAN_COLUMNS)], ledger)
    if len(summary) != 6:
        raise ValueError("endpoint-validation summary does not contain six cells")
    summary["calibration_phase"] = phase
    summary["minimum_band_hit_rate"] = float(minimum_band_hit_rate)
    summary["phase_gate_passed"] = summary["band_hit_rate"] >= float(
        minimum_band_hit_rate
    )
    return summary


def select_calibration_endpoints(summary: pd.DataFrame) -> pd.DataFrame:
    rows = []
    for _, group in summary.groupby(
        ["selection_coefficient", "target_allele_frequency"], sort=True
    ):
        ordered = group.sort_values(
            [
                "band_hit_rate",
                "absolute_logit_median_error",
                "duration_multiplier",
            ],
            ascending=[False, True, True],
            kind="mergesort",
        )
        rows.append(ordered.iloc[0].to_dict())
    return pd.DataFrame(rows).sort_values(
        ["selection_coefficient", "target_allele_frequency"], ascending=[False, True]
    )


def _plot_summary(summary: pd.DataFrame, output_prefix: Path) -> None:
    plt.rcParams.update(
        {
            "font.size": 15,
            "axes.titlesize": 17,
            "axes.labelsize": 16,
            "legend.fontsize": 12,
        }
    )
    figure, axes = plt.subplots(2, 3, figsize=(11, 8.5), sharex=True)
    for column, target in enumerate(DEFAULT_TARGET_FREQUENCIES):
        subset = summary[np.isclose(summary["target_allele_frequency"], target)]
        for coefficient, marker in ((0.01, "o"), (0.005, "s")):
            cell = subset[np.isclose(subset["selection_coefficient"], coefficient)]
            axes[0, column].plot(
                cell["duration_multiplier"],
                cell["band_hit_rate"],
                marker=marker,
                linewidth=2.5,
                label=f"s={coefficient:g}",
            )
            axes[1, column].plot(
                cell["duration_multiplier"],
                cell["median_segregating_pool_af"],
                marker=marker,
                linewidth=2.5,
            )
        axes[0, column].axhline(0.20, color="black", linestyle="--", linewidth=1.5)
        axes[1, column].axhspan(
            target - DEFAULT_AF_HALF_WIDTH,
            target + DEFAULT_AF_HALF_WIDTH,
            color="grey",
            alpha=0.2,
        )
        axes[0, column].set_title(f"Target AF {target:.0%}")
        axes[1, column].set_xlabel("Selection-duration multiplier")
    axes[0, 0].set_ylabel("Pool-band + panel hit rate")
    axes[1, 0].set_ylabel("Median segregating pool AF")
    axes[0, 0].legend(frameon=False)
    figure.suptitle("Han selection-end calibration (terminal AF only)", fontsize=20)
    figure.tight_layout(rect=(0, 0, 1, 0.95))
    figure.savefig(output_prefix.with_suffix(".png"), dpi=300)
    figure.savefig(output_prefix.with_suffix(".pdf"))
    plt.close(figure)


def finalize_calibration(
    plan: pd.DataFrame,
    ledger: pd.DataFrame,
    output_dir: str | Path,
    *,
    production_seed_digest: str,
    minimum_band_hit_rate: float = DEFAULT_MINIMUM_BAND_HIT_RATE,
    sensitivity_artifacts: Mapping[str, str] | None = None,
    sensitivity_passed: bool = False,
) -> dict[str, Any]:
    output = Path(output_dir).resolve()
    output.mkdir(parents=True, exist_ok=True)
    summary = summarize_terminal_draws(plan, ledger)
    selected = select_calibration_endpoints(summary)
    plan_path = output / "han_selection_end_plan.tsv"
    ledger_path = output / "han_selection_end_terminal_draws.tsv"
    summary_path = output / "han_selection_end_summary.tsv"
    selected_path = output / "han_selection_end_selected.tsv"
    frozen_path = output / "han_selection_end_frozen.json"
    _atomic_frame(plan_path, plan)
    _atomic_frame(ledger_path, ledger.sort_values("calibration_id"))
    _atomic_frame(summary_path, summary)
    _atomic_frame(selected_path, selected)
    _plot_summary(summary, output / "han_selection_end_response")
    complete = bool((selected["n_evaluable"] == selected["n_planned"]).all())
    adequate = bool((selected["band_hit_rate"] >= minimum_band_hit_rate).all())
    sensitivity_complete = bool(sensitivity_passed and sensitivity_artifacts)
    mapping = {
        f"s={row.selection_coefficient:.6f}|af={row.target_allele_frequency:.6f}": {
            "selection_coefficient": float(row.selection_coefficient),
            "target_allele_frequency": float(row.target_allele_frequency),
            "duration_multiplier": float(row.duration_multiplier),
            "requested_selection_end_generations_ago": float(
                row.requested_selection_end_generations_ago
            ),
            "realized_selection_end_generations_ago": float(
                row.realized_selection_end_generations_ago
            ),
            "band_hit_rate": float(row.band_hit_rate),
            "n_band_hits": int(row.n_band_hits),
            "n_evaluable": int(row.n_evaluable),
        }
        for row in selected.itertuples(index=False)
    }
    artifacts = {
        path.name: sha256_file(path)
        for path in (plan_path, ledger_path, summary_path, selected_path)
    }
    if sensitivity_artifacts is not None:
        artifacts.update(
            {str(key): str(value) for key, value in sensitivity_artifacts.items()}
        )
    payload = {
        "schema": SCHEMA_VERSION,
        "status": (
            "frozen" if complete and adequate and sensitivity_complete else "not_frozen"
        ),
        "selection_rule": (
            "maximize pool-band-and-panel hit rate; then minimize absolute logit "
            "median segregating AF error; then choose shorter duration multiplier"
        ),
        "minimum_band_hit_rate": float(minimum_band_hit_rate),
        "gamma_smc_statistics_used": False,
        "production_seed_digest": str(production_seed_digest),
        "production_contract": {
            "schema": focused_simulation.HAN_SELECTION_PRODUCTION_CONTRACT_SCHEMA,
            "slim_scaling_factor": float(plan["slim_scaling_factor"].iloc[0]),
            "candidate_pool_diploids": int(plan["candidate_pool_diploids"].iloc[0]),
            "af_half_width": float(
                plan["target_allele_frequency"].iloc[0]
                - plan["population_af_lower"].iloc[0]
            ),
            "selection_coefficients": sorted(
                float(value) for value in plan["selection_coefficient"].unique()
            ),
            "target_allele_frequencies": sorted(
                float(value) for value in plan["target_allele_frequency"].unique()
            ),
            "selection_endpoint_mode": (
                "fixed_endpoint_from_disjoint_terminal_af_calibration"
            ),
            "post_pulse_recipient_nonloss_conditioning": True,
            "screen_contig_mode": CALIBRATION_CONTIG_MODE,
            "screen_contig_production_use_permitted": False,
            "ten_mb_sensitivity_required_before_freeze": True,
            "ten_mb_sensitivity_passed": sensitivity_complete,
        },
        "mapping": mapping,
        "artifacts": artifacts,
    }
    if payload["status"] == "frozen":
        _atomic_json(frozen_path, payload)
    else:
        frozen_path.unlink(missing_ok=True)
        _atomic_json(output / "han_selection_end_not_frozen.json", payload)
    return payload


