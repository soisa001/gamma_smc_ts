def _production_seed_digest(units: pd.DataFrame) -> str:
    seeds = sorted(int(value) for value in units["seed"])
    return hashlib.sha256(json.dumps(seeds, separators=(",", ":")).encode()).hexdigest()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "phase",
        choices=(
            "plan",
            "run",
            "reconcile-plan",
            "reconcile-run",
            "reconcile-merge",
            "extension-plan",
            "extension-run",
            "extension-select",
            "confirmation-plan",
            "confirmation-run",
            "confirmation-audit",
            "sensitivity-plan",
            "sensitivity-run",
            "sensitivity-audit",
            "finalize",
        ),
    )
    parser.add_argument("--repo-root", type=Path, default=Path.cwd())
    parser.add_argument("--campaign-dir", type=Path)
    parser.add_argument("--slim-bin", type=Path)
    parser.add_argument("--workers", type=int, default=4)
    parser.add_argument("--timeout-minutes", type=float, default=5.0)
    parser.add_argument("--slim-scaling-factor", type=float, default=5.0)
    parser.add_argument("--draws-per-candidate", type=int, default=20)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    root = args.repo_root.resolve()
    campaign = (args.campaign_dir or root / "focused_selection_EAS_sim").resolve()
    if any("onedrive" in part.casefold() for part in campaign.parts):
        raise ValueError("calibration output must not be inside OneDrive")
    campaign.relative_to(root)
    units_path = campaign / "execution_units.tsv"
    units = pd.read_csv(units_path, sep="\t")
    result_dir = campaign / "calibration"
    work_root = campaign / "work" / "han_selection_end_calibration"
    reconciliation_work_root = campaign / "work" / "han_selection_end_reconciliation"
    plan_path = result_dir / "han_selection_end_plan.tsv"
    if args.phase == "plan":
        design = HanSelectionEndCalibrationDesign(
            draws_per_candidate=args.draws_per_candidate,
            slim_scaling_factor=args.slim_scaling_factor,
        )
        plan = build_calibration_plan(design, production_seeds=units["seed"])
        _atomic_frame(plan_path, plan)
        return 0
    plan = _read_plan(plan_path)
    if args.phase == "run":
        if args.slim_bin is None:
            raise ValueError("calibration run requires --slim-bin")
        ledger = run_calibration(
            plan,
            root,
            work_root,
            slim_path=args.slim_bin,
            workers=args.workers,
            timeout_seconds=args.timeout_minutes * 60,
        )
        _atomic_frame(result_dir / "han_selection_end_terminal_draws.tsv", ledger)
        return 0 if ledger["evaluable"].all() else 1
    original_ledger_path = result_dir / "han_selection_end_terminal_draws.tsv"
    original_snapshot_path = (
        result_dir / "han_selection_end_terminal_draws_screen_original.tsv"
    )
    reconciliation_plan_path = result_dir / "han_selection_end_reconciliation_plan.tsv"
    reconciliation_ledger_path = (
        result_dir / "han_selection_end_reconciliation_draws.tsv"
    )
    canonical_ledger_path = (
        result_dir / "han_selection_end_terminal_draws_reconciled.tsv"
    )
    extension_plan_path = result_dir / "han_selection_end_extension_plan.tsv"
    extension_ledger_path = result_dir / "han_selection_end_extension_draws.tsv"
    extension_work_root = campaign / "work" / "han_selection_end_extension"
    combined_plan_path = result_dir / "han_selection_end_combined_plan.tsv"
    combined_ledger_path = result_dir / "han_selection_end_combined_draws.tsv"
    combined_summary_path = result_dir / "han_selection_end_combined_summary.tsv"
    selected_path = result_dir / "han_selection_end_selected.tsv"
    confirmation_plan_path = result_dir / "han_selection_end_confirmation_plan.tsv"
    confirmation_ledger_path = result_dir / "han_selection_end_confirmation_draws.tsv"
    confirmation_work_root = campaign / "work" / "han_selection_end_confirmation"
    sensitivity_plan_path = result_dir / "han_selection_end_sensitivity_10mb_plan.tsv"
    sensitivity_ledger_path = (
        result_dir / "han_selection_end_sensitivity_10mb_draws.tsv"
    )
    sensitivity_work_root = campaign / "work" / "han_selection_end_sensitivity_10mb"
    if args.phase == "reconcile-plan":
        original_ledger = pd.read_csv(original_ledger_path, sep="\t")
        if original_snapshot_path.is_file():
            if sha256_file(original_snapshot_path) != sha256_file(original_ledger_path):
                raise ValueError(
                    "existing original screen snapshot differs from the source ledger"
                )
        else:
            _atomic_copy(original_ledger_path, original_snapshot_path)
        binding = _screen_contract_binding(original_ledger, work_root)
        reconciliation_plan = build_reconciliation_plan(
            plan,
            original_ledger,
            original_plan_sha256=sha256_file(plan_path),
            original_ledger_sha256=sha256_file(original_snapshot_path),
            screen_contract_binding=binding,
        )
        if not len(reconciliation_plan):
            raise ValueError("screen has no approved failures to reconcile")
        _atomic_frame(reconciliation_plan_path, reconciliation_plan)
        return 0
    if args.phase == "reconcile-run":
        if args.slim_bin is None:
            raise ValueError("reconciliation run requires --slim-bin")
        reconciliation_plan = _read_reconciliation_plan(reconciliation_plan_path)
        reconciliation_ledger = run_reconciliation(
            reconciliation_plan,
            root,
            reconciliation_work_root,
            slim_path=args.slim_bin,
            workers=args.workers,
            timeout_seconds=args.timeout_minutes * 60,
        )
        _atomic_frame(reconciliation_ledger_path, reconciliation_ledger)
        return 0 if reconciliation_ledger["evaluable"].map(_coerce_boolean).all() else 1
    if args.phase == "reconcile-merge":
        reconciliation_plan = _read_reconciliation_plan(reconciliation_plan_path)
        if not original_snapshot_path.is_file():
            raise ValueError("original screen ledger snapshot is missing")
        expected_plan_hashes = set(
            reconciliation_plan["original_plan_sha256"].astype(str)
        )
        expected_ledger_hashes = set(
            reconciliation_plan["original_ledger_sha256"].astype(str)
        )
        if expected_plan_hashes != {sha256_file(plan_path)}:
            raise ValueError("reconciliation plan is bound to another screen plan")
        if expected_ledger_hashes != {sha256_file(original_snapshot_path)}:
            raise ValueError("reconciliation plan is bound to another screen ledger")
        original_ledger = pd.read_csv(original_snapshot_path, sep="\t")
        reconciliation_ledger = pd.read_csv(reconciliation_ledger_path, sep="\t")
        canonical = merge_reconciliation_results(
            plan,
            original_ledger,
            reconciliation_plan,
            reconciliation_ledger,
        )
        _atomic_frame(canonical_ledger_path, canonical)
        original_trajectories = {
            str(identity): sha256_file(work_root / str(identity) / "trajectory.csv")
            for identity in reconciliation_plan["calibration_id"]
        }
        artifacts = {
            path.name: sha256_file(path)
            for path in (
                plan_path,
                original_snapshot_path,
                reconciliation_plan_path,
                reconciliation_ledger_path,
                canonical_ledger_path,
            )
        }
        screen_log = result_dir / "han_selection_end_screen_q5.log"
        if screen_log.is_file():
            artifacts[screen_log.name] = sha256_file(screen_log)
        _atomic_json(
            result_dir / "han_selection_end_reconciliation_audit.json",
            {
                "schema": RECONCILIATION_SCHEMA_VERSION,
                "status": (
                    "complete"
                    if canonical["evaluable"].map(_coerce_boolean).all()
                    else "incomplete"
                ),
                "mode": RECONCILIATION_MODE,
                "original_screen_rows": int(len(original_ledger)),
                "reconciled_rows": int(len(reconciliation_ledger)),
                "canonical_rows": int(len(canonical)),
                "canonical_unique_ids": int(canonical["calibration_id"].nunique()),
                "original_failure_trajectory_sha256": original_trajectories,
                "artifacts": artifacts,
            },
        )
        return 0 if canonical["evaluable"].map(_coerce_boolean).all() else 1
    if args.phase == "extension-plan":
        if not canonical_ledger_path.is_file():
            raise ValueError("reconciled canonical screen ledger is missing")
        canonical = pd.read_csv(canonical_ledger_path, sep="\t")
        reserved = {
            "production": units["seed"].astype(int),
            "screen": plan["seed"].astype(int),
        }
        extension_plan = build_extension_plan(
            plan,
            canonical,
            upstream_artifact_sha256=sha256_file(canonical_ledger_path),
            reserved_seed_groups=reserved,
        )
        if not len(extension_plan):
            raise ValueError("all screen cells passed; extension is not permitted")
        _atomic_frame(extension_plan_path, extension_plan)
        _atomic_json(
            result_dir / "han_selection_end_extension_seed_audit.json",
            audit_disjoint_seed_groups(
                {**reserved, "extension": extension_plan["seed"].astype(int)}
            ),
        )
        return 0
    if args.phase == "extension-run":
        if args.slim_bin is None:
            raise ValueError("extension run requires --slim-bin")
        extension_plan = _read_followup_plan(extension_plan_path)
        ledger = run_followup_phase(
            extension_plan,
            root,
            extension_work_root,
            slim_path=args.slim_bin,
            workers=args.workers,
            timeout_seconds=args.timeout_minutes * 60,
        )
        _atomic_frame(extension_ledger_path, ledger)
        return 0 if ledger["evaluable"].map(_coerce_boolean).all() else 1
    if args.phase == "extension-select":
        canonical = pd.read_csv(canonical_ledger_path, sep="\t")
        extension_plan = _read_followup_plan(extension_plan_path)
        extension_ledger = pd.read_csv(extension_ledger_path, sep="\t")
        combined_plan, combined_ledger, summary, selected = (
            combine_screen_and_extension(
                plan,
                canonical,
                extension_plan,
                extension_ledger,
            )
        )
        _atomic_frame(combined_plan_path, combined_plan)
        _atomic_frame(combined_ledger_path, combined_ledger)
        _atomic_frame(combined_summary_path, summary)
        _atomic_frame(selected_path, selected)
        _atomic_json(
            result_dir / "han_selection_end_endpoint_selection_audit.json",
            {
                "schema": FOLLOWUP_SCHEMA_VERSION,
                "status": "complete",
                "selection_rule": (
                    "maximize pool-band-and-panel hit rate; then minimize absolute "
                    "logit median segregating AF error; then shorter multiplier"
                ),
                "minimum_band_hit_rate": DEFAULT_MINIMUM_BAND_HIT_RATE,
                "selected_cells": int(len(selected)),
                "artifacts": {
                    path.name: sha256_file(path)
                    for path in (
                        combined_plan_path,
                        combined_ledger_path,
                        combined_summary_path,
                        selected_path,
                    )
                },
            },
        )
        return 0
    if args.phase == "confirmation-plan":
        selected = pd.read_csv(selected_path, sep="\t")
        extension_plan = _read_followup_plan(extension_plan_path)
        reserved = {
            "production": units["seed"].astype(int),
            "screen": plan["seed"].astype(int),
            "extension": extension_plan["seed"].astype(int),
        }
        confirmation_plan = build_confirmation_plan(
            selected,
            upstream_artifact_sha256=sha256_file(selected_path),
            reserved_seed_groups=reserved,
        )
        _atomic_frame(confirmation_plan_path, confirmation_plan)
        _atomic_json(
            result_dir / "han_selection_end_confirmation_seed_audit.json",
            audit_disjoint_seed_groups(
                {
                    **reserved,
                    "confirmation": confirmation_plan["seed"].astype(int),
                }
            ),
        )
        return 0
    if args.phase == "confirmation-run":
        if args.slim_bin is None:
            raise ValueError("confirmation run requires --slim-bin")
        confirmation_plan = _read_followup_plan(confirmation_plan_path)
        ledger = run_followup_phase(
            confirmation_plan,
            root,
            confirmation_work_root,
            slim_path=args.slim_bin,
            workers=args.workers,
            timeout_seconds=args.timeout_minutes * 60,
        )
        _atomic_frame(confirmation_ledger_path, ledger)
        return 0 if ledger["evaluable"].map(_coerce_boolean).all() else 1
    if args.phase == "confirmation-audit":
        confirmation_plan = _read_followup_plan(confirmation_plan_path)
        ledger = pd.read_csv(confirmation_ledger_path, sep="\t")
        summary = summarize_endpoint_validation_phase(confirmation_plan, ledger)
        summary_path = result_dir / "han_selection_end_confirmation_summary.tsv"
        _atomic_frame(summary_path, summary)
        passed = bool(summary["phase_gate_passed"].map(_coerce_boolean).all())
        _atomic_json(
            result_dir / "han_selection_end_confirmation_audit.json",
            {
                "schema": FOLLOWUP_SCHEMA_VERSION,
                "status": "passed" if passed else "failed",
                "minimum_band_hit_rate": DEFAULT_MINIMUM_BAND_HIT_RATE,
                "draws_per_cell": DEFAULT_CONFIRMATION_DRAWS_PER_ENDPOINT,
                "artifacts": {
                    path.name: sha256_file(path)
                    for path in (
                        confirmation_plan_path,
                        confirmation_ledger_path,
                        summary_path,
                    )
                },
            },
        )
        return 0 if passed else 1
    if args.phase == "sensitivity-plan":
        selected = pd.read_csv(selected_path, sep="\t")
        extension_plan = _read_followup_plan(extension_plan_path)
        confirmation_plan = _read_followup_plan(confirmation_plan_path)
        reserved = {
            "production": units["seed"].astype(int),
            "screen": plan["seed"].astype(int),
            "extension": extension_plan["seed"].astype(int),
            "confirmation": confirmation_plan["seed"].astype(int),
        }
        sensitivity_plan = build_sensitivity_plan(
            selected,
            upstream_artifact_sha256=sha256_file(selected_path),
            reserved_seed_groups=reserved,
        )
        _atomic_frame(sensitivity_plan_path, sensitivity_plan)
        _atomic_json(
            result_dir / "han_selection_end_sensitivity_10mb_seed_audit.json",
            audit_disjoint_seed_groups(
                {
                    **reserved,
                    "sensitivity_10mb": sensitivity_plan["seed"].astype(int),
                }
            ),
        )
        return 0
    if args.phase == "sensitivity-run":
        if args.slim_bin is None:
            raise ValueError("sensitivity run requires --slim-bin")
        sensitivity_plan = _read_followup_plan(sensitivity_plan_path)
        ledger = run_followup_phase(
            sensitivity_plan,
            root,
            sensitivity_work_root,
            slim_path=args.slim_bin,
            workers=args.workers,
            timeout_seconds=args.timeout_minutes * 60,
        )
        _atomic_frame(sensitivity_ledger_path, ledger)
        return 0 if ledger["evaluable"].map(_coerce_boolean).all() else 1
    if args.phase == "sensitivity-audit":
        sensitivity_plan = _read_followup_plan(sensitivity_plan_path)
        ledger = pd.read_csv(sensitivity_ledger_path, sep="\t")
        summary = summarize_endpoint_validation_phase(sensitivity_plan, ledger)
        summary_path = result_dir / "han_selection_end_sensitivity_10mb_summary.tsv"
        _atomic_frame(summary_path, summary)
        passed = bool(summary["phase_gate_passed"].map(_coerce_boolean).all())
        collisions = int(
            ledger["terminal_class"].astype(str).eq("identity_collision").sum()
        )
        _atomic_json(
            result_dir / "han_selection_end_sensitivity_10mb_audit.json",
            {
                "schema": FOLLOWUP_SCHEMA_VERSION,
                "status": "passed" if passed else "failed",
                "simulation_mode": PRODUCTION_10MB_SENSITIVITY_MODE,
                "normal_production_processing": True,
                "minimum_band_hit_rate": DEFAULT_MINIMUM_BAND_HIT_RATE,
                "draws_per_cell": DEFAULT_SENSITIVITY_DRAWS_PER_ENDPOINT,
                "identity_collision_failed_draws": collisions,
                "artifacts": {
                    path.name: sha256_file(path)
                    for path in (
                        sensitivity_plan_path,
                        sensitivity_ledger_path,
                        summary_path,
                    )
                },
            },
        )
        return 0 if passed else 1
    ledger = pd.read_csv(result_dir / "han_selection_end_terminal_draws.tsv", sep="\t")
    payload = finalize_calibration(
        plan,
        ledger,
        result_dir,
        production_seed_digest=_production_seed_digest(units),
    )
    return 0 if payload["status"] == "frozen" else 1


