@dataclass(frozen=True)
class HanFixedV2Design:
    selection_coefficients: tuple[float, ...] = SELECTION_COEFFICIENTS
    target_frequencies: tuple[float, ...] = TARGET_FREQUENCIES
    af_half_width: float = AF_HALF_WIDTH
    slim_scaling_factor: float = SLIM_SCALING_FACTOR
    candidate_pool_diploids: int = CANDIDATE_POOL_DIPLOIDS
    sample_diploids: int = SAMPLE_DIPLOIDS
    draw_timeout_seconds: float = DEFAULT_DRAW_TIMEOUT_SECONDS
    base_seed: int = BASE_SEED

    def validate(self) -> None:
        if tuple(self.selection_coefficients) != SELECTION_COEFFICIENTS:
            raise ValueError("fixed-v2 selection-coefficient grid is frozen")
        if tuple(self.target_frequencies) != TARGET_FREQUENCIES:
            raise ValueError("fixed-v2 target-frequency grid is frozen")
        if not math.isclose(self.af_half_width, AF_HALF_WIDTH, abs_tol=1e-12):
            raise ValueError("fixed-v2 AF half width is frozen at 0.025")
        if not math.isclose(
            self.slim_scaling_factor, SLIM_SCALING_FACTOR, abs_tol=1e-12
        ):
            raise ValueError("fixed-v2 Q is frozen at 5")
        if int(self.candidate_pool_diploids) != CANDIDATE_POOL_DIPLOIDS:
            raise ValueError("fixed-v2 candidate pool is frozen at 500 diploids")
        if int(self.sample_diploids) != SAMPLE_DIPLOIDS:
            raise ValueError("fixed-v2 exact panel is frozen at 100 diploids")
        if not math.isclose(
            self.draw_timeout_seconds, DEFAULT_DRAW_TIMEOUT_SECONDS, abs_tol=1e-12
        ):
            raise ValueError("fixed-v2 timeout is frozen at 1800 seconds")


def _atomic_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        temporary.write_text(
            json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _atomic_frame(path: Path, frame: pd.DataFrame) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        frame.to_csv(temporary, sep="\t", index=False, lineterminator="\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _immutable_json(path: Path, payload: Any) -> None:
    if path.is_file():
        try:
            current = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError(f"immutable JSON is unreadable: {path}") from error
        if current != payload:
            raise ValueError(f"immutable JSON differs; refusing overwrite: {path}")
        return
    _atomic_json(path, payload)


def _immutable_frame(path: Path, frame: pd.DataFrame) -> None:
    if path.is_file():
        current = pd.read_csv(path, sep="\t")
        _assert_frame_equivalent(frame, current)
        return
    _atomic_frame(path, frame)


def _blank_artifact_value(value: Any) -> bool:
    if value is None:
        return True
    if isinstance(value, str):
        return value == ""
    try:
        return bool(pd.isna(value))
    except (TypeError, ValueError):
        return False


def _artifact_values_equal(left: Any, right: Any) -> bool:
    if _blank_artifact_value(left) or _blank_artifact_value(right):
        return _blank_artifact_value(left) and _blank_artifact_value(right)
    if isinstance(left, (bool, np.bool_)) or isinstance(right, (bool, np.bool_)):
        try:
            return _coerce_boolean(left) == _coerce_boolean(right)
        except ValueError:
            return False
    try:
        left_number = float(left)
        right_number = float(right)
    except (TypeError, ValueError):
        return str(left) == str(right)
    return math.isclose(left_number, right_number, rel_tol=0.0, abs_tol=1e-12)


def _assert_frame_equivalent(left: pd.DataFrame, right: pd.DataFrame) -> None:
    lhs = left.reset_index(drop=True)
    rhs = right.reset_index(drop=True)
    if list(lhs.columns) != list(rhs.columns) or len(lhs) != len(rhs):
        raise AssertionError("fixed-v2 persisted table shape/columns differ")
    for column in lhs.columns:
        for index, (left_value, right_value) in enumerate(
            zip(lhs[column], rhs[column], strict=True)
        ):
            if not _artifact_values_equal(left_value, right_value):
                raise AssertionError(
                    "fixed-v2 persisted table differs at "
                    f"row={index}, column={column!r}"
                )


def _coerce_boolean(value: Any) -> bool:
    if isinstance(value, (bool, np.bool_)):
        return bool(value)
    if isinstance(value, str):
        normalized = value.strip().casefold()
        if normalized in {"true", "1"}:
            return True
        if normalized in {"false", "0"}:
            return False
    if isinstance(value, (int, np.integer)) and int(value) in {0, 1}:
        return bool(value)
    raise ValueError(f"value is not an explicit boolean: {value!r}")


def _require_sha256(value: str, *, label: str) -> str:
    digest = str(value).strip().casefold()
    if len(digest) != 64 or any(ch not in "0123456789abcdef" for ch in digest):
        raise ValueError(f"{label} is not a SHA-256 digest")
    return digest


def _seed_digest(values: Sequence[int]) -> str:
    seeds = sorted(int(value) for value in values)
    return hashlib.sha256(
        json.dumps(seeds, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def _require_repo_path(path: str | Path, repo_root: str | Path, *, label: str) -> Path:
    resolved = Path(path).resolve()
    root = Path(repo_root).resolve()
    try:
        resolved.relative_to(root)
    except ValueError as error:
        raise ValueError(f"fixed-v2 {label} must remain inside repo_root") from error
    if any("onedrive" in part.casefold() for part in resolved.parts):
        raise ValueError(f"fixed-v2 {label} must not be inside OneDrive")
    return resolved


def _implementation_sources(repo_root: Path) -> dict[str, str]:
    sources = {}
    for relative in IMPLEMENTATION_SOURCE_PATHS:
        path = _require_repo_path(repo_root / relative, repo_root, label="source")
        if not path.is_file():
            raise ValueError(f"fixed-v2 implementation source is absent: {path}")
        sources[relative] = sha256_file(path)
    return sources


def _slim_version(slim_path: Path) -> str:
    if not slim_path.is_file():
        raise ValueError(f"fixed-v2 SLiM executable is absent: {slim_path}")
    try:
        completed = subprocess.run(
            [str(slim_path), "-v"],
            check=True,
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
        raise ValueError("fixed-v2 SLiM version probe failed") from error
    version = " ".join((completed.stdout or completed.stderr).split())
    if "SLiM" not in version or EXPECTED_STDPOPSIM_SLIM_VERSION not in version:
        raise ValueError(
            "fixed-v2 requires stdpopsim-compatible SLiM "
            f"{EXPECTED_STDPOPSIM_SLIM_VERSION}"
        )
    return version


def _runtime_record(repo_root: Path, slim_path: str | Path) -> dict[str, Any]:
    slim = _require_repo_path(slim_path, repo_root, label="SLiM executable")
    return {
        "python": platform.python_version(),
        "stdpopsim": stdpopsim.__version__,
        "msprime": msprime.__version__,
        "pyslim": pyslim.__version__,
        "numpy": np.__version__,
        "pandas": pd.__version__,
        "tskit": tskit.__version__,
        "slim": {
            "path": slim.relative_to(repo_root.resolve()).as_posix(),
            "sha256": sha256_file(slim),
            "version": _slim_version(slim),
            "expected_version": EXPECTED_STDPOPSIM_SLIM_VERSION,
        },
    }


def _analytic_endpoint(selection_coefficient: float, target: float) -> float:
    initial = 0.0296 / (2.0 * 8.0)
    rate = DOMINANCE_COEFFICIENT * float(selection_coefficient)
    duration = (
        math.log(target / (1.0 - target)) - math.log(initial / (1.0 - initial))
    ) / rate
    return float(INTROGRESSION_PULSE_GENERATIONS - duration)


def endpoint_table() -> pd.DataFrame:
    rows = []
    for coefficient in SELECTION_COEFFICIENTS:
        for target in TARGET_FREQUENCIES:
            multiplier, realized = FIXED_ENDPOINTS[(coefficient, target)]
            analytic = _analytic_endpoint(coefficient, target)
            analytic_duration = INTROGRESSION_PULSE_GENERATIONS - analytic
            requested = INTROGRESSION_PULSE_GENERATIONS - multiplier * analytic_duration
            rows.append(
                {
                    "selection_coefficient": coefficient,
                    "target_allele_frequency": target,
                    "population_af_lower": target - AF_HALF_WIDTH,
                    "population_af_upper": target + AF_HALF_WIDTH,
                    "duration_multiplier": multiplier,
                    "requested_selection_end_generations_ago": requested,
                    "realized_selection_end_generations_ago": realized,
                    "slim_scaling_factor": SLIM_SCALING_FACTOR,
                }
            )
    return pd.DataFrame(rows)


def _bind_exploratory_screen(repo_root: Path) -> dict[str, Any]:
    artifacts = {}
    for relative, expected in EXPLORATORY_SCREEN_ARTIFACTS.items():
        path = _require_repo_path(
            repo_root / relative, repo_root, label="screen artifact"
        )
        if not path.is_file() or sha256_file(path) != expected:
            raise ValueError(
                f"fixed-v2 exploratory screen artifact differs: {relative}"
            )
        artifacts[relative] = {
            "sha256": expected,
            "bytes": path.stat().st_size,
        }
    ledger_path = repo_root / EXPLORATORY_SCREEN_LEDGER_RELATIVE_PATH
    ledger = pd.read_csv(ledger_path, sep="\t")
    if (
        len(ledger) != EXPLORATORY_SCREEN_ROWS
        or ledger["calibration_id"].duplicated().any()
        or "evaluable" not in ledger
        or not ledger["evaluable"].map(_coerce_boolean).all()
    ):
        raise ValueError("fixed-v2 exploratory screen is not reconciled 840/840")
    selected = pd.read_csv(repo_root / EXPLORATORY_SELECTED_RELATIVE_PATH, sep="\t")
    if (
        len(selected) != 6
        or selected.duplicated(
            ["selection_coefficient", "target_allele_frequency"]
        ).any()
    ):
        raise ValueError("fixed-v2 exploratory endpoint table is incomplete")
    expected = endpoint_table()
    joined = expected.merge(
        selected,
        on=["selection_coefficient", "target_allele_frequency"],
        suffixes=("_fixed", "_screen"),
        validate="one_to_one",
    )
    if len(joined) != 6:
        raise ValueError("fixed-v2 endpoints do not cover the exploratory grid")
    for field in (
        "duration_multiplier",
        "realized_selection_end_generations_ago",
    ):
        if not np.allclose(
            joined[f"{field}_fixed"],
            joined[f"{field}_screen"],
            rtol=0.0,
            atol=1e-12,
        ):
            raise ValueError(f"fixed-v2 endpoint differs from screen table: {field}")
    return {
        "status": "bound_exploratory_only",
        "canonical_rows": EXPLORATORY_SCREEN_ROWS,
        "canonical_evaluable_rows": EXPLORATORY_SCREEN_ROWS,
        "canonical_ledger_path": EXPLORATORY_SCREEN_LEDGER_RELATIVE_PATH,
        "canonical_ledger_sha256": EXPLORATORY_SCREEN_ARTIFACTS[
            EXPLORATORY_SCREEN_LEDGER_RELATIVE_PATH
        ],
        "endpoint_table_path": EXPLORATORY_SELECTED_RELATIVE_PATH,
        "endpoint_table_sha256": EXPLORATORY_SCREEN_ARTIFACTS[
            EXPLORATORY_SELECTED_RELATIVE_PATH
        ],
        "endpoint_rule_changed_after_screen": True,
        "screen_draws_used_for_inferential_validation": False,
        "fresh_confirmation_and_sensitivity_only": True,
        "artifacts": artifacts,
    }


def _bind_exploratory_seed_provenance(repo_root: Path) -> dict[str, Any]:
    """Validate the durable archive and its canonical 344-seed reservation."""

    inventory_path = _require_repo_path(
        repo_root / EXPLORATORY_SEED_INVENTORY_RELATIVE_PATH,
        repo_root,
        label="exploratory seed inventory",
    )
    if (
        not inventory_path.is_file()
        or sha256_file(inventory_path) != EXPLORATORY_SEED_INVENTORY_SHA256
    ):
        raise ValueError("fixed-v2 exploratory seed inventory is absent or differs")
    try:
        inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("fixed-v2 exploratory seed inventory is unreadable") from error
    if (
        inventory.get("schema") != EXPLORATORY_SEED_PROVENANCE_SCHEMA
        or inventory.get("status") != "canonical_immutable_seed_evidence"
        or inventory.get("inference_use") is not False
        or inventory.get("endpoint_rule_changed_after_exploratory_screen") is not True
    ):
        raise ValueError("fixed-v2 exploratory seed inventory contract differs")

    reservation_path = _require_repo_path(
        repo_root / EXPLORATORY_SEED_RESERVATION_RELATIVE_PATH,
        repo_root,
        label="exploratory seed reservation",
    )
    omitted_path = _require_repo_path(
        repo_root / EXPLORATORY_OMITTED_SEED_RELATIVE_PATH,
        repo_root,
        label="previously omitted exploratory seed reservation",
    )
    if (
        not reservation_path.is_file()
        or sha256_file(reservation_path) != EXPLORATORY_SEED_RESERVATION_SHA256
        or not omitted_path.is_file()
        or sha256_file(omitted_path) != EXPLORATORY_OMITTED_SEED_FILE_SHA256
    ):
        raise ValueError("fixed-v2 canonical exploratory seed reservation differs")
    reservation = pd.read_csv(reservation_path, sep="\t")
    omitted = pd.read_csv(omitted_path, sep="\t")
    required_columns = {
        "seed",
        "source_group",
        "source_role",
        "source_record",
        "original_status",
        "prearchive_v2_exclusion_status",
    }
    if (
        set(reservation.columns) != required_columns
        or set(omitted.columns) != required_columns
        or len(reservation) != EXPLORATORY_SEED_COUNT
        or reservation["seed"].duplicated().any()
        or sorted(reservation["seed"].astype(int))
        != reservation["seed"].astype(int).tolist()
        or _seed_digest(reservation["seed"]) != EXPLORATORY_SEED_SHA256
        or len(omitted) != EXPLORATORY_PREVIOUSLY_OMITTED_SEED_COUNT
        or omitted["seed"].duplicated().any()
        or _seed_digest(omitted["seed"]) != EXPLORATORY_PREVIOUSLY_OMITTED_SEED_SHA256
        or set(omitted["seed"].astype(int))
        != set(
            reservation.loc[
                reservation["prearchive_v2_exclusion_status"].astype(str).eq("omitted"),
                "seed",
            ].astype(int)
        )
        or set(reservation["prearchive_v2_exclusion_status"].astype(str))
        != {"already_reserved", "omitted"}
    ):
        raise ValueError("fixed-v2 canonical exploratory seed rows differ")

    canonical = inventory.get("canonical_reservation")
    previous = inventory.get("previously_omitted_reservation")
    if (
        not isinstance(canonical, Mapping)
        or canonical.get("path") != EXPLORATORY_SEED_RESERVATION_RELATIVE_PATH
        or canonical.get("sha256") != EXPLORATORY_SEED_RESERVATION_SHA256
        or int(canonical.get("unique_seed_count", -1)) != EXPLORATORY_SEED_COUNT
        or canonical.get("unique_seed_sha256") != EXPLORATORY_SEED_SHA256
        or not isinstance(previous, Mapping)
        or previous.get("path") != EXPLORATORY_OMITTED_SEED_RELATIVE_PATH
        or previous.get("sha256") != EXPLORATORY_OMITTED_SEED_FILE_SHA256
        or int(previous.get("unique_seed_count", -1))
        != EXPLORATORY_PREVIOUSLY_OMITTED_SEED_COUNT
        or previous.get("unique_seed_sha256")
        != EXPLORATORY_PREVIOUSLY_OMITTED_SEED_SHA256
    ):
        raise ValueError("fixed-v2 exploratory seed inventory summary differs")

    evidence = inventory.get("evidence")
    if not isinstance(evidence, list) or len(evidence) != len(
        EXPLORATORY_SEED_ARCHIVE_SHA256
    ):
        raise ValueError("fixed-v2 exploratory seed evidence inventory differs")
    indexed = {
        str(item.get("archive_path")): item
        for item in evidence
        if isinstance(item, Mapping)
    }
    if set(indexed) != set(EXPLORATORY_SEED_ARCHIVE_SHA256):
        raise ValueError("fixed-v2 exploratory seed evidence coverage differs")
    archive_records = {}
    for relative, expected_sha256 in EXPLORATORY_SEED_ARCHIVE_SHA256.items():
        path = _require_repo_path(
            repo_root / relative, repo_root, label="exploratory seed evidence"
        )
        item = indexed[relative]
        if (
            not path.is_file()
            or sha256_file(path) != expected_sha256
            or item.get("archive_sha256") != expected_sha256
            or item.get("original_sha256") != expected_sha256
            or not str(item.get("original_path", ""))
            or not str(item.get("original_status", ""))
            or int(item.get("archive_bytes", -1)) != path.stat().st_size
        ):
            raise ValueError(f"fixed-v2 exploratory seed evidence differs: {relative}")
        archive_records[relative] = {
            "sha256": expected_sha256,
            "bytes": path.stat().st_size,
            "original_path": str(item["original_path"]),
            "original_status": str(item["original_status"]),
        }

    archive_root = repo_root / EXPLORATORY_SEED_PROVENANCE_RELATIVE_DIR / "evidence"
    fixed = pd.read_csv(
        archive_root / "fixed_cessation_q5_not_frozen/terminal_draws_partial.tsv",
        sep="\t",
    )
    successful = pd.read_csv(
        archive_root / "calibration_pilots/successful_transfer_s001_af010_n8.tsv",
        sep="\t",
    )
    recipient = pd.read_csv(
        archive_root / "calibration_pilots/recipient_nonloss_s001_af010_n8.tsv",
        sep="\t",
    )
    refine_path = (
        archive_root / "calibration_pilots/recipient_nonloss_s001_af010_refine_n12.log"
    )
    observed_refine: dict[str, int] = {}
    for line in refine_path.read_text(encoding="utf-8").splitlines():
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, Mapping) and "label" in payload and "seed" in payload:
            label = str(payload["label"])
            seed = int(payload["seed"])
            if label in observed_refine and observed_refine[label] != seed:
                raise ValueError("fixed-v2 refine pilot label has conflicting seeds")
            observed_refine[label] = seed
    refine_seeds = set()
    expected_refine_labels = set()
    for multiplier in (0.2, 0.25):
        for draw_index in range(12):
            label = (
                "pilot__recipient_nonloss__s0.010__af0.10__"
                f"m{multiplier:.3f}__draw{draw_index:03d}"
            )
            expected_refine_labels.add(label)
            seed = _stable_seed(20260813, label)
            refine_seeds.add(seed)
            if label in observed_refine and observed_refine[label] != seed:
                raise ValueError("fixed-v2 refine pilot seed derivation differs")
    if (
        len(observed_refine) != 22
        or not set(observed_refine).issubset(expected_refine_labels)
        or len(expected_refine_labels.difference(observed_refine)) != 2
    ):
        raise ValueError("fixed-v2 refine pilot submitted/observed labels differ")

    fixed_seeds = set(fixed["seed"].astype(int))
    pilot_seeds = (
        set(successful["seed"].astype(int))
        | set(recipient["seed"].astype(int))
        | refine_seeds
    )
    obsolete_attempts = pd.read_csv(
        archive_root / "obsolete_selected_rep008/attempts.tsv", sep="\t"
    )
    obsolete_completion = json.loads(
        (archive_root / "obsolete_selected_rep008/simulation_complete.json").read_text(
            encoding="utf-8"
        )
    )
    obsolete_seeds = set(obsolete_attempts["seed"].astype(int)) | {
        int(obsolete_completion["provenance"]["sample_panel"]["panel_seed"])
    }
    neutral_smoke = pd.read_csv(
        archive_root / "neutral_smoke_intro/attempts.tsv", sep="\t"
    )
    smoke_seeds = set()
    for column in ("ancestry_seed", "candidate_seed", "mutation_seed"):
        smoke_seeds.update(neutral_smoke[column].astype(int))
    reconstructed_groups = {
        "fixed_partial": fixed_seeds,
        "pilots_union": pilot_seeds,
        "obsolete_selected_including_panel": obsolete_seeds,
        "neutral_smoke": smoke_seeds,
    }
    expected_groups = {
        "fixed_partial": (
            160,
            "b6f0a959128bee34b17ef5650378ecc7f3ce21769d65c8831708e8255aa307ca",
        ),
        "pilots_union": (
            88,
            "9dcc9b7022247cf8154ac3ead5aa53a44211f0e9e7c25c3b012e1cc5305ae43f",
        ),
        "obsolete_selected_including_panel": (
            93,
            "4db393fdd7f794bc1facc4ad6f82f0968fa1b142c5641d668069cd399aabd8c7",
        ),
        "neutral_smoke": (
            3,
            "8af5f7983079f25a76c39edd123d40d258734a2da45e186345a079c2414629d1",
        ),
    }
    if any(
        len(reconstructed_groups[name]) != expected[0]
        or _seed_digest(reconstructed_groups[name]) != expected[1]
        for name, expected in expected_groups.items()
    ):
        raise ValueError("fixed-v2 archived exploratory seed category differs")
    reconstructed_union = set().union(*reconstructed_groups.values())
    if (
        reconstructed_union != set(reservation["seed"].astype(int))
        or len(reconstructed_union) != EXPLORATORY_SEED_COUNT
        or _seed_digest(reconstructed_union) != EXPLORATORY_SEED_SHA256
    ):
        raise ValueError("fixed-v2 archived evidence and seed reservation differ")
    return {
        "schema": EXPLORATORY_SEED_PROVENANCE_SCHEMA,
        "status": "bound_noninferential_seed_evidence",
        "inventory_path": EXPLORATORY_SEED_INVENTORY_RELATIVE_PATH,
        "inventory_sha256": EXPLORATORY_SEED_INVENTORY_SHA256,
        "canonical_reservation_path": EXPLORATORY_SEED_RESERVATION_RELATIVE_PATH,
        "canonical_reservation_sha256": EXPLORATORY_SEED_RESERVATION_SHA256,
        "canonical_seed_count": EXPLORATORY_SEED_COUNT,
        "canonical_seed_sha256": EXPLORATORY_SEED_SHA256,
        "previously_omitted_path": EXPLORATORY_OMITTED_SEED_RELATIVE_PATH,
        "previously_omitted_file_sha256": EXPLORATORY_OMITTED_SEED_FILE_SHA256,
        "previously_omitted_seed_count": (EXPLORATORY_PREVIOUSLY_OMITTED_SEED_COUNT),
        "previously_omitted_seed_sha256": (EXPLORATORY_PREVIOUSLY_OMITTED_SEED_SHA256),
        "inference_use": False,
        "archive": archive_records,
    }


def _expand_execution_unit_seeds(frame: pd.DataFrame) -> set[int]:
    expanded = {int(value) for value in frame["seed"]}
    for row in frame.to_dict(orient="records"):
        base = int(row["seed"])
        simulation_class = str(row["simulation_class"])
        if simulation_class == "selected":
            for attempt in range(DEFAULT_SELECTED_MAX_DRAWS):
                expanded.add(_stable_seed(base, f"selected:{attempt}"))
                expanded.add(_stable_seed(base, f"selected-panel:{attempt}"))
        elif simulation_class == "neutral":
            for attempt in range(DEFAULT_NEUTRAL_MAX_ATTEMPTS):
                for component in ("ancestry", "mutations", "panel"):
                    expanded.add(_stable_seed(base, f"neutral:{attempt}:{component}"))
            batches = math.ceil(
                DEFAULT_NEUTRAL_MAX_ATTEMPTS / DEFAULT_NEUTRAL_ANCESTRY_BATCH_SIZE
            )
            for batch in range(batches):
                expanded.add(_stable_seed(base, f"neutral-batch:{batch}:candidate"))
        else:
            raise ValueError("execution-unit seed artifact has an unknown class")
    return expanded


def _excluded_seed_evidence(
    paths: Sequence[str | Path], repo_root: Path
) -> tuple[set[int], list[dict[str, Any]]]:
    if not paths:
        raise ValueError("fixed-v2 excluded seed artifacts are required")
    excluded: set[int] = set()
    records = []
    observed_paths = set()
    for raw in paths:
        path = _require_repo_path(raw, repo_root, label="excluded seed artifact")
        relative = path.relative_to(repo_root).as_posix()
        if relative in observed_paths or not path.is_file():
            raise ValueError(f"fixed-v2 excluded seed artifact is invalid: {relative}")
        observed_paths.add(relative)
        frame = pd.read_csv(path, sep="\t")
        if frame.empty or "seed" not in frame:
            raise ValueError(f"fixed-v2 seed artifact lacks seed rows: {relative}")
        direct = {int(value) for value in frame["seed"]}
        if "panel_seed" in frame:
            direct.update(int(value) for value in frame["panel_seed"])
        expansion = "explicit_seed_and_panel_seed_columns"
        expanded = set(direct)
        if path.name == "execution_units.tsv" and {
            "simulation_class",
            "seed",
        }.issubset(frame.columns):
            expanded = _expand_execution_unit_seeds(frame)
            expansion = "focused_campaign_bounded_rng_namespace_v1"
        elif "calibration_phase" in frame.columns or path.name.startswith(
            "han_selection_end_"
        ):
            # The legacy fixed-cessation sensitivity executor derives this
            # panel seed from each simulation seed. Reserve it for every fixed
            # plan row so the expansion is conservative and deterministic.
            expanded.update(
                _stable_seed(seed, "sensitivity-exact-panel") for seed in direct
            )
            expansion += "+legacy_fixed_sensitivity_panel_derivation"
        excluded.update(expanded)
        records.append(
            {
                "path": relative,
                "sha256": sha256_file(path),
                "rows": len(frame),
                "direct_seed_columns": [
                    column for column in ("seed", "panel_seed") if column in frame
                ],
                "direct_unique_count": len(direct),
                "direct_seed_sha256": _seed_digest(direct),
                "rng_expansion_mode": expansion,
                "reserved_rng_seed_count": len(expanded),
                "reserved_rng_seed_sha256": _seed_digest(expanded),
            }
        )
    return excluded, sorted(records, key=lambda item: item["path"])


def _allocate_seed(
    base_seed: int, identity: str, occupied: set[int]
) -> tuple[int, int]:
    for nonce in range(10_000):
        label = identity if nonce == 0 else f"{identity}:nonce={nonce}"
        value = _stable_seed(int(base_seed), label)
        if value not in occupied:
            occupied.add(value)
            return value, nonce
    raise RuntimeError("could not allocate a disjoint fixed-v2 RNG seed")


_ROW_STRING_COLUMNS = {
    "draw_id",
    "phase",
    "processing_mode",
    "exploratory_screen_ledger_sha256",
}
_ROW_INTEGER_COLUMNS = {
    "exact_sample_alt_count",
    "sample_diploids",
    "candidate_pool_diploids",
    "draw_index",
    "seed",
    "seed_nonce",
    "panel_seed",
    "panel_seed_nonce",
    "sequence_length_bp",
    "focal_position_bp",
}


def _normalized_row(row: Mapping[str, Any]) -> dict[str, Any]:
    if set(ROW_COLUMNS).difference(row):
        raise ValueError("fixed-v2 row lacks manifest fields")
    result = {}
    for column in ROW_COLUMNS:
        value = row[column]
        if column in _ROW_STRING_COLUMNS:
            result[column] = str(value)
        elif column in _ROW_INTEGER_COLUMNS:
            result[column] = int(value)
        else:
            result[column] = float(value)
    return result


def _retry_quarantine_parent(repo_root: Path) -> Path:
    return _require_repo_path(
        repo_root / DEFAULT_RETRY_QUARANTINE_RELATIVE_PATH,
        repo_root,
        label="retry quarantine parent",
    )


def _require_retry_quarantine_path(
    path: str | Path, repo_root: Path, *, label: str
) -> Path:
    quarantine = _require_repo_path(path, repo_root, label=label)
    parent = _retry_quarantine_parent(repo_root)
    try:
        relative = quarantine.relative_to(parent)
    except ValueError as error:
        raise ValueError(
            "fixed-v2 retry quarantine must remain in the calibration quarantine"
        ) from error
    if not relative.parts:
        raise ValueError("fixed-v2 retry quarantine requires a timestamped child")
    return quarantine


def write_retry_quarantine_inventory(
    quarantine_root: str | Path, *, repo_root: str | Path
) -> dict[str, Any]:
    """Inventory an already-moved, noninferential failed validation attempt."""

    root = Path(repo_root).resolve()
    quarantine = _require_retry_quarantine_path(
        quarantine_root, root, label="retry quarantine"
    )
    planning = quarantine / "planning_bundle"
    work = quarantine / "work_bundle"
    manifest_path = planning / "han_fixed_v2_manifest.json"
    plan_path = planning / "han_fixed_v2_all_phase_plan.tsv"
    if not planning.is_dir() or not work.is_dir():
        raise ValueError("fixed-v2 retry quarantine lacks planning/work bundles")
    try:
        superseded = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("fixed-v2 superseded manifest is unreadable") from error
    if (
        superseded.get("schema") != SUPERSEDED_MANIFEST_SCHEMA
        or superseded.get("status") != "planned"
    ):
        raise ValueError("fixed-v2 superseded manifest contract differs")
    superseded_frame = _validate_manifest_rows(superseded)
    if not plan_path.is_file():
        raise ValueError("fixed-v2 superseded all-phase plan is absent")
    projected = pd.read_csv(plan_path, sep="\t").loc[:, list(ROW_COLUMNS)]
    _assert_frame_equivalent(superseded_frame, projected)
    reservation = superseded.get("all_phase_seed_reservation")
    if not isinstance(reservation, Mapping) or sha256_file(
        plan_path
    ) != reservation.get("sha256"):
        raise ValueError("fixed-v2 superseded seed reservation differs")
    snapshots = superseded.get("source_snapshots")
    sources = superseded.get("implementation_sources")
    if not isinstance(snapshots, Mapping) or not isinstance(sources, Mapping):
        raise TypeError("fixed-v2 superseded source binding is absent")
    if superseded.get("source_snapshots_sha256") != _canonical_sha256(snapshots):
        raise ValueError("fixed-v2 superseded source snapshot digest differs")
    for relative, expected in sources.items():
        record = snapshots.get(relative)
        if not isinstance(record, Mapping):
            raise TypeError("fixed-v2 superseded source snapshot is absent")
        snapshot = planning / "source_snapshots" / str(record.get("path", ""))
        if not snapshot.is_file() or sha256_file(snapshot) != str(expected):
            raise ValueError("fixed-v2 superseded source snapshot differs")
    current_sources = _implementation_sources(root)
    if set(current_sources) != set(sources):
        raise ValueError("fixed-v2 retry implementation source set differs")
    changed_sources = sorted(
        relative
        for relative in current_sources
        if current_sources[relative] != sources[relative]
    )
    if changed_sources != [FIXED_V2_IMPLEMENTATION_RELATIVE_PATH]:
        raise ValueError(
            "fixed-v2 retry must change only its isolated implementation source"
        )

    confirmation = work / PHASE_CONFIRMATION
    if not confirmation.is_dir():
        raise ValueError("fixed-v2 retry quarantine lacks confirmation evidence")
    plan_index = superseded_frame.set_index("draw_id")
    expected_confirmation = set(
        superseded_frame.loc[
            superseded_frame["phase"].astype(str).eq(PHASE_CONFIRMATION), "draw_id"
        ].astype(str)
    )
    directories = sorted(path for path in confirmation.iterdir() if path.is_dir())
    observed_ids = {path.name for path in directories}
    if not observed_ids or not observed_ids.issubset(expected_confirmation):
        raise ValueError("fixed-v2 retry work directories differ from the plan")
    manifest_sha256 = sha256_file(manifest_path)
    counts = {
        "started_directories": len(directories),
        "valid_completions": 0,
        "validated_hits": 0,
        "validated_nonhits": 0,
        "nonhits_with_null_unused_panel_seed": 0,
        "hits_with_reserved_panel_seed": 0,
        "failure_records": 0,
        "sigterm_failure_records": 0,
        "partial_directories": 0,
    }
    expectation_cache: dict[tuple[Any, ...], dict[str, Any]] = {}
    for directory in directories:
        raw_row = plan_index.loc[directory.name].to_dict()
        raw_row["draw_id"] = directory.name
        row = _normalized_row(raw_row)
        completion = directory / "completion.json"
        failure = directory / "last_failure.json"
        present = [path for path in (completion, failure) if path.is_file()]
        if not present:
            counts["partial_directories"] += 1
            continue
        if len(present) != 1:
            raise ValueError("fixed-v2 retry draw has two terminal records")
        try:
            payload = json.loads(present[0].read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError("fixed-v2 retry terminal record is unreadable") from error
        contract = payload.get("contract")
        if (
            payload.get("schema") != SUPERSEDED_DRAW_SCHEMA
            or not isinstance(contract, Mapping)
            or contract.get("schema") != SUPERSEDED_DRAW_SCHEMA
            or contract.get("manifest_sha256") != manifest_sha256
            or contract.get("manifest_row") != row
            or contract.get("implementation_sources") != sources
            or contract.get("runtime") != superseded.get("runtime")
            or payload.get("contract_sha256") != _canonical_sha256(contract)
        ):
            raise ValueError("fixed-v2 retry terminal contract differs")
        result = payload.get("result")
        if not isinstance(result, Mapping):
            raise TypeError("fixed-v2 retry terminal result is absent")
        _validate_result_row(result, row)
        evaluable = _coerce_boolean(result.get("evaluable"))
        hit = _coerce_boolean(result.get("hit"))
        if present[0] == completion:
            if not evaluable:
                raise ValueError("fixed-v2 retry completion is not evaluable")
            _validate_evaluable_result(
                result,
                row,
                directory,
                repo_root=root,
                expectation_cache=expectation_cache,
            )
            counts["valid_completions"] += 1
            if hit:
                if int(result.get("panel_seed", -1)) != int(row["panel_seed"]):
                    raise ValueError("fixed-v2 retry hit lost its reserved panel seed")
                counts["validated_hits"] += 1
                counts["hits_with_reserved_panel_seed"] += 1
            else:
                if not _blank_artifact_value(result.get("panel_seed")):
                    raise ValueError(
                        "fixed-v2 retry nonhit unexpectedly invoked the panel sampler"
                    )
                counts["validated_nonhits"] += 1
                counts["nonhits_with_null_unused_panel_seed"] += 1
        else:
            if evaluable or str(result.get("status")) not in {"failed", "timed_out"}:
                raise ValueError("fixed-v2 retry failure semantics differ")
            counts["failure_records"] += 1
            if "exited with code -15" in str(result.get("error", "")):
                counts["sigterm_failure_records"] += 1
    if (
        counts["valid_completions"]
        + counts["failure_records"]
        + counts["partial_directories"]
        != counts["started_directories"]
    ):
        raise AssertionError("fixed-v2 retry work inventory is incomplete")

    payload_records = []
    for payload_root in (planning, work):
        for path in sorted(item for item in payload_root.rglob("*") if item.is_file()):
            if path.is_symlink():
                raise ValueError("fixed-v2 retry payload must not contain symlinks")
            payload_records.append(
                {
                    "path": path.relative_to(root).as_posix(),
                    "bytes": path.stat().st_size,
                    "sha256": sha256_file(path),
                }
            )
    if not payload_records:
        raise ValueError("fixed-v2 retry quarantine payload is empty")
    checksum_path = quarantine / "payload_checksums.tsv"
    checksum_frame = pd.DataFrame(payload_records, columns=["path", "bytes", "sha256"])
    _immutable_frame(checksum_path, checksum_frame)
    seed_union = pd.concat(
        [superseded_frame["seed"], superseded_frame["panel_seed"]],
        ignore_index=True,
    )
    reason = {
        "schema": RETRY_QUARANTINE_REASON_SCHEMA,
        "status": "quarantined_noninferential",
        "inference_use": False,
        "reason_code": "null_unused_panel_seed_validator_contract_mismatch",
        "diagnosis": (
            "The generator correctly recorded result.panel_seed as null when the "
            "exact-panel sampler was not invoked, but the authoritative row "
            "validator attempted int(null) before checking nonhit panel evidence."
        ),
        "resolution": (
            "The validator now accepts a blank result panel seed only for a nonhit "
            "with no panel sampler record, roundtrip, counts, paths, or hashes; hit "
            "records still require the exact manifest-reserved seed and artifacts."
        ),
        "endpoint_or_simulation_design_changed": False,
        "old_results_used_to_change_endpoints": False,
        "retry_reuses_identical_planned_simulation_and_panel_seeds": True,
        "superseded_manifest_sha256": manifest_sha256,
        "superseded_all_phase_plan_sha256": sha256_file(plan_path),
        "superseded_implementation_source_sha256": sources[
            FIXED_V2_IMPLEMENTATION_RELATIVE_PATH
        ],
        "replacement_implementation_source_sha256": current_sources[
            FIXED_V2_IMPLEMENTATION_RELATIVE_PATH
        ],
        "work_evidence": counts,
    }
    reason_path = quarantine / "quarantine_reason.json"
    _immutable_json(reason_path, reason)
    inventory = {
        "schema": RETRY_QUARANTINE_INVENTORY_SCHEMA,
        "status": "canonical_noninferential_retry_provenance",
        "inference_use": False,
        "quarantine_id": quarantine.name,
        "quarantine_path": quarantine.relative_to(root).as_posix(),
        "reason": {
            "path": reason_path.relative_to(root).as_posix(),
            "sha256": sha256_file(reason_path),
            "reason_code": reason["reason_code"],
        },
        "payload_checksums": {
            "path": checksum_path.relative_to(root).as_posix(),
            "sha256": sha256_file(checksum_path),
            "rows": len(checksum_frame),
            "total_bytes": int(checksum_frame["bytes"].sum()),
            "payload_tree_sha256": _canonical_sha256(payload_records),
        },
        "superseded": {
            "manifest_path": manifest_path.relative_to(root).as_posix(),
            "manifest_sha256": manifest_sha256,
            "manifest_schema": superseded["schema"],
            "all_phase_plan_path": plan_path.relative_to(root).as_posix(),
            "all_phase_plan_sha256": sha256_file(plan_path),
            "rows": len(superseded_frame),
            "simulation_seed_sha256": _seed_digest(superseded_frame["seed"]),
            "panel_seed_sha256": _seed_digest(superseded_frame["panel_seed"]),
            "rng_union_sha256": _seed_digest(seed_union),
        },
        "replacement": {
            "manifest_schema": MANIFEST_SCHEMA,
            "draw_schema": DRAW_SCHEMA,
            "implementation_source_path": FIXED_V2_IMPLEMENTATION_RELATIVE_PATH,
            "implementation_source_sha256": current_sources[
                FIXED_V2_IMPLEMENTATION_RELATIVE_PATH
            ],
            "changed_implementation_sources": changed_sources,
            "same_seed_plan_required": True,
        },
        "work_evidence": counts,
    }
    inventory_path = quarantine / "quarantine_inventory.json"
    _immutable_json(inventory_path, inventory)
    return {
        "inventory": inventory_path.relative_to(root).as_posix(),
        "inventory_sha256": sha256_file(inventory_path),
        "payload_files": len(payload_records),
        "work_evidence": counts,
    }


def _bind_retry_provenance(
    inventory_paths: Sequence[str | Path], repo_root: Path
) -> list[dict[str, Any]]:
    if not inventory_paths:
        return []
    records = []
    current_source_sha256 = _implementation_sources(repo_root)[
        FIXED_V2_IMPLEMENTATION_RELATIVE_PATH
    ]
    for raw_path in sorted({Path(path).resolve() for path in inventory_paths}):
        inventory_path = _require_retry_quarantine_path(
            raw_path, repo_root, label="retry inventory"
        )
        if inventory_path.name != "quarantine_inventory.json":
            raise ValueError("fixed-v2 retry binding requires quarantine inventory")
        try:
            inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError("fixed-v2 retry inventory is unreadable") from error
        if (
            inventory.get("schema") != RETRY_QUARANTINE_INVENTORY_SCHEMA
            or inventory.get("status") != "canonical_noninferential_retry_provenance"
            or inventory.get("inference_use") is not False
            or inventory.get("quarantine_id") != inventory_path.parent.name
            or inventory.get("quarantine_path")
            != inventory_path.parent.relative_to(repo_root).as_posix()
        ):
            raise ValueError("fixed-v2 retry inventory contract differs")
        checksum_record = inventory.get("payload_checksums")
        reason_record = inventory.get("reason")
        replacement = inventory.get("replacement")
        if not all(
            isinstance(record, Mapping)
            for record in (checksum_record, reason_record, replacement)
        ):
            raise TypeError("fixed-v2 retry inventory binding is incomplete")
        checksum_path = _require_repo_path(
            repo_root / str(checksum_record.get("path", "")),
            repo_root,
            label="retry payload checksums",
        )
        if not checksum_path.is_file() or sha256_file(
            checksum_path
        ) != checksum_record.get("sha256"):
            raise ValueError("fixed-v2 retry payload checksum table differs")
        checksums = pd.read_csv(checksum_path, sep="\t")
        if list(checksums.columns) != ["path", "bytes", "sha256"] or int(
            checksum_record.get("rows", -1)
        ) != len(checksums):
            raise ValueError("fixed-v2 retry payload checksum schema differs")
        payload_records = []
        for row in checksums.to_dict(orient="records"):
            payload = _require_repo_path(
                repo_root / str(row["path"]), repo_root, label="retry payload"
            )
            record = {
                "path": payload.relative_to(repo_root).as_posix(),
                "bytes": int(row["bytes"]),
                "sha256": str(row["sha256"]),
            }
            if (
                not payload.is_file()
                or payload.stat().st_size != record["bytes"]
                or sha256_file(payload) != record["sha256"]
            ):
                raise ValueError("fixed-v2 retry payload differs")
            payload_records.append(record)
        if int(checksum_record.get("total_bytes", -1)) != sum(
            record["bytes"] for record in payload_records
        ) or checksum_record.get("payload_tree_sha256") != _canonical_sha256(
            payload_records
        ):
            raise ValueError("fixed-v2 retry payload inventory digest differs")
        reason_path = _require_repo_path(
            repo_root / str(reason_record.get("path", "")),
            repo_root,
            label="retry reason",
        )
        try:
            reason = json.loads(reason_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError("fixed-v2 retry reason is unreadable") from error
        if (
            sha256_file(reason_path) != reason_record.get("sha256")
            or reason.get("schema") != RETRY_QUARANTINE_REASON_SCHEMA
            or reason.get("status") != "quarantined_noninferential"
            or reason.get("inference_use") is not False
            or reason.get("reason_code") != reason_record.get("reason_code")
            or reason.get("retry_reuses_identical_planned_simulation_and_panel_seeds")
            is not True
            or reason.get("endpoint_or_simulation_design_changed") is not False
            or reason.get("old_results_used_to_change_endpoints") is not False
        ):
            raise ValueError("fixed-v2 retry reason contract differs")
        if (
            replacement.get("manifest_schema") != MANIFEST_SCHEMA
            or replacement.get("draw_schema") != DRAW_SCHEMA
            or replacement.get("implementation_source_path")
            != FIXED_V2_IMPLEMENTATION_RELATIVE_PATH
            or replacement.get("implementation_source_sha256") != current_source_sha256
            or replacement.get("same_seed_plan_required") is not True
        ):
            raise ValueError("fixed-v2 retry replacement binding differs")
        records.append(
            {
                "schema": RETRY_QUARANTINE_INVENTORY_SCHEMA,
                "status": "bound_noninferential_retry_provenance",
                "inference_use": False,
                "inventory_path": inventory_path.relative_to(repo_root).as_posix(),
                "inventory_sha256": sha256_file(inventory_path),
                "quarantine_id": inventory["quarantine_id"],
                "reason_code": reason["reason_code"],
                "superseded": inventory["superseded"],
                "replacement": replacement,
                "work_evidence": inventory["work_evidence"],
            }
        )
    return records


def build_atomic_manifest(
    design: HanFixedV2Design,
    *,
    repo_root: str | Path,
    slim_path: str | Path,
    excluded_seed_artifacts: Sequence[str | Path],
    retry_provenance_artifacts: Sequence[str | Path] = (),
) -> dict[str, Any]:
    """Reserve all 600 confirmation and 120 sensitivity RNG pairs at once."""

    design.validate()
    root = Path(repo_root).resolve()
    screen = _bind_exploratory_screen(root)
    seed_provenance = _bind_exploratory_seed_provenance(root)
    retry_provenance = _bind_retry_provenance(retry_provenance_artifacts, root)
    excluded, excluded_evidence = _excluded_seed_evidence(excluded_seed_artifacts, root)
    exploratory_exclusions = [
        item
        for item in excluded_evidence
        if str(item["path"]) == EXPLORATORY_SEED_RESERVATION_RELATIVE_PATH
    ]
    if (
        len(exploratory_exclusions) != 1
        or int(exploratory_exclusions[0]["direct_unique_count"])
        != EXPLORATORY_SEED_COUNT
        or exploratory_exclusions[0]["direct_seed_sha256"] != EXPLORATORY_SEED_SHA256
        or int(exploratory_exclusions[0]["reserved_rng_seed_count"])
        != EXPLORATORY_SEED_COUNT
        or exploratory_exclusions[0]["reserved_rng_seed_sha256"]
        != EXPLORATORY_SEED_SHA256
    ):
        raise ValueError(
            "fixed-v2 canonical exploratory seed reservation is not exactly excluded"
        )
    occupied = set(excluded)
    rows = []
    phase_seeds: dict[str, dict[str, list[int]]] = {
        phase: {"simulation": [], "panel": []} for phase in PHASE_DRAW_COUNTS
    }
    endpoints = endpoint_table().set_index(
        ["selection_coefficient", "target_allele_frequency"]
    )
    for phase, draws in PHASE_DRAW_COUNTS.items():
        focal_only = phase == PHASE_CONFIRMATION
        length = FOCAL_ONLY_LENGTH_BP if focal_only else PRODUCTION_LENGTH_BP
        position = FOCAL_ONLY_POSITION_BP if focal_only else PRODUCTION_POSITION_BP
        mode = FOCAL_ONLY_MODE if focal_only else PRODUCTION_MODE
        for coefficient in design.selection_coefficients:
            for target in design.target_frequencies:
                endpoint = endpoints.loc[(coefficient, target)]
                for draw_index in range(draws):
                    identity = (
                        f"han_fixed_v2__{phase}__s{coefficient:.6f}__"
                        f"af{target:.6f}__q{design.slim_scaling_factor:g}__"
                        f"draw{draw_index:03d}"
                    )
                    seed, seed_nonce = _allocate_seed(
                        design.base_seed, identity, occupied
                    )
                    panel_seed, panel_nonce = _allocate_seed(
                        design.base_seed,
                        f"{identity}:uniform-exact-k-panel",
                        occupied,
                    )
                    phase_seeds[phase]["simulation"].append(seed)
                    phase_seeds[phase]["panel"].append(panel_seed)
                    rows.append(
                        {
                            "draw_id": identity,
                            "phase": phase,
                            "selection_coefficient": coefficient,
                            "target_allele_frequency": target,
                            "population_af_lower": target - design.af_half_width,
                            "population_af_upper": target + design.af_half_width,
                            "duration_multiplier": float(
                                endpoint["duration_multiplier"]
                            ),
                            "requested_selection_end_generations_ago": float(
                                endpoint["requested_selection_end_generations_ago"]
                            ),
                            "realized_selection_end_generations_ago": float(
                                endpoint["realized_selection_end_generations_ago"]
                            ),
                            "exact_sample_alt_count": round(
                                2 * design.sample_diploids * target
                            ),
                            "sample_diploids": design.sample_diploids,
                            "candidate_pool_diploids": (design.candidate_pool_diploids),
                            "slim_scaling_factor": design.slim_scaling_factor,
                            "mutation_age_generations": (
                                INTROGRESSION_MUTATION_AGE_GENERATIONS
                            ),
                            "selection_start_generations_ago": (
                                INTROGRESSION_PULSE_GENERATIONS
                            ),
                            "draw_index": draw_index,
                            "seed": seed,
                            "seed_nonce": seed_nonce,
                            "panel_seed": panel_seed,
                            "panel_seed_nonce": panel_nonce,
                            "timeout_seconds": design.draw_timeout_seconds,
                            "sequence_length_bp": length,
                            "focal_position_bp": position,
                            "processing_mode": mode,
                            "exploratory_screen_ledger_sha256": screen[
                                "canonical_ledger_sha256"
                            ],
                        }
                    )
    frame = pd.DataFrame(rows, columns=ROW_COLUMNS)
    if len(frame) != 720:
        raise RuntimeError("fixed-v2 manifest must contain exactly 720 draws")
    all_rng = pd.concat([frame["seed"], frame["panel_seed"]], ignore_index=True)
    if (
        frame["draw_id"].duplicated().any()
        or all_rng.duplicated().any()
        or set(all_rng.astype(int)).intersection(excluded)
    ):
        raise RuntimeError("fixed-v2 identities/RNG reservations are not disjoint")
    registry = {
        "schema": SEED_REGISTRY_SCHEMA,
        "excluded_union_count": len(excluded),
        "excluded_union_sha256": _seed_digest(excluded),
        "exploratory_provenance_seed_count": EXPLORATORY_SEED_COUNT,
        "exploratory_provenance_seed_sha256": EXPLORATORY_SEED_SHA256,
        "exploratory_previously_omitted_seed_count": (
            EXPLORATORY_PREVIOUSLY_OMITTED_SEED_COUNT
        ),
        "exploratory_previously_omitted_seed_sha256": (
            EXPLORATORY_PREVIOUSLY_OMITTED_SEED_SHA256
        ),
        "fixed_v2_union_count": len(all_rng),
        "fixed_v2_union_sha256": _seed_digest(all_rng),
        "simulation_seed_count": len(frame),
        "simulation_seed_sha256": _seed_digest(frame["seed"]),
        "panel_seed_count": len(frame),
        "panel_seed_sha256": _seed_digest(frame["panel_seed"]),
        "phase_seeds": {
            phase: {
                component: {
                    "count": len(values),
                    "seed_sha256": _seed_digest(values),
                }
                for component, values in components.items()
            }
            for phase, components in phase_seeds.items()
        },
        "pairwise_disjoint": True,
    }
    execution_evidence = [
        item
        for item in excluded_evidence
        if item["path"].endswith("execution_units.tsv")
    ]
    if len(execution_evidence) != 1:
        raise ValueError("fixed-v2 planning requires exactly one production unit table")
    execution_path = root / execution_evidence[0]["path"]
    production_units = pd.read_csv(execution_path, sep="\t")
    production_seed_digest = _seed_digest(production_units["seed"])
    return {
        "schema": MANIFEST_SCHEMA,
        "status": "planned",
        "model": {
            "mode": MODEL_MODE,
            "archaic_specific_no_ils_by_construction": True,
            "mutation_population": "Neanderthal",
            "mutation_age_generations": INTROGRESSION_MUTATION_AGE_GENERATIONS,
            "selection_start_generations_ago": INTROGRESSION_PULSE_GENERATIONS,
            "selection_endpoints": endpoint_table().to_dict(orient="records"),
            "post_pulse_recipient_nonloss_conditioning": True,
            "terminal_han_frequency_conditioning_in_slim": False,
            "external_candidate_pool_frequency_gate": True,
            "uniform_exact_k_panel": True,
            "gamma_smc_statistics_used": False,
        },
        "design": {
            "selection_coefficients": list(design.selection_coefficients),
            "target_allele_frequencies": list(design.target_frequencies),
            "af_half_width": design.af_half_width,
            "slim_scaling_factor": design.slim_scaling_factor,
            "candidate_pool_diploids": design.candidate_pool_diploids,
            "sample_diploids": design.sample_diploids,
            "draw_timeout_seconds": design.draw_timeout_seconds,
            "phase_draws_per_cell": dict(PHASE_DRAW_COUNTS),
            "phase_required_hits_per_cell": dict(PHASE_REQUIRED_HITS),
        },
        "exploratory_screen": screen,
        "exploratory_seed_provenance": seed_provenance,
        "retry_provenance": retry_provenance,
        "inference_contract": {
            "endpoint_rule_prespecified_before_exploratory_screen": False,
            "endpoint_rule_changed_after_exploratory_screen": True,
            "exploratory_screen_is_descriptive_only": True,
            "fresh_confirmation_and_sensitivity_are_inferential": True,
            "confirmation_all_evaluable_and_minimum_hits_per_cell": 10,
            "sensitivity_all_evaluable_and_minimum_hits_per_cell": 2,
        },
        "production_execution_units": {
            "path": execution_evidence[0]["path"],
            "sha256": execution_evidence[0]["sha256"],
            "production_seed_digest": production_seed_digest,
        },
        "implementation_sources": _implementation_sources(root),
        "runtime": _runtime_record(root, slim_path),
        "excluded_seed_artifacts": excluded_evidence,
        "seed_registry": registry,
        "rows_sha256": _canonical_sha256(rows),
        "rows": rows,
        "scientific_caveats": [
            (
                "The six endpoints were selected after inspecting the exploratory "
                "screen; only fresh confirmation and sensitivity draws validate them."
            ),
            (
                "Recipient nonloss and final AF/panel ascertainment condition on "
                "successful introgression and endpoint attainment."
            ),
            "SLiM Q=5 is an approximation and is fixed in both validation phases.",
            "No Gamma-SMC or TMRCA statistic enters planning, gating, or freezing.",
        ],
    }


def _snapshot_sources(
    sources: Mapping[str, str], repo_root: Path, snapshot_dir: Path
) -> dict[str, dict[str, Any]]:
    snapshot_dir.mkdir(parents=True, exist_ok=True)
    records = {}
    for relative, expected_hash in sorted(sources.items()):
        source = _require_repo_path(repo_root / relative, repo_root, label="source")
        digest = _require_sha256(expected_hash, label=f"source {relative}")
        if not source.is_file() or sha256_file(source) != digest:
            raise ValueError(f"fixed-v2 source changed before snapshot: {relative}")
        safe = relative.replace("/", "__").replace("\\", "__")
        destination = snapshot_dir / f"{safe}.sha256_{digest}"
        if destination.is_file():
            if sha256_file(destination) != digest:
                raise ValueError(f"fixed-v2 source snapshot differs: {relative}")
        else:
            temporary = destination.with_name(f"{destination.name}.tmp.{os.getpid()}")
            try:
                shutil.copyfile(source, temporary)
                if sha256_file(temporary) != digest:
                    raise ValueError("fixed-v2 temporary source snapshot differs")
                os.replace(temporary, destination)
            finally:
                temporary.unlink(missing_ok=True)
        try:
            destination.chmod(0o444)
        except OSError:
            pass
        records[relative] = {
            "path": destination.name,
            "sha256": digest,
            "bytes": destination.stat().st_size,
        }
    return records


def write_atomic_manifest(
    manifest: Mapping[str, Any],
    path: str | Path,
    *,
    repo_root: str | Path,
) -> dict[str, Any]:
    """Publish the manifest and complete all-phase seed projection together."""

    root = Path(repo_root).resolve()
    destination = _require_repo_path(path, root, label="manifest")
    payload = json.loads(json.dumps(manifest, allow_nan=False))
    if payload.get("schema") != MANIFEST_SCHEMA or payload.get("status") != "planned":
        raise ValueError("fixed-v2 manifest schema/status is incompatible")
    frame = pd.DataFrame(payload.get("rows", [])).loc[:, list(ROW_COLUMNS)]
    reservation_path = destination.parent / "han_fixed_v2_all_phase_plan.tsv"
    reservation_path = _require_repo_path(
        reservation_path, root, label="all-phase reservation"
    )
    staged: Path | None = None
    evidence_path = reservation_path
    if reservation_path.is_file():
        current = pd.read_csv(reservation_path, sep="\t").loc[:, list(ROW_COLUMNS)]
        pd.testing.assert_frame_equal(
            frame.reset_index(drop=True),
            current.reset_index(drop=True),
            check_dtype=False,
            check_exact=False,
            rtol=0.0,
            atol=1e-12,
        )
    else:
        staged = destination.parent / f".han_fixed_v2_plan.staged.{os.getpid()}.tsv"
        _atomic_frame(staged, frame)
        evidence_path = staged
    payload["all_phase_seed_reservation"] = {
        "path": reservation_path.relative_to(root).as_posix(),
        "sha256": sha256_file(evidence_path),
        "rows": len(frame),
        "simulation_seed_sha256": _seed_digest(frame["seed"]),
        "panel_seed_sha256": _seed_digest(frame["panel_seed"]),
        "published_only_with_authoritative_manifest": True,
    }
    snapshots = _snapshot_sources(
        payload["implementation_sources"],
        root,
        destination.parent / "source_snapshots",
    )
    payload["source_snapshots"] = snapshots
    payload["source_snapshots_sha256"] = _canonical_sha256(snapshots)
    try:
        _immutable_json(destination, payload)
        if staged is not None:
            os.replace(staged, reservation_path)
            staged = None
        return payload
    finally:
        if staged is not None:
            staged.unlink(missing_ok=True)


def _validate_manifest_rows(manifest: Mapping[str, Any]) -> pd.DataFrame:
    rows = manifest.get("rows")
    if not isinstance(rows, list) or manifest.get("rows_sha256") != _canonical_sha256(
        rows
    ):
        raise ValueError("fixed-v2 manifest row self-check failed")
    frame = pd.DataFrame(rows)
    if set(frame.columns) != set(ROW_COLUMNS) or len(frame.columns) != len(ROW_COLUMNS):
        raise ValueError("fixed-v2 manifest row columns differ")
    frame = frame.loc[:, list(ROW_COLUMNS)]
    if len(frame) != 720 or frame["draw_id"].duplicated().any():
        raise ValueError("fixed-v2 manifest draw identities are incomplete")
    all_rng = pd.concat([frame["seed"], frame["panel_seed"]], ignore_index=True)
    if all_rng.duplicated().any():
        raise ValueError("fixed-v2 simulation/panel seeds are not unique")
    endpoint_index = endpoint_table().set_index(
        ["selection_coefficient", "target_allele_frequency"]
    )
    for phase, draws in PHASE_DRAW_COUNTS.items():
        subset = frame[frame["phase"].astype(str).eq(phase)]
        if len(subset) != draws * 6:
            raise ValueError(f"fixed-v2 {phase} draw count differs")
        counts = subset.groupby(
            ["selection_coefficient", "target_allele_frequency"]
        ).size()
        if len(counts) != 6 or set(counts.astype(int)) != {draws}:
            raise ValueError(f"fixed-v2 {phase} cell coverage differs")
    if set(frame["phase"].astype(str)) != set(PHASE_DRAW_COUNTS):
        raise ValueError("fixed-v2 manifest contains an unknown phase")
    if set(frame["selection_coefficient"].astype(float)) != set(
        SELECTION_COEFFICIENTS
    ) or set(frame["target_allele_frequency"].astype(float)) != set(TARGET_FREQUENCIES):
        raise ValueError("fixed-v2 six-cell grid differs")
    for raw in frame.to_dict(orient="records"):
        row = _normalized_row(raw)
        coefficient = float(row["selection_coefficient"])
        target = float(row["target_allele_frequency"])
        endpoint = endpoint_index.loc[(coefficient, target)]
        phase = str(row["phase"])
        focal = phase == PHASE_CONFIRMATION
        expected_identity = (
            f"han_fixed_v2__{phase}__s{coefficient:.6f}__af{target:.6f}__"
            f"q{SLIM_SCALING_FACTOR:g}__draw{int(row['draw_index']):03d}"
        )
        expected_geometry = (
            (FOCAL_ONLY_LENGTH_BP, FOCAL_ONLY_POSITION_BP, FOCAL_ONLY_MODE)
            if focal
            else (PRODUCTION_LENGTH_BP, PRODUCTION_POSITION_BP, PRODUCTION_MODE)
        )
        observed_geometry = (
            int(row["sequence_length_bp"]),
            int(row["focal_position_bp"]),
            str(row["processing_mode"]),
        )
        if str(row["draw_id"]) != expected_identity:
            raise ValueError("fixed-v2 draw identity differs from its fields")
        if observed_geometry != expected_geometry:
            raise ValueError("fixed-v2 phase geometry/processing differs")
        if not math.isclose(
            float(row["duration_multiplier"]),
            float(endpoint["duration_multiplier"]),
            abs_tol=1e-12,
        ) or not math.isclose(
            float(row["realized_selection_end_generations_ago"]),
            float(endpoint["realized_selection_end_generations_ago"]),
            abs_tol=1e-12,
        ):
            raise ValueError("fixed-v2 endpoint differs from frozen table")
        if not math.isclose(
            float(row["requested_selection_end_generations_ago"]),
            float(endpoint["requested_selection_end_generations_ago"]),
            abs_tol=1e-9,
        ):
            raise ValueError("fixed-v2 requested endpoint differs")
        if (
            not math.isclose(
                float(row["population_af_lower"]),
                target - AF_HALF_WIDTH,
                abs_tol=1e-12,
            )
            or not math.isclose(
                float(row["population_af_upper"]),
                target + AF_HALF_WIDTH,
                abs_tol=1e-12,
            )
            or int(row["exact_sample_alt_count"]) != round(2 * SAMPLE_DIPLOIDS * target)
            or int(row["sample_diploids"]) != SAMPLE_DIPLOIDS
            or int(row["candidate_pool_diploids"]) != CANDIDATE_POOL_DIPLOIDS
            or not math.isclose(
                float(row["slim_scaling_factor"]), SLIM_SCALING_FACTOR, abs_tol=1e-12
            )
            or not math.isclose(
                float(row["mutation_age_generations"]),
                INTROGRESSION_MUTATION_AGE_GENERATIONS,
                abs_tol=1e-12,
            )
            or not math.isclose(
                float(row["selection_start_generations_ago"]),
                INTROGRESSION_PULSE_GENERATIONS,
                abs_tol=1e-12,
            )
            or not math.isclose(
                float(row["timeout_seconds"]),
                DEFAULT_DRAW_TIMEOUT_SECONDS,
                abs_tol=1e-12,
            )
            or str(row["exploratory_screen_ledger_sha256"])
            != EXPLORATORY_SCREEN_ARTIFACTS[EXPLORATORY_SCREEN_LEDGER_RELATIVE_PATH]
            or int(row["seed"]) < 1
            or int(row["panel_seed"]) < 1
            or int(row["seed_nonce"]) < 0
            or int(row["panel_seed_nonce"]) < 0
        ):
            raise ValueError("fixed-v2 row scalar contract differs")
    for (phase, coefficient, target), group in frame.groupby(
        ["phase", "selection_coefficient", "target_allele_frequency"]
    ):
        if sorted(group["draw_index"].astype(int)) != list(
            range(PHASE_DRAW_COUNTS[str(phase)])
        ):
            raise ValueError(
                f"fixed-v2 indices differ for {phase}/{coefficient}/{target}"
            )
    registry = manifest.get("seed_registry")
    if (
        not isinstance(registry, Mapping)
        or registry.get("schema") != SEED_REGISTRY_SCHEMA
    ):
        raise ValueError("fixed-v2 seed registry is absent")
    if (
        registry.get("fixed_v2_union_sha256") != _seed_digest(all_rng)
        or int(registry.get("fixed_v2_union_count", -1)) != len(all_rng)
        or int(registry.get("exploratory_provenance_seed_count", -1))
        != EXPLORATORY_SEED_COUNT
        or registry.get("exploratory_provenance_seed_sha256") != EXPLORATORY_SEED_SHA256
        or int(registry.get("exploratory_previously_omitted_seed_count", -1))
        != EXPLORATORY_PREVIOUSLY_OMITTED_SEED_COUNT
        or registry.get("exploratory_previously_omitted_seed_sha256")
        != EXPLORATORY_PREVIOUSLY_OMITTED_SEED_SHA256
        or registry.get("simulation_seed_sha256") != _seed_digest(frame["seed"])
        or registry.get("panel_seed_sha256") != _seed_digest(frame["panel_seed"])
    ):
        raise ValueError("fixed-v2 seed registry differs from rows")
    return frame


def load_manifest(
    path: str | Path,
    *,
    repo_root: str | Path,
    require_current_sources: bool = True,
) -> tuple[dict[str, Any], pd.DataFrame, str]:
    root = Path(repo_root).resolve()
    manifest_path = _require_repo_path(path, root, label="manifest")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("fixed-v2 manifest is unreadable") from error
    if manifest.get("schema") != MANIFEST_SCHEMA or manifest.get("status") != "planned":
        raise ValueError("fixed-v2 manifest schema/status differs")
    frame = _validate_manifest_rows(manifest)
    reservation = manifest.get("all_phase_seed_reservation")
    if not isinstance(reservation, Mapping):
        raise TypeError("fixed-v2 all-phase reservation is absent")
    reservation_path = _require_repo_path(
        root / str(reservation.get("path", "")), root, label="all-phase reservation"
    )
    if (
        not reservation_path.is_file()
        or sha256_file(reservation_path) != reservation.get("sha256")
        or int(reservation.get("rows", -1)) != len(frame)
        or reservation.get("simulation_seed_sha256") != _seed_digest(frame["seed"])
        or reservation.get("panel_seed_sha256") != _seed_digest(frame["panel_seed"])
    ):
        raise ValueError("fixed-v2 all-phase reservation differs")
    projected = pd.read_csv(reservation_path, sep="\t").loc[:, list(ROW_COLUMNS)]
    pd.testing.assert_frame_equal(
        frame.reset_index(drop=True),
        projected.reset_index(drop=True),
        check_dtype=False,
        check_exact=False,
        rtol=0.0,
        atol=1e-12,
    )
    sources = manifest.get("implementation_sources")
    snapshots = manifest.get("source_snapshots")
    if not isinstance(sources, Mapping) or not isinstance(snapshots, Mapping):
        raise TypeError("fixed-v2 source provenance is incomplete")
    if manifest.get("source_snapshots_sha256") != _canonical_sha256(snapshots):
        raise ValueError("fixed-v2 source snapshot self-check failed")
    if set(sources) != set(snapshots):
        raise ValueError("fixed-v2 source snapshots do not cover implementation")
    for relative, expected in sources.items():
        digest = _require_sha256(str(expected), label=f"source {relative}")
        snapshot = (
            manifest_path.parent / "source_snapshots" / str(snapshots[relative]["path"])
        )
        if not snapshot.is_file() or sha256_file(snapshot) != digest:
            raise ValueError(f"fixed-v2 source snapshot differs: {relative}")
        if require_current_sources:
            current = root / relative
            if not current.is_file() or sha256_file(current) != digest:
                raise ValueError(f"fixed-v2 implementation source drifted: {relative}")
    if _bind_exploratory_screen(root) != manifest.get("exploratory_screen"):
        raise ValueError("fixed-v2 exploratory screen binding drifted")
    if _bind_exploratory_seed_provenance(root) != manifest.get(
        "exploratory_seed_provenance"
    ):
        raise ValueError("fixed-v2 exploratory seed provenance binding drifted")
    retry_provenance = manifest.get("retry_provenance")
    if not isinstance(retry_provenance, list):
        raise TypeError("fixed-v2 retry provenance binding is absent")
    retry_paths = [
        root / str(record.get("inventory_path", "")) for record in retry_provenance
    ]
    if _bind_retry_provenance(retry_paths, root) != retry_provenance:
        raise ValueError("fixed-v2 retry provenance binding drifted")
    evidence = manifest.get("excluded_seed_artifacts")
    if not isinstance(evidence, list) or not evidence:
        raise ValueError("fixed-v2 excluded seed evidence is absent")
    evidence_paths = [root / str(item["path"]) for item in evidence]
    excluded, current_evidence = _excluded_seed_evidence(evidence_paths, root)
    if current_evidence != evidence:
        raise ValueError("fixed-v2 excluded seed evidence drifted")
    if (
        manifest["seed_registry"].get("excluded_union_count") != len(excluded)
        or manifest["seed_registry"].get("excluded_union_sha256")
        != _seed_digest(excluded)
        or (set(frame["seed"].astype(int)) | set(frame["panel_seed"].astype(int)))
        & excluded
    ):
        raise ValueError("fixed-v2 RNG exclusion binding differs")
    runtime = manifest.get("runtime")
    if not isinstance(runtime, Mapping) or not isinstance(runtime.get("slim"), Mapping):
        raise TypeError("fixed-v2 runtime binding is absent")
    slim = _require_repo_path(
        root / str(runtime["slim"].get("path", "")), root, label="SLiM executable"
    )
    if require_current_sources and _runtime_record(root, slim) != runtime:
        raise ValueError("fixed-v2 runtime binding drifted")
    production = manifest.get("production_execution_units")
    if not isinstance(production, Mapping):
        raise TypeError("fixed-v2 production seed binding is absent")
    units_path = _require_repo_path(
        root / str(production.get("path", "")), root, label="execution units"
    )
    if not units_path.is_file() or sha256_file(units_path) != production.get("sha256"):
        raise ValueError("fixed-v2 production execution units drifted")
    units = pd.read_csv(units_path, sep="\t")
    if _seed_digest(units["seed"]) != production.get("production_seed_digest"):
        raise ValueError("fixed-v2 production seed digest drifted")
    return manifest, frame, sha256_file(manifest_path)


def _unit_for_row(row: Mapping[str, Any]) -> dict[str, Any]:
    target = float(row["target_allele_frequency"])
    return {
        "unit_id": str(row["draw_id"]),
        "demography_id": "ancient_eurasia_han_introgression",
        "demography_kind": "introgression",
        "population": INTROGRESSION_TARGET_POPULATION,
        "source_model": "stdpopsim AncientEurasia_9K19",
        "selection_origin": "archaic_specific_introgressed_standing_variation",
        "simulation_class": "selected",
        "selection_coefficient": float(row["selection_coefficient"]),
        "target_allele_frequency": target,
        "population_af_lower": float(row["population_af_lower"]),
        "population_af_upper": float(row["population_af_upper"]),
        "exact_sample_alt_count": int(row["exact_sample_alt_count"]),
        "sample_diploids": int(row["sample_diploids"]),
        "replicate_index": int(row["draw_index"]) + 1,
        "seed": int(row["seed"]),
        # Production validators require the canonical unit geometry.  Only the
        # validation sweep contig is replaced after construction.
        "sequence_length_bp": PRODUCTION_LENGTH_BP,
        "focal_position_bp": PRODUCTION_POSITION_BP,
    }


def _audit_fixed_events(sweep: Any, row: Mapping[str, Any]) -> dict[str, Any]:
    events = list(sweep.extended_events)
    focal = [
        event
        for event in events
        if str(getattr(event, "single_site_id", "")) == FOCAL_SITE_ID
    ]
    draws = [event for event in focal if isinstance(event, stdpopsim.DrawMutation)]
    if len(draws) != 1:
        raise ValueError("fixed-v2 sweep must contain one focal DrawMutation")
    draw = draws[0]
    if str(draw.population) != "Neanderthal" or not math.isclose(
        float(draw.time),
        INTROGRESSION_MUTATION_AGE_GENERATIONS,
        abs_tol=1e-12,
    ):
        raise ValueError("fixed-v2 mutation origin differs from Neanderthal age 2400")
    coefficient = float(row["selection_coefficient"])
    endpoint = float(row["realized_selection_end_generations_ago"])
    boundary = math.floor(HAN_SPLIT_GENERATIONS / SLIM_SCALING_FACTOR) * (
        SLIM_SCALING_FACTOR
    )
    fitness = [
        event for event in focal if isinstance(event, stdpopsim.ChangeMutationFitness)
    ]
    expected_intervals = (
        [("Loschbour", INTROGRESSION_PULSE_GENERATIONS, endpoint)]
        if endpoint >= boundary
        else [
            ("Loschbour", INTROGRESSION_PULSE_GENERATIONS, boundary),
            (INTROGRESSION_TARGET_POPULATION, boundary, endpoint),
        ]
    )
    observed_intervals = sorted(
        (
            str(event.population),
            float(event.start_time),
            float(event.end_time),
        )
        for event in fitness
    )
    if observed_intervals != sorted(expected_intervals):
        raise ValueError("fixed-v2 fitness intervals differ from the selected endpoint")
    for event in fitness:
        if not math.isclose(
            float(event.selection_coeff), coefficient, abs_tol=1e-12
        ) or not math.isclose(
            float(event.dominance_coeff), DOMINANCE_COEFFICIENT, abs_tol=1e-12
        ):
            raise ValueError("fixed-v2 fitness coefficient/dominance differs")
    conditions = [
        event
        for event in focal
        if isinstance(event, stdpopsim.ConditionOnAlleleFrequency)
    ]
    terminal = [
        event
        for event in conditions
        if str(event.population) == INTROGRESSION_TARGET_POPULATION
        and math.isclose(float(event.start_time), 0.0, abs_tol=1e-12)
        and math.isclose(float(event.end_time), 0.0, abs_tol=1e-12)
    ]
    if terminal:
        raise ValueError("fixed-v2 must use external terminal AF ascertainment")
    recipient_nonloss = [
        event
        for event in conditions
        if str(event.op) == ">"
        and math.isclose(float(event.allele_frequency), 0.0, abs_tol=1e-12)
        and str(event.population) in {"Loschbour", INTROGRESSION_TARGET_POPULATION}
    ]
    source_conditions = [
        event for event in conditions if str(event.population) == "Neanderthal"
    ]
    if len(recipient_nonloss) != 2 or len(source_conditions) != 2:
        raise ValueError("fixed-v2 source/recipient conditioning differs")
    record = sweep.provenance_record()
    cessation = record.get("selection", {}).get("cessation")
    ascertainment = record.get("focused_sample_endpoint_ascertainment")
    if (
        not isinstance(cessation, Mapping)
        or not math.isclose(
            float(cessation.get("selection_end_generations_ago", math.nan)),
            endpoint,
            abs_tol=1e-12,
        )
        or not isinstance(ascertainment, Mapping)
        or ascertainment.get("population_frequency_conditioning_in_slim") is not False
    ):
        raise ValueError("fixed-v2 cessation/external ascertainment provenance differs")
    serialized = serialize_extended_events(events)
    realized = {
        "mutation_age_generations": 2400.0,
        "source_check_generations": 2275.0,
        "introgression_and_selection_onset_generations": 2270.0,
        "demographic_han_split_generations": 2015.0,
        "selection_end_generations": endpoint,
    }
    if not math.isclose(
        endpoint / SLIM_SCALING_FACTOR, round(endpoint / 5), abs_tol=1e-9
    ):
        raise ValueError("fixed-v2 selection endpoint is not on the Q=5 grid")
    return {
        "schema": EVENT_AUDIT_SCHEMA,
        "mutation_population": str(draw.population),
        "mutation_age_generations": float(draw.time),
        "selection_coefficient": coefficient,
        "duration_multiplier": float(row["duration_multiplier"]),
        "requested_selection_end_generations_ago": float(
            row["requested_selection_end_generations_ago"]
        ),
        "realized_selection_end_generations_ago": endpoint,
        "selection_intervals": [
            {"population": population, "start_time": start, "end_time": end}
            for population, start, end in expected_intervals
        ],
        "selection_interval_count": len(expected_intervals),
        "recipient_nonloss_condition_count": len(recipient_nonloss),
        "source_condition_count": len(source_conditions),
        "terminal_han_condition_count": 0,
        "external_terminal_ascertainment": True,
        "realized_q5_event_times_generations": realized,
        "realized_event_schedule_sha256": _canonical_sha256(realized),
        "focal_event_count": len(focal),
        "serialized_extended_events": serialized,
        "serialized_extended_events_sha256": _canonical_sha256(serialized),
    }


def build_fixed_v2_objects(
    row: Mapping[str, Any], *, repo_root: str | Path
) -> tuple[stdpopsim.DemographicModel, Any, dict[str, int], dict[str, Any]]:
    unit = _unit_for_row(row)
    q = float(row["slim_scaling_factor"])
    endpoint = float(row["realized_selection_end_generations_ago"])
    model, sweep, samples, model_record = _selected_objects(
        unit,
        repo_root,
        q,
        int(row["candidate_pool_diploids"]),
        han_selection_end_generations_ago=endpoint,
    )
    event_audit = _audit_fixed_events(sweep, row)
    sweep = replace(
        sweep,
        contig=build_focal_contig(
            sequence_length=int(row["sequence_length_bp"]),
            focal_position=int(row["focal_position_bp"]),
        ),
    )
    return (
        model,
        sweep,
        samples,
        {
            "model_mode": MODEL_MODE,
            "event_audit": event_audit,
            "sweep": sweep.provenance_record(),
            "selection_endpoint": model_record["selection_endpoint"],
        },
    )


def _position_aware_exact_panel(
    ts: tskit.TreeSequence,
    *,
    focal_position: int,
    focal_genotype_counts: Sequence[int],
    sample_diploids: int,
    exact_alt_count: int,
    seed: int,
) -> tuple[tskit.TreeSequence, dict[str, Any]]:
    pool = build_diploid_pair_table(
        ts, int(focal_position), focal_genotype_counts=focal_genotype_counts
    )
    counts = pool["focal_selected_allele_count"].to_numpy(dtype=int)
    available = {value: int(np.count_nonzero(counts == value)) for value in (0, 1, 2)}
    triples = feasible_exact_panel_genotype_triples(
        counts,
        sample_diploids=int(sample_diploids),
        exact_alt_count=int(exact_alt_count),
    )
    if not triples:
        raise ValueError("fixed-v2 candidate pool has no eligible exact-k panel")
    log_weights = np.asarray(
        [record["log_number_of_subsets"] for record in triples], dtype=float
    )
    weights = np.exp(log_weights - log_weights.max())
    rng = np.random.default_rng(int(seed))
    chosen = triples[int(rng.choice(len(triples), p=weights / weights.sum()))]
    numbers = (
        int(chosen["hom_ref"]),
        int(chosen["heterozygous"]),
        int(chosen["hom_alt"]),
    )
    rows = []
    for genotype, number in enumerate(numbers):
        choices = np.flatnonzero(counts == genotype)
        rows.extend(
            int(value)
            for value in rng.choice(choices, size=number, replace=False).tolist()
        )
    rows.sort()
    nodes = (
        pool.iloc[rows][["sample_node_0", "sample_node_1"]]
        .to_numpy(dtype=np.int32)
        .reshape(-1)
    )
    if ts.num_migrations:
        tables = ts.dump_tables()
        flags = np.asarray(tables.nodes.flags, dtype=np.uint32).copy()
        flags &= np.bitwise_not(np.uint32(tskit.NODE_IS_SAMPLE))
        flags[nodes] |= np.uint32(tskit.NODE_IS_SAMPLE)
        node_table = tables.nodes
        node_table.set_columns(
            flags=flags,
            time=node_table.time,
            population=node_table.population,
            individual=node_table.individual,
            metadata=node_table.metadata,
            metadata_offset=node_table.metadata_offset,
        )
        panel = tables.tree_sequence()
    else:
        panel = ts.simplify(
            samples=nodes,
            filter_populations=False,
            filter_individuals=True,
            filter_sites=True,
            keep_unary=False,
        )
    return panel, {
        "schema": "gamma-smc.position-aware-uniform-exact-k-panel/v1",
        "candidate_pool_diploids": len(pool),
        "candidate_pool_genotype_counts": {
            "hom_ref": available[0],
            "heterozygous": available[1],
            "hom_alt": available[2],
        },
        "eligible_genotype_count_triples": len(triples),
        "chosen_sample_genotype_counts": {
            "hom_ref": numbers[0],
            "heterozygous": numbers[1],
            "hom_alt": numbers[2],
        },
        "selection_method": (
            "uniform_over_all_size_N_exact_alt_count_subsets_passing_genotype_qc"
        ),
        "panel_seed": int(seed),
        "focal_position_0based": int(focal_position),
    }


