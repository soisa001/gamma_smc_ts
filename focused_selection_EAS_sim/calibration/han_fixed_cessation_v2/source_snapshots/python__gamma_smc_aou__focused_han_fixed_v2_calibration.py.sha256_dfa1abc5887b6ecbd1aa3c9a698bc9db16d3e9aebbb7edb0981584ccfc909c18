def _save_panel(
    ts: tskit.TreeSequence,
    row: Mapping[str, Any],
    expectation: Mapping[str, Any],
    directory: Path,
    *,
    raw_forward: bool,
    raw_counts: Sequence[int] | None,
) -> dict[str, Any]:
    coordinate = int(row["focal_position_bp"])
    panel_seed = int(row["panel_seed"])
    if raw_forward:
        if raw_counts is None:
            raise ValueError("fixed-v2 raw panel requires focal genotype counts")
        panel, panel_record = _position_aware_exact_panel(
            ts,
            focal_position=coordinate,
            focal_genotype_counts=raw_counts,
            sample_diploids=int(row["sample_diploids"]),
            exact_alt_count=int(row["exact_sample_alt_count"]),
            seed=panel_seed,
        )
        identity = _inspect_raw_selected_focal_identity(panel, expectation)
        if identity.get("status") != "valid":
            raise ValueError("fixed-v2 accepted raw panel lost its selected mutation")
        counts = _selected_counts_from_raw_tree(panel, identity)
        pair_table = build_diploid_pair_table(
            panel, coordinate, focal_genotype_counts=counts
        )
    else:
        panel, panel_record = select_exact_sample_panel(
            ts,
            sample_diploids=int(row["sample_diploids"]),
            exact_alt_count=int(row["exact_sample_alt_count"]),
            seed=panel_seed,
        )
        identity = validate_selected_focal_identity(panel, expectation)
        pair_table = build_diploid_pair_table(panel, coordinate)
        counts = pair_table["focal_selected_allele_count"].to_numpy(dtype=int)
    n0, n1, n2 = (int(np.count_nonzero(counts == value)) for value in (0, 1, 2))
    if (
        len(counts) != int(row["sample_diploids"])
        or int(np.sum(counts)) != int(row["exact_sample_alt_count"])
        or n0 < 2
        or n1 < 1
        or n2 < 2
    ):
        raise ValueError("fixed-v2 exact panel violates size, AF, or genotype QC")
    tree_path = directory / "accepted_panel.trees"
    manifest_path = directory / "accepted_panel_manifest.tsv"
    _atomic_tree(tree_path, panel)
    _atomic_frame(manifest_path, pair_table)
    reloaded = tskit.load(tree_path)
    if raw_forward:
        reloaded_identity = _inspect_raw_selected_focal_identity(reloaded, expectation)
        if reloaded_identity.get("status") != "valid":
            raise ValueError("fixed-v2 raw panel roundtrip identity failed")
        reloaded_counts = _selected_counts_from_raw_tree(reloaded, reloaded_identity)
        rebuilt = build_diploid_pair_table(
            reloaded, coordinate, focal_genotype_counts=reloaded_counts
        )
    else:
        reloaded_identity = validate_selected_focal_identity(reloaded, expectation)
        rebuilt = build_diploid_pair_table(reloaded, coordinate)
    persisted = pd.read_csv(manifest_path, sep="\t")
    pd.testing.assert_frame_equal(
        rebuilt.reset_index(drop=True),
        persisted.reset_index(drop=True),
        check_dtype=False,
        check_exact=False,
        rtol=0.0,
        atol=1e-12,
    )
    return {
        "panel_seed": panel_seed,
        "panel_record_json": json.dumps(
            panel_record, sort_keys=True, separators=(",", ":")
        ),
        "panel_identity_json": json.dumps(
            reloaded_identity, sort_keys=True, separators=(",", ":")
        ),
        "panel_tree_path": tree_path.name,
        "panel_tree_sha256": sha256_file(tree_path),
        "panel_manifest_path": manifest_path.name,
        "panel_manifest_sha256": sha256_file(manifest_path),
        "panel_alt_count": int(np.sum(counts)),
        "panel_af": float(np.mean(counts) / 2),
        "panel_hom_ref": n0,
        "panel_heterozygous": n1,
        "panel_hom_alt": n2,
        "panel_roundtrip_validated": True,
    }


def _inspect_neutral_overlay_recurrence(
    ts: tskit.TreeSequence, expectation: Mapping[str, Any]
) -> dict[str, Any]:
    """Accept only a valid type-1 mutation plus type-0 overlay recurrence."""

    coordinate = int(expectation.get("focal_position_0based", -1))
    if coordinate != PRODUCTION_POSITION_BP:
        raise focused_simulation.SelectedFocalIdentityError(
            "neutral-overlay recurrence is only valid in 10-Mb sensitivity"
        )
    focal_sites = [
        site
        for site in ts.sites()
        if math.isclose(
            float(site.position), float(coordinate), rel_tol=0.0, abs_tol=1e-9
        )
    ]
    if len(focal_sites) != 1 or len(focal_sites[0].mutations) < 2:
        raise focused_simulation.SelectedFocalIdentityError(
            "selected type-1 identity is required; no focal recurrence was proven"
        )
    site = focal_sites[0]
    expected_type = int(expectation["expected_mutation_type"])
    parsed: list[tuple[tskit.Mutation, Mapping[str, Any], int]] = []
    required = {
        "mutation_type",
        "selection_coeff",
        "subpopulation",
        "slim_time",
        "nucleotide",
    }
    for mutation in site.mutations:
        metadata = mutation.metadata
        if not isinstance(metadata, Mapping):
            raise focused_simulation.SelectedFocalIdentityError(
                "focal recurrence metadata is malformed"
            )
        mutation_list = metadata.get("mutation_list")
        if not isinstance(mutation_list, list) or len(mutation_list) != 1:
            raise focused_simulation.SelectedFocalIdentityError(
                "focal recurrence must have one unstacked metadata entry per mutation"
            )
        entry = mutation_list[0]
        if not isinstance(entry, Mapping) or required.difference(entry):
            raise focused_simulation.SelectedFocalIdentityError(
                "focal recurrence metadata is missing required identity fields"
            )
        try:
            mutation_type = int(entry["mutation_type"])
        except (TypeError, ValueError) as error:
            raise focused_simulation.SelectedFocalIdentityError(
                "focal recurrence mutation type is malformed"
            ) from error
        parsed.append((mutation, entry, mutation_type))
    selected = [item for item in parsed if item[2] == expected_type]
    neutral = [item for item in parsed if item[2] == 0]
    if (
        expected_type != 1
        or len(selected) != 1
        or not neutral
        or len(selected) + len(neutral) != len(parsed)
    ):
        raise focused_simulation.SelectedFocalIdentityError(
            "focal recurrence is not one type-1 mutation plus type-0 neutral overlay"
        )
    for mutation, entry, _ in neutral:
        try:
            neutral_coefficient = float(entry["selection_coeff"])
            neutral_subpopulation = int(entry["subpopulation"])
            neutral_nucleotide = int(entry["nucleotide"])
            int(entry["slim_time"])
        except (TypeError, ValueError) as error:
            raise focused_simulation.SelectedFocalIdentityError(
                "neutral-overlay recurrence metadata is malformed"
            ) from error
        if (
            not math.isclose(neutral_coefficient, 0.0, rel_tol=0.0, abs_tol=1e-12)
            or neutral_subpopulation != -1
            or neutral_nucleotide not in range(4)
            or mutation.derived_state != "ACGT"[neutral_nucleotide]
            or not math.isfinite(float(mutation.time))
            or float(mutation.time) < 0.0
        ):
            raise focused_simulation.SelectedFocalIdentityError(
                "focal recurrence is not a valid stdpopsim type-0 neutral overlay"
            )

    selected_mutation, _, _ = selected[0]
    # Validate the selected mutation with the production identity validator
    # after removing only the proven type-0 collision.  This preserves every
    # source/time/Q/nucleotide check while preventing recurrence itself from
    # weakening the type-1 contract.
    tables = ts.dump_tables()
    tables.delete_sites([int(site.id)], record_provenance=False)
    selected_site = tables.sites.add_row(
        position=float(site.position),
        ancestral_state=site.ancestral_state,
        metadata=site.metadata,
    )
    tables.mutations.add_row(
        site=selected_site,
        node=int(selected_mutation.node),
        derived_state=selected_mutation.derived_state,
        parent=tskit.NULL,
        metadata=selected_mutation.metadata,
        time=float(selected_mutation.time),
    )
    tables.sort()
    selected_identity = focused_simulation.validate_selected_focal_identity(
        tables.tree_sequence(), expectation
    )
    if selected_identity.get("status") != "valid":
        raise focused_simulation.SelectedFocalIdentityError(
            "selected type-1 recurrence identity did not validate"
        )
    mutation_ids = {int(mutation.id) for mutation, _, _ in parsed}
    if any(
        int(mutation.parent) != tskit.NULL and int(mutation.parent) not in mutation_ids
        for mutation, _, _ in parsed
    ):
        raise focused_simulation.SelectedFocalIdentityError(
            "focal recurrence parent points outside the focal site"
        )
    return {
        "schema": IDENTITY_COLLISION_SCHEMA,
        "status": "valid_type1_with_neutral_overlay_recurrence",
        "focal_position_0based": coordinate,
        "selected_type1_valid": True,
        "neutral_overlay_only": True,
        "observed_focal_site_count": 1,
        "observed_tskit_mutation_count": len(site.mutations),
        "observed_metadata_entry_count": len(parsed),
        "observed_mutation_types": sorted({item[2] for item in parsed}),
        "selected_type1_count": 1,
        "neutral_type0_count": len(neutral),
        "selected_mutation_id": int(selected_mutation.id),
        "selected_mutation_parent": int(selected_mutation.parent),
        "neutral_mutation_ids": sorted(int(item[0].id) for item in neutral),
        "selected_identity": selected_identity,
    }


def _validate_identity_collision_evidence(identity: Mapping[str, Any]) -> None:
    selected_identity = identity.get("selected_identity")
    neutral_ids = identity.get("neutral_mutation_ids")
    try:
        selected_id = int(identity.get("selected_mutation_id", -1))
        selected_parent = int(identity.get("selected_mutation_parent", -2))
        neutral_id_set = (
            {int(value) for value in neutral_ids}
            if isinstance(neutral_ids, list)
            else set()
        )
    except (TypeError, ValueError) as error:
        raise ValueError(
            "fixed-v2 sensitivity identity collision evidence is not structured"
        ) from error
    if (
        identity.get("schema") != IDENTITY_COLLISION_SCHEMA
        or identity.get("status") != "valid_type1_with_neutral_overlay_recurrence"
        or identity.get("selected_type1_valid") is not True
        or identity.get("neutral_overlay_only") is not True
        or int(identity.get("observed_focal_site_count", -1)) != 1
        or int(identity.get("selected_type1_count", -1)) != 1
        or int(identity.get("neutral_type0_count", -1)) < 1
        or int(identity.get("observed_tskit_mutation_count", -1))
        != 1 + int(identity.get("neutral_type0_count", -1))
        or int(identity.get("observed_metadata_entry_count", -1))
        != int(identity.get("observed_tskit_mutation_count", -1))
        or identity.get("observed_mutation_types") != [0, 1]
        or not isinstance(neutral_ids, list)
        or len(neutral_ids) != int(identity.get("neutral_type0_count", -1))
        or len(neutral_id_set) != len(neutral_ids)
        or selected_id < 0
        or selected_id in neutral_id_set
        or selected_parent not in ({tskit.NULL} | neutral_id_set)
        or not isinstance(selected_identity, Mapping)
        or selected_identity.get("schema")
        != focused_simulation.SELECTED_FOCAL_IDENTITY_SCHEMA
        or selected_identity.get("status") != "valid"
        or int(selected_identity.get("focal_position_0based", -1))
        != PRODUCTION_POSITION_BP
        or selected_identity.get("expected_source_population") != "Neanderthal"
        or int(selected_identity.get("expected_source_subpopulation", -1)) != 7
        or int(selected_identity.get("observed_source_subpopulation", -1)) != 7
        or not math.isclose(
            float(selected_identity.get("expected_origin_time_generations", math.nan)),
            INTROGRESSION_MUTATION_AGE_GENERATIONS,
            rel_tol=0.0,
            abs_tol=1e-9,
        )
        or not math.isclose(
            float(selected_identity.get("observed_origin_time_generations", math.nan)),
            INTROGRESSION_MUTATION_AGE_GENERATIONS,
            rel_tol=0.0,
            abs_tol=1e-9,
        )
        or not math.isclose(
            float(selected_identity.get("observed_selection_coeff", math.nan)),
            0.0,
            rel_tol=0.0,
            abs_tol=1e-12,
        )
        or not math.isclose(
            float(selected_identity.get("observed_slim_scaling_factor", math.nan)),
            SLIM_SCALING_FACTOR,
            rel_tol=0.0,
            abs_tol=1e-12,
        )
        or int(selected_identity.get("observed_mutation_type", -1)) != 1
        or int(selected_identity.get("observed_tskit_mutation_count", -1)) != 1
        or int(selected_identity.get("observed_metadata_entry_count", -1)) != 1
        or selected_identity.get("observed_mutation_types") != [1]
    ):
        raise ValueError(
            "fixed-v2 sensitivity identity collision evidence is not structured"
        )


def _identity_collision_result(identity: Mapping[str, Any]) -> dict[str, Any]:
    _validate_identity_collision_evidence(identity)
    return {
        "terminal_class": "identity_collision",
        "strict_type1_identity_passed": False,
        "identity_error": "valid_type1_with_neutral_overlay_recurrence",
        "identity_json": json.dumps(identity, sort_keys=True, separators=(",", ":")),
        "candidate_pool_alt_count": None,
        "candidate_pool_af": None,
        "candidate_pool_frequency_gate_passed": False,
        "candidate_pool_frequency_gate_json": "",
        "exact_panel_feasible": False,
        "hit": False,
        **_empty_panel_result(),
    }


def _evaluate_tree(
    ts: tskit.TreeSequence,
    row: Mapping[str, Any],
    expectation: Mapping[str, Any],
    unit: Mapping[str, Any],
    directory: Path,
) -> dict[str, Any]:
    raw_forward = str(row["phase"]) == PHASE_CONFIRMATION
    coordinate = int(row["focal_position_bp"])
    for name in ("accepted_panel.trees", "accepted_panel_manifest.tsv"):
        (directory / name).unlink(missing_ok=True)
    raw_counts: np.ndarray | None = None
    if raw_forward:
        identity = _inspect_raw_selected_focal_identity(ts, expectation)
        if identity.get("status") != "valid":
            raise focused_simulation.SelectedFocalIdentityError(
                "confirmation requires a retained valid selected type-1 mutation"
            )
        raw_counts = _selected_counts_from_raw_tree(ts, identity)
        counts = raw_counts
        build_diploid_pair_table(ts, coordinate, focal_genotype_counts=counts)
        strict_identity = True
    else:
        try:
            identity = focused_simulation.validate_selected_focal_identity(
                ts, expectation
            )
            pair_table = build_diploid_pair_table(ts, coordinate)
            counts = pair_table["focal_selected_allele_count"].to_numpy(dtype=int)
            strict_identity = True
        except focused_simulation.SelectedFocalIdentityError:
            # This helper returns only for a valid type-1 mutation plus a
            # distinct neutral-overlay recurrence. Missing/background-only or
            # malformed selected identity remains an operational failure.
            collision = _inspect_neutral_overlay_recurrence(ts, expectation)
            return _identity_collision_result(collision)
    if len(counts) != int(row["candidate_pool_diploids"]):
        raise ValueError("fixed-v2 candidate pool has the wrong diploid count")
    gate = candidate_pool_frequency_gate(unit, counts)
    feasible = (
        feasible_exact_panel_genotype_triples(
            counts,
            sample_diploids=int(row["sample_diploids"]),
            exact_alt_count=int(row["exact_sample_alt_count"]),
        )
        if gate["passed"]
        else []
    )
    alt_count = int(np.sum(counts))
    terminal_class = (
        "loss"
        if alt_count == 0
        else "fixed"
        if alt_count == 2 * len(counts)
        else "segregating"
    )
    panel_result = _empty_panel_result()
    if strict_identity and gate["passed"] and feasible:
        panel_result = _save_panel(
            ts,
            row,
            expectation,
            directory,
            raw_forward=raw_forward,
            raw_counts=raw_counts,
        )
    hit = bool(
        strict_identity
        and gate["passed"]
        and feasible
        and panel_result["panel_roundtrip_validated"]
    )
    return {
        "terminal_class": terminal_class,
        "strict_type1_identity_passed": strict_identity,
        "identity_error": "",
        "identity_json": json.dumps(identity, sort_keys=True, separators=(",", ":")),
        "candidate_pool_alt_count": alt_count,
        "candidate_pool_af": float(alt_count / (2 * len(counts))),
        "candidate_pool_frequency_gate_passed": bool(gate["passed"]),
        "candidate_pool_frequency_gate_json": json.dumps(
            gate, sort_keys=True, separators=(",", ":")
        ),
        "exact_panel_feasible": bool(feasible),
        "hit": hit,
        **panel_result,
    }


def _run_draw(task: Mapping[str, Any]) -> dict[str, Any]:
    row = _normalized_row(task["row"])
    root = Path(task["repo_root"]).resolve()
    work_root = _require_repo_path(
        task["work_root"], root, label="phase work directory"
    )
    slim_path = _require_repo_path(task["slim_path"], root, label="SLiM executable")
    timeout_seconds = float(task["timeout_seconds"])
    if not math.isclose(timeout_seconds, float(row["timeout_seconds"]), abs_tol=1e-12):
        raise ValueError("fixed-v2 task timeout differs from its plan row")
    manifest_sha256 = str(task["manifest_sha256"])
    sources = dict(task["implementation_sources"])
    runtime = dict(task["runtime"])
    directory = work_root / str(row["draw_id"])
    directory.mkdir(parents=True, exist_ok=True)
    completion_path = directory / "completion.json"
    contract = _draw_contract(
        row,
        manifest_sha256=manifest_sha256,
        implementation_sources=sources,
        runtime=runtime,
    )
    with exclusive_unit_lock(
        directory / ".draw.lock",
        unit_id=str(row["draw_id"]),
        phase=f"han_fixed_v2_{row['phase']}",
    ):
        if completion_path.is_file():
            payload = json.loads(completion_path.read_text(encoding="utf-8"))
            if (
                payload.get("schema") != DRAW_SCHEMA
                or payload.get("contract") != contract
                or payload.get("contract_sha256") != _canonical_sha256(contract)
            ):
                raise ValueError("cached fixed-v2 draw is incompatible")
            result = dict(payload["result"])
            for path_key, hash_key in (
                ("panel_tree_path", "panel_tree_sha256"),
                ("panel_manifest_path", "panel_manifest_sha256"),
            ):
                if result.get(path_key):
                    artifact = directory / str(result[path_key])
                    if not artifact.is_file() or sha256_file(artifact) != result.get(
                        hash_key
                    ):
                        raise ValueError("cached fixed-v2 panel artifact differs")
            return result
        started = perf_counter()
        trajectory_path = directory / "trajectory.csv"
        trajectory_path.unlink(missing_ok=True)
        try:
            unit = _unit_for_row(row)
            model, sweep, samples, model_record = build_fixed_v2_objects(
                row, repo_root=root
            )
            expectation = _selected_focal_expectation(
                model, sweep, float(row["slim_scaling_factor"])
            )
            expectation["focal_position_0based"] = int(row["focal_position_bp"])
            engine = stdpopsim.get_engine("slim")
            normal = str(row["phase"]) == PHASE_SENSITIVITY
            with _wall_clock_timeout(timeout_seconds):
                if normal:
                    ts = engine.simulate(
                        model,
                        sweep.contig,
                        samples,
                        seed=int(row["seed"]),
                        extended_events=list(sweep.extended_events),
                        slim_path=str(slim_path),
                        slim_scaling_factor=float(row["slim_scaling_factor"]),
                        slim_burn_in=DEFAULT_SLIM_BURN_IN,
                        logfile=str(trajectory_path),
                        logfile_interval=100,
                        keep_mutation_ids_as_alleles=False,
                    )
                else:
                    raw = engine.simulate(
                        model,
                        sweep.contig,
                        samples,
                        seed=int(row["seed"]),
                        extended_events=list(sweep.extended_events),
                        slim_path=str(slim_path),
                        slim_scaling_factor=float(row["slim_scaling_factor"]),
                        slim_burn_in=DEFAULT_SLIM_BURN_IN,
                        logfile=str(trajectory_path),
                        logfile_interval=100,
                        keep_mutation_ids_as_alleles=True,
                        _recap_and_rescale=False,
                    )
                    ts = engine._simplify_remembered(raw)
            evaluation = _evaluate_tree(ts, row, expectation, unit, directory)
            if not trajectory_path.is_file():
                raise ValueError("fixed-v2 SLiM trajectory log is absent")
            result = {
                **row,
                "status": "complete",
                "evaluable": True,
                "model_mode": MODEL_MODE,
                "exploratory_screen_inferential_use": False,
                "post_screen_endpoint_selection": True,
                "fixed_selection_cessation": True,
                "recipient_nonloss_conditioning": True,
                "internal_terminal_han_af_conditioning": False,
                "stdpopsim_recapitation_applied": normal,
                "post_slim_neutral_mutation_overlay_applied": normal,
                **evaluation,
                "elapsed_seconds": perf_counter() - started,
                "error": evaluation.get("identity_error", ""),
                "event_audit_json": json.dumps(
                    model_record["event_audit"],
                    sort_keys=True,
                    separators=(",", ":"),
                ),
                "trajectory_path": trajectory_path.name,
                "trajectory_sha256": sha256_file(trajectory_path),
            }
        except SimulationDrawTimeout as error:
            result = {
                **row,
                "status": "timed_out",
                "evaluable": False,
                "terminal_class": "timed_out",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "hit": False,
                "elapsed_seconds": perf_counter() - started,
                "error": str(error),
            }
        except Exception as error:  # noqa: BLE001 - preserve exact draw failure
            result = {
                **row,
                "status": "failed",
                "evaluable": False,
                "terminal_class": "failed",
                "candidate_pool_alt_count": None,
                "candidate_pool_af": None,
                "candidate_pool_frequency_gate_passed": False,
                "exact_panel_feasible": False,
                "hit": False,
                "elapsed_seconds": perf_counter() - started,
                "error": f"{type(error).__name__}: {error}",
            }
        payload = {
            "schema": DRAW_SCHEMA,
            "contract": contract,
            "contract_sha256": _canonical_sha256(contract),
            "result": result,
        }
        if result["evaluable"]:
            _atomic_json(completion_path, payload)
            (directory / "last_failure.json").unlink(missing_ok=True)
        else:
            _atomic_json(directory / "last_failure.json", payload)
        return result


def run_phase(
    phase_plan: pd.DataFrame,
    *,
    repo_root: str | Path,
    work_root: str | Path,
    slim_path: str | Path,
    manifest_sha256: str,
    implementation_sources: Mapping[str, str],
    runtime: Mapping[str, Any],
    workers: int = 4,
    timeout_seconds: float = DEFAULT_DRAW_TIMEOUT_SECONDS,
) -> pd.DataFrame:
    if list(phase_plan.columns) != list(ROW_COLUMNS):
        raise ValueError("fixed-v2 phase plan columns differ")
    phases = set(phase_plan["phase"].astype(str))
    if len(phases) != 1 or not phases.issubset(PHASE_DRAW_COUNTS):
        raise ValueError("fixed-v2 phase plan must contain one known phase")
    phase = next(iter(phases))
    if len(phase_plan) != PHASE_DRAW_COUNTS[phase] * 6:
        raise ValueError("fixed-v2 phase plan draw count differs")
    if not 1 <= int(workers) <= 24:
        raise ValueError("fixed-v2 workers must be in [1, 24]")
    if set(phase_plan["timeout_seconds"].astype(float)) != {float(timeout_seconds)}:
        raise ValueError("fixed-v2 run timeout differs from manifest")
    root = Path(repo_root).resolve()
    work = _require_repo_path(work_root, root, label="phase work directory")
    slim = _require_repo_path(slim_path, root, label="SLiM executable")
    if dict(implementation_sources) != _implementation_sources(root):
        raise ValueError("fixed-v2 implementation source binding drifted")
    if dict(runtime) != _runtime_record(root, slim):
        raise ValueError("fixed-v2 runtime binding drifted")
    tasks = [
        {
            "row": _normalized_row(row),
            "repo_root": str(root),
            "work_root": str(work),
            "slim_path": str(slim),
            "timeout_seconds": float(timeout_seconds),
            "manifest_sha256": str(manifest_sha256),
            "implementation_sources": dict(implementation_sources),
            "runtime": dict(runtime),
        }
        for row in phase_plan.to_dict(orient="records")
    ]
    rows = []
    if int(workers) == 1:
        rows = [_run_draw(task) for task in tasks]
    else:
        with ProcessPoolExecutor(max_workers=int(workers)) as pool:
            futures = {pool.submit(_run_draw, task): task for task in tasks}
            for future in as_completed(futures):
                task = futures[future]
                try:
                    rows.append(future.result())
                except Exception as error:  # noqa: BLE001 - preserve worker failure
                    rows.append(
                        {
                            **task["row"],
                            "status": "failed",
                            "evaluable": False,
                            "terminal_class": "failed",
                            "candidate_pool_alt_count": None,
                            "candidate_pool_af": None,
                            "candidate_pool_frequency_gate_passed": False,
                            "exact_panel_feasible": False,
                            "hit": False,
                            "elapsed_seconds": np.nan,
                            "error": f"{type(error).__name__}: {error}",
                        }
                    )
    return pd.DataFrame(rows).sort_values("draw_id").reset_index(drop=True)


def _validate_result_row(result: Mapping[str, Any], row: Mapping[str, Any]) -> None:
    normalized_result_source = dict(result)
    if _blank_artifact_value(result.get("panel_seed")):
        unused_panel_fields = (
            "panel_record_json",
            "panel_identity_json",
            "panel_tree_path",
            "panel_tree_sha256",
            "panel_manifest_path",
            "panel_manifest_sha256",
            "panel_alt_count",
            "panel_af",
            "panel_hom_ref",
            "panel_heterozygous",
            "panel_hom_alt",
        )
        if (
            _coerce_boolean(result.get("hit"))
            or _coerce_boolean(result.get("panel_roundtrip_validated"))
            or any(
                not _blank_artifact_value(result.get(field))
                for field in unused_panel_fields
            )
        ):
            raise ValueError(
                "fixed-v2 null result panel seed requires a nonhit with no panel use"
            )
        # The manifest row and draw contract reserve this seed before execution.
        # The result field records whether the sampler was actually invoked, so
        # an otherwise-empty nonhit legitimately records null here.  Restore the
        # reserved value only in this comparison copy; never rewrite evidence.
        normalized_result_source["panel_seed"] = int(row["panel_seed"])
    if _normalized_row(normalized_result_source) != _normalized_row(row):
        raise ValueError("fixed-v2 completion row differs from its manifest row")


def _validate_passing_panel(
    result: Mapping[str, Any],
    row: Mapping[str, Any],
    directory: Path,
    expectation: Mapping[str, Any],
) -> None:
    tree_path = directory / str(result.get("panel_tree_path", ""))
    manifest_path = directory / str(result.get("panel_manifest_path", ""))
    if (
        tree_path.name != "accepted_panel.trees"
        or manifest_path.name != "accepted_panel_manifest.tsv"
        or not tree_path.is_file()
        or not manifest_path.is_file()
        or sha256_file(tree_path) != str(result.get("panel_tree_sha256", ""))
        or sha256_file(manifest_path) != str(result.get("panel_manifest_sha256", ""))
    ):
        raise ValueError("fixed-v2 passing panel artifact checksum failed")
    panel = tskit.load(tree_path)
    coordinate = int(row["focal_position_bp"])
    raw = str(row["phase"]) == PHASE_CONFIRMATION
    if raw:
        identity = _inspect_raw_selected_focal_identity(panel, expectation)
        if identity.get("status") != "valid":
            raise ValueError("fixed-v2 raw passing panel identity is invalid")
        counts = _selected_counts_from_raw_tree(panel, identity)
        rebuilt = build_diploid_pair_table(
            panel, coordinate, focal_genotype_counts=counts
        )
    else:
        validate_selected_focal_identity(panel, expectation)
        rebuilt = build_diploid_pair_table(panel, coordinate)
        counts = rebuilt["focal_selected_allele_count"].to_numpy(dtype=int)
    persisted = pd.read_csv(manifest_path, sep="\t")
    pd.testing.assert_frame_equal(
        rebuilt.reset_index(drop=True),
        persisted.reset_index(drop=True),
        check_dtype=False,
        check_exact=False,
        rtol=0.0,
        atol=1e-12,
    )
    n0, n1, n2 = (int(np.count_nonzero(counts == value)) for value in (0, 1, 2))
    if (
        len(counts) != SAMPLE_DIPLOIDS
        or int(np.sum(counts)) != int(row["exact_sample_alt_count"])
        or n0 < 2
        or n1 < 1
        or n2 < 2
        or int(result.get("panel_seed", -1)) != int(row["panel_seed"])
        or int(result.get("panel_alt_count", -1)) != int(np.sum(counts))
        or not math.isclose(
            float(result.get("panel_af", math.nan)),
            float(np.mean(counts) / 2),
            abs_tol=1e-12,
        )
        or (n0, n1, n2)
        != (
            int(result.get("panel_hom_ref", -1)),
            int(result.get("panel_heterozygous", -1)),
            int(result.get("panel_hom_alt", -1)),
        )
    ):
        raise ValueError("fixed-v2 passing panel semantics differ")


def _validate_evaluable_result(
    result: Mapping[str, Any],
    row: Mapping[str, Any],
    directory: Path,
    *,
    repo_root: Path,
    expectation_cache: dict[tuple[Any, ...], dict[str, Any]],
) -> None:
    if str(result.get("status")) != "complete" or not _coerce_boolean(
        result.get("evaluable")
    ):
        raise ValueError("fixed-v2 completion is not evaluable")
    required_true = (
        "post_screen_endpoint_selection",
        "fixed_selection_cessation",
        "recipient_nonloss_conditioning",
    )
    if any(not _coerce_boolean(result.get(column)) for column in required_true):
        raise ValueError("fixed-v2 completion lacks its model flags")
    if _coerce_boolean(result.get("exploratory_screen_inferential_use")):
        raise ValueError("fixed-v2 completion improperly uses exploratory data")
    if _coerce_boolean(result.get("internal_terminal_han_af_conditioning")):
        raise ValueError("fixed-v2 completion retained internal terminal AF rejection")
    normal = str(row["phase"]) == PHASE_SENSITIVITY
    if (
        _coerce_boolean(result.get("stdpopsim_recapitation_applied")) != normal
        or _coerce_boolean(result.get("post_slim_neutral_mutation_overlay_applied"))
        != normal
    ):
        raise ValueError("fixed-v2 completion processing mode differs")
    trajectory = directory / str(result.get("trajectory_path", ""))
    if (
        trajectory.name != "trajectory.csv"
        or not trajectory.is_file()
        or sha256_file(trajectory) != str(result.get("trajectory_sha256", ""))
    ):
        raise ValueError("fixed-v2 trajectory checksum failed")
    key = (
        float(row["selection_coefficient"]),
        float(row["target_allele_frequency"]),
        int(row["sequence_length_bp"]),
        int(row["focal_position_bp"]),
    )
    if key not in expectation_cache:
        model, sweep, _, model_record = build_fixed_v2_objects(row, repo_root=repo_root)
        expectation = _selected_focal_expectation(
            model, sweep, float(row["slim_scaling_factor"])
        )
        expectation["focal_position_0based"] = int(row["focal_position_bp"])
        expectation_cache[key] = {
            "expectation": expectation,
            "event_audit": model_record["event_audit"],
        }
    cached = expectation_cache[key]
    event_audit = json.loads(str(result.get("event_audit_json", "")))
    if (
        event_audit != cached["event_audit"]
        or event_audit.get("schema") != EVENT_AUDIT_SCHEMA
        or event_audit.get("external_terminal_ascertainment") is not True
        or int(event_audit.get("terminal_han_condition_count", -1)) != 0
        or event_audit.get("realized_event_schedule_sha256")
        != _canonical_sha256(event_audit.get("realized_q5_event_times_generations"))
        or event_audit.get("serialized_extended_events_sha256")
        != _canonical_sha256(event_audit.get("serialized_extended_events"))
    ):
        raise ValueError("fixed-v2 event audit differs")
    strict = _coerce_boolean(result.get("strict_type1_identity_passed"))
    gate = _coerce_boolean(result.get("candidate_pool_frequency_gate_passed"))
    feasible = _coerce_boolean(result.get("exact_panel_feasible"))
    roundtrip = _coerce_boolean(result.get("panel_roundtrip_validated"))
    hit = _coerce_boolean(result.get("hit"))
    if hit != bool(strict and gate and feasible and roundtrip):
        raise ValueError("fixed-v2 hit differs from its four gates")
    panel_tree = directory / "accepted_panel.trees"
    panel_manifest = directory / "accepted_panel_manifest.tsv"
    if not strict:
        if not normal or str(result.get("terminal_class")) != "identity_collision":
            raise ValueError("only sensitivity identity collisions may be evaluable")
        try:
            collision_identity = json.loads(str(result.get("identity_json", "")))
        except json.JSONDecodeError as error:
            raise ValueError(
                "fixed-v2 sensitivity identity collision evidence is unreadable"
            ) from error
        if not isinstance(collision_identity, Mapping):
            raise ValueError(
                "fixed-v2 sensitivity identity collision evidence is absent"
            )
        _validate_identity_collision_evidence(collision_identity)
        if result.get("identity_error") != (
            "valid_type1_with_neutral_overlay_recurrence"
        ):
            raise ValueError("fixed-v2 sensitivity identity collision label differs")
        if (
            result.get("candidate_pool_alt_count") is not None
            or result.get("candidate_pool_af") is not None
            or result.get("candidate_pool_frequency_gate_json") not in {None, ""}
            or any(
                result.get(field) not in {None, ""}
                for field in (
                    "panel_seed",
                    "panel_record_json",
                    "panel_identity_json",
                    "panel_tree_path",
                    "panel_tree_sha256",
                    "panel_manifest_path",
                    "panel_manifest_sha256",
                    "panel_alt_count",
                    "panel_af",
                    "panel_hom_ref",
                    "panel_heterozygous",
                    "panel_hom_alt",
                )
            )
            or gate
            or feasible
            or roundtrip
            or hit
            or panel_tree.exists()
            or panel_manifest.exists()
        ):
            raise ValueError("fixed-v2 identity collision passed a later gate")
        return
    alt_count = int(result.get("candidate_pool_alt_count", -1))
    af = float(result.get("candidate_pool_af", math.nan))
    haplotypes = 2 * CANDIDATE_POOL_DIPLOIDS
    if not 0 <= alt_count <= haplotypes or not math.isclose(
        af, alt_count / haplotypes, abs_tol=1e-12
    ):
        raise ValueError("fixed-v2 candidate-pool AF/count differ")
    expected_class = (
        "loss"
        if alt_count == 0
        else "fixed"
        if alt_count == haplotypes
        else "segregating"
    )
    if str(result.get("terminal_class")) != expected_class:
        raise ValueError("fixed-v2 terminal class differs from candidate-pool count")
    gate_record = json.loads(str(result.get("candidate_pool_frequency_gate_json", "")))
    if (
        _coerce_boolean(gate_record.get("passed")) != gate
        or int(gate_record.get("observed_alt_count", -1)) != alt_count
        or not math.isclose(
            float(gate_record.get("observed_af", math.nan)), af, abs_tol=1e-12
        )
    ):
        raise ValueError("fixed-v2 candidate-pool gate record differs")
    classes = gate_record.get("candidate_pool_genotype_counts")
    if not isinstance(classes, Mapping):
        raise TypeError("fixed-v2 candidate-pool genotype counts are absent")
    n0, n1, n2 = (
        int(classes.get("hom_ref", -1)),
        int(classes.get("heterozygous", -1)),
        int(classes.get("hom_alt", -1)),
    )
    if n0 + n1 + n2 != CANDIDATE_POOL_DIPLOIDS or n1 + 2 * n2 != alt_count:
        raise ValueError("fixed-v2 candidate-pool genotype counts differ")
    reconstructed = np.repeat(np.asarray([0, 1, 2]), [n0, n1, n2])
    expected_feasible = (
        bool(
            feasible_exact_panel_genotype_triples(
                reconstructed,
                sample_diploids=SAMPLE_DIPLOIDS,
                exact_alt_count=int(row["exact_sample_alt_count"]),
            )
        )
        if gate
        else False
    )
    if feasible != expected_feasible:
        raise ValueError("fixed-v2 exact-panel feasibility differs")
    if hit:
        _validate_passing_panel(result, row, directory, cached["expectation"])
    elif (
        roundtrip
        or result.get("panel_tree_path")
        or result.get("panel_manifest_path")
        or panel_tree.exists()
        or panel_manifest.exists()
    ):
        raise ValueError("fixed-v2 rejected draw retained panel artifacts")


def rebuild_phase_ledger(
    phase_plan: pd.DataFrame,
    *,
    repo_root: str | Path,
    work_root: str | Path,
    manifest_sha256: str,
    implementation_sources: Mapping[str, str],
    runtime: Mapping[str, Any],
) -> pd.DataFrame:
    """Rebuild authoritative evidence solely from per-draw terminal records."""

    root = Path(repo_root).resolve()
    work = _require_repo_path(work_root, root, label="phase work directory")
    expectation_cache: dict[tuple[Any, ...], dict[str, Any]] = {}
    results = []
    for raw in phase_plan.to_dict(orient="records"):
        row = _normalized_row(raw)
        directory = work / row["draw_id"]
        completion = directory / "completion.json"
        failure = directory / "last_failure.json"
        present = [path for path in (completion, failure) if path.is_file()]
        if len(present) != 1:
            raise ValueError(
                f"fixed-v2 draw must have exactly one terminal record: {row['draw_id']}"
            )
        try:
            payload = json.loads(present[0].read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError(
                f"fixed-v2 draw record is unreadable: {row['draw_id']}"
            ) from error
        contract = _draw_contract(
            row,
            manifest_sha256=manifest_sha256,
            implementation_sources=implementation_sources,
            runtime=runtime,
        )
        if (
            payload.get("schema") != DRAW_SCHEMA
            or payload.get("contract") != contract
            or payload.get("contract_sha256") != _canonical_sha256(contract)
        ):
            raise ValueError(f"fixed-v2 draw contract differs: {row['draw_id']}")
        result = payload.get("result")
        if not isinstance(result, Mapping):
            raise TypeError(f"fixed-v2 draw result is absent: {row['draw_id']}")
        _validate_result_row(result, row)
        evaluable = _coerce_boolean(result.get("evaluable"))
        if present[0] == completion:
            if not evaluable:
                raise ValueError("fixed-v2 completion contains unevaluable data")
            _validate_evaluable_result(
                result,
                row,
                directory,
                repo_root=root,
                expectation_cache=expectation_cache,
            )
        elif evaluable or str(result.get("status")) not in {"failed", "timed_out"}:
            raise ValueError("fixed-v2 failure record contains evaluable data")
        results.append(dict(result))
    return pd.DataFrame(results).sort_values("draw_id").reset_index(drop=True)


def summarize_phase(
    phase_plan: pd.DataFrame, ledger: pd.DataFrame
) -> tuple[pd.DataFrame, dict[str, Any]]:
    if list(phase_plan.columns) != list(ROW_COLUMNS):
        raise ValueError("fixed-v2 phase plan columns differ")
    phases = set(phase_plan["phase"].astype(str))
    if len(phases) != 1:
        raise ValueError("fixed-v2 summary requires one phase")
    phase = next(iter(phases))
    if phase not in PHASE_DRAW_COUNTS:
        raise ValueError("fixed-v2 phase is unknown")
    expected = PHASE_DRAW_COUNTS[phase]
    if len(phase_plan) != expected * 6:
        raise ValueError("fixed-v2 phase plan does not cover six cells")
    if (
        set(phase_plan["draw_id"]) != set(ledger["draw_id"])
        or ledger["draw_id"].duplicated().any()
    ):
        raise ValueError("fixed-v2 ledger does not exactly cover its plan")
    plan_index = phase_plan.set_index("draw_id")
    for result in ledger.to_dict(orient="records"):
        row = plan_index.loc[str(result["draw_id"])].to_dict()
        row["draw_id"] = str(result["draw_id"])
        _validate_result_row(result, row)
    evaluable = ledger["evaluable"].map(_coerce_boolean)
    hits = ledger["hit"].map(_coerce_boolean)
    if (hits & ~evaluable).any():
        raise ValueError("fixed-v2 unevaluable draw cannot be a hit")
    merged = phase_plan.merge(
        ledger[
            [
                "draw_id",
                "evaluable",
                "terminal_class",
                "candidate_pool_af",
                "candidate_pool_frequency_gate_passed",
                "exact_panel_feasible",
                "hit",
                "elapsed_seconds",
                "error",
            ]
        ],
        on="draw_id",
        how="left",
        validate="one_to_one",
    )
    rows = []
    for keys, group in merged.groupby(
        [
            "phase",
            "selection_coefficient",
            "target_allele_frequency",
            "duration_multiplier",
            "realized_selection_end_generations_ago",
        ],
        sort=True,
    ):
        phase_value, coefficient, target, multiplier, endpoint = keys
        group_evaluable = group["evaluable"].map(_coerce_boolean)
        group_hits = group["hit"].map(_coerce_boolean) & group_evaluable
        af = pd.to_numeric(
            group.loc[group_evaluable, "candidate_pool_af"], errors="coerce"
        )
        rows.append(
            {
                "phase": str(phase_value),
                "selection_coefficient": float(coefficient),
                "target_allele_frequency": float(target),
                "duration_multiplier": float(multiplier),
                "realized_selection_end_generations_ago": float(endpoint),
                "n_planned": len(group),
                "n_evaluable": int(group_evaluable.sum()),
                "n_hits": int(group_hits.sum()),
                "required_hits": PHASE_REQUIRED_HITS[phase],
                "hit_rate_fixed_denominator": float(group_hits.sum() / len(group)),
                "n_identity_collision": int(
                    group["terminal_class"].astype(str).eq("identity_collision").sum()
                ),
                "n_loss": int(group["terminal_class"].astype(str).eq("loss").sum()),
                "n_fixed": int(group["terminal_class"].astype(str).eq("fixed").sum()),
                "median_candidate_pool_af": (
                    float(af.median()) if af.notna().any() else np.nan
                ),
                "total_elapsed_seconds": float(
                    pd.to_numeric(group["elapsed_seconds"], errors="coerce").sum()
                ),
            }
        )
    summary = pd.DataFrame(rows)
    all_evaluable = bool(
        (summary["n_planned"] == expected).all()
        and (summary["n_evaluable"] == expected).all()
    )
    all_hits = bool((summary["n_hits"] >= PHASE_REQUIRED_HITS[phase]).all())
    return summary, {
        "schema": AUDIT_SCHEMA,
        "phase": phase,
        "status": "passed" if all_evaluable and all_hits else "failed",
        "model_mode": MODEL_MODE,
        "draws_per_cell": expected,
        "required_hits_per_cell": PHASE_REQUIRED_HITS[phase],
        "required_rate_equivalent": PHASE_REQUIRED_HITS[phase] / expected,
        "all_draws_evaluable": all_evaluable,
        "all_six_cells_passed": all_hits,
        "exploratory_screen_inferential_use": False,
        "endpoint_rule_changed_after_exploratory_screen": True,
        "gamma_smc_statistics_used": False,
        "identity_collisions_count_as_hits": False,
    }


def write_phase_audit(
    phase: str,
    *,
    repo_root: str | Path,
    output_dir: str | Path,
    work_root: str | Path,
    manifest_path: str | Path,
) -> dict[str, Any]:
    if phase not in PHASE_DRAW_COUNTS:
        raise ValueError("fixed-v2 phase is unknown")
    root = Path(repo_root).resolve()
    output = _require_repo_path(output_dir, root, label="phase audit output")
    manifest, frame, manifest_sha256 = load_manifest(
        manifest_path, repo_root=root, require_current_sources=True
    )
    plan = frame[frame["phase"].astype(str).eq(phase)].reset_index(drop=True)
    ledger = rebuild_phase_ledger(
        plan,
        repo_root=root,
        work_root=work_root,
        manifest_sha256=manifest_sha256,
        implementation_sources=manifest["implementation_sources"],
        runtime=manifest["runtime"],
    )
    summary, audit = summarize_phase(plan, ledger)
    ledger_path = output / f"{phase}_draws.tsv"
    summary_path = output / f"{phase}_summary.tsv"
    audit_path = output / f"{phase}_audit.json"
    _atomic_frame(ledger_path, ledger)
    _atomic_frame(summary_path, summary)
    payload = {
        **audit,
        "manifest_sha256": manifest_sha256,
        "runtime": manifest["runtime"],
        "implementation_sources": manifest["implementation_sources"],
        "exploratory_screen_ledger_sha256": manifest["exploratory_screen"][
            "canonical_ledger_sha256"
        ],
        "artifacts": {
            ledger_path.name: sha256_file(ledger_path),
            summary_path.name: sha256_file(summary_path),
        },
    }
    _atomic_json(audit_path, payload)
    return payload


def _require_passed_audit(
    path: Path,
    *,
    phase: str,
    manifest_sha256: str,
    runtime: Mapping[str, Any],
    implementation_sources: Mapping[str, str],
) -> dict[str, Any]:
    try:
        audit = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"fixed-v2 {phase} audit is unreadable") from error
    if (
        audit.get("schema") != AUDIT_SCHEMA
        or audit.get("phase") != phase
        or audit.get("status") != "passed"
        or audit.get("manifest_sha256") != manifest_sha256
        or audit.get("runtime") != runtime
        or audit.get("implementation_sources") != implementation_sources
        or audit.get("exploratory_screen_inferential_use") is not False
        or int(audit.get("required_hits_per_cell", -1)) != PHASE_REQUIRED_HITS[phase]
    ):
        raise ValueError(f"fixed-v2 {phase} audit has not passed")
    artifacts = audit.get("artifacts")
    expected = {f"{phase}_draws.tsv", f"{phase}_summary.tsv"}
    if not isinstance(artifacts, Mapping) or set(artifacts) != expected:
        raise ValueError(f"fixed-v2 {phase} audit artifacts differ")
    for name, digest in artifacts.items():
        child = path.parent / str(name)
        if not child.is_file() or sha256_file(child) != str(digest):
            raise ValueError(f"fixed-v2 {phase} audited child checksum failed")
    return audit


def _production_endpoint_table(endpoints: pd.DataFrame) -> pd.DataFrame:
    rows = []
    for row in endpoints.sort_values(
        ["selection_coefficient", "target_allele_frequency"],
        ascending=[False, True],
    ).to_dict(orient="records"):
        coefficient = float(row["selection_coefficient"])
        target = float(row["target_allele_frequency"])
        analytic = _analytic_endpoint(coefficient, target)
        rows.append(
            {
                "selection_coefficient": coefficient,
                "target_allele_frequency": target,
                "population_af_lower": float(row["population_af_lower"]),
                "population_af_upper": float(row["population_af_upper"]),
                "duration_multiplier": float(row["duration_multiplier"]),
                "analytic_selection_end_generations_ago": analytic,
                "analytic_selection_duration_generations": (
                    INTROGRESSION_PULSE_GENERATIONS - analytic
                ),
                "requested_selection_end_generations_ago": float(
                    row["requested_selection_end_generations_ago"]
                ),
                "realized_selection_end_generations_ago": float(
                    row["realized_selection_end_generations_ago"]
                ),
                "slim_scaling_factor": SLIM_SCALING_FACTOR,
            }
        )
    return pd.DataFrame(rows)


def finalize_fixed_v2(
    *,
    manifest_path: str | Path,
    repo_root: str | Path,
    output_dir: str | Path,
    phase_work_roots: Mapping[str, str | Path],
) -> dict[str, Any]:
    """Freeze a production-loader-compatible artifact only after both gates."""

    root = Path(repo_root).resolve()
    output = _require_repo_path(output_dir, root, label="frozen output")
    manifest, frame, manifest_sha256 = load_manifest(
        manifest_path, repo_root=root, require_current_sources=True
    )
    if set(phase_work_roots) != set(PHASE_DRAW_COUNTS):
        raise ValueError("fixed-v2 finalizer requires both phase work roots")
    summaries = {}
    artifacts: dict[str, str] = {Path(manifest_path).name: manifest_sha256}
    for phase in PHASE_DRAW_COUNTS:
        audit_path = output / f"{phase}_audit.json"
        audit = _require_passed_audit(
            audit_path,
            phase=phase,
            manifest_sha256=manifest_sha256,
            runtime=manifest["runtime"],
            implementation_sources=manifest["implementation_sources"],
        )
        plan = frame[frame["phase"].astype(str).eq(phase)].reset_index(drop=True)
        rebuilt = rebuild_phase_ledger(
            plan,
            repo_root=root,
            work_root=phase_work_roots[phase],
            manifest_sha256=manifest_sha256,
            implementation_sources=manifest["implementation_sources"],
            runtime=manifest["runtime"],
        )
        ledger_path = output / f"{phase}_draws.tsv"
        summary_path = output / f"{phase}_summary.tsv"
        persisted_ledger = pd.read_csv(ledger_path, sep="\t")
        _assert_frame_equivalent(rebuilt, persisted_ledger)
        summary, recomputed = summarize_phase(plan, rebuilt)
        if recomputed["status"] != "passed":
            raise ValueError(f"fixed-v2 {phase} no longer passes")
        persisted_summary = pd.read_csv(summary_path, sep="\t")
        _assert_frame_equivalent(summary, persisted_summary)
        for child in (ledger_path, summary_path):
            if sha256_file(child) != audit["artifacts"].get(child.name):
                raise ValueError(f"fixed-v2 {phase} child checksum failed")
            artifacts[child.name] = sha256_file(child)
        artifacts[audit_path.name] = sha256_file(audit_path)
        summaries[phase] = summary
    endpoints = endpoint_table()
    selected_path = output / "han_selection_end_selected.tsv"
    selected = _production_endpoint_table(endpoints)
    _immutable_frame(selected_path, selected)
    artifacts[selected_path.name] = sha256_file(selected_path)
    # The existing production loader requires these names. They are immutable
    # v2 provenance tables, not aliases to the exploratory v1 screen.
    plan_path = output / "han_selection_end_plan.tsv"
    terminal_path = output / "han_selection_end_terminal_draws.tsv"
    summary_path = output / "han_selection_end_summary.tsv"
    _immutable_frame(plan_path, frame)
    combined_ledger = (
        pd.concat(
            [
                pd.read_csv(output / f"{phase}_draws.tsv", sep="\t")
                for phase in PHASE_DRAW_COUNTS
            ],
            ignore_index=True,
        )
        .sort_values("draw_id")
        .reset_index(drop=True)
    )
    _immutable_frame(terminal_path, combined_ledger)
    combined_summary = pd.concat(
        [summaries[phase] for phase in PHASE_DRAW_COUNTS], ignore_index=True
    )
    _immutable_frame(summary_path, combined_summary)
    for child in (plan_path, terminal_path, summary_path):
        artifacts[child.name] = sha256_file(child)
    cells = {}
    mapping = {}
    for endpoint in endpoints.to_dict(orient="records"):
        coefficient = float(endpoint["selection_coefficient"])
        target = float(endpoint["target_allele_frequency"])
        key = f"s={coefficient:.6f}|af={target:.6f}"
        entry = {
            "selection_coefficient": coefficient,
            "target_allele_frequency": target,
            "duration_multiplier": float(endpoint["duration_multiplier"]),
            "requested_selection_end_generations_ago": float(
                endpoint["requested_selection_end_generations_ago"]
            ),
            "realized_selection_end_generations_ago": float(
                endpoint["realized_selection_end_generations_ago"]
            ),
            "endpoint_selected_post_screen": True,
            "exploratory_screen_inferential_use": False,
        }
        for phase, phase_summary in summaries.items():
            row = phase_summary[
                np.isclose(phase_summary["selection_coefficient"], coefficient)
                & np.isclose(phase_summary["target_allele_frequency"], target)
            ]
            if len(row) != 1:
                raise ValueError("fixed-v2 summary lacks one endpoint cell")
            record = row.iloc[0]
            entry[f"{phase}_n_hits"] = int(record["n_hits"])
            entry[f"{phase}_n_evaluable"] = int(record["n_evaluable"])
            entry[f"{phase}_hit_rate"] = float(record["hit_rate_fixed_denominator"])
        cells[key] = dict(entry)
        mapping[key] = dict(entry)
    execution_units_path = root / manifest["production_execution_units"]["path"]
    production_seed_digest = manifest["production_execution_units"][
        "production_seed_digest"
    ]
    production_contract = {
        "schema": HAN_SELECTION_PRODUCTION_CONTRACT_SCHEMA,
        "slim_scaling_factor": SLIM_SCALING_FACTOR,
        "candidate_pool_diploids": CANDIDATE_POOL_DIPLOIDS,
        "af_half_width": AF_HALF_WIDTH,
        "selection_coefficients": sorted(SELECTION_COEFFICIENTS),
        "target_allele_frequencies": sorted(TARGET_FREQUENCIES),
        "selection_grid": [
            {
                "selection_coefficient": coefficient,
                "target_allele_frequency": target,
            }
            for coefficient in sorted(SELECTION_COEFFICIENTS)
            for target in sorted(TARGET_FREQUENCIES)
        ],
        "selection_endpoint_mode": (
            "fixed_endpoint_from_disjoint_terminal_af_calibration"
        ),
        "post_pulse_recipient_nonloss_conditioning": True,
        "endpoint_selection_timing": "post_exploratory_screen",
        "exploratory_screen_inferential_use": False,
        "confirmation_draws_per_cell": PHASE_DRAW_COUNTS[PHASE_CONFIRMATION],
        "confirmation_minimum_hits_per_cell": PHASE_REQUIRED_HITS[PHASE_CONFIRMATION],
        "confirmation_passed": True,
        "ten_mb_sensitivity_required_before_freeze": True,
        "ten_mb_sensitivity_draws_per_cell": PHASE_DRAW_COUNTS[PHASE_SENSITIVITY],
        "ten_mb_sensitivity_minimum_hits_per_cell": PHASE_REQUIRED_HITS[
            PHASE_SENSITIVITY
        ],
        "ten_mb_sensitivity_passed": True,
    }
    loader_payload = {
        "schema": HAN_SELECTION_CALIBRATION_SCHEMA,
        "status": "frozen",
        "selection_rule": (
            "post-screen fixed endpoint table; exploratory screen descriptive only; "
            "authorization from fresh confirmation and 10-Mb sensitivity"
        ),
        "minimum_band_hit_rate": 0.10,
        "gamma_smc_statistics_used": False,
        "production_seed_digest": production_seed_digest,
        "production_contract": production_contract,
        "mapping": mapping,
        "artifacts": dict(sorted(artifacts.items())),
    }
    frozen_path = output / "han_selection_end_frozen.json"
    _immutable_json(frozen_path, loader_payload)
    # Prove byte-level loader compatibility at this explicit v2 path without
    # importing it into the campaign or changing production source.
    binding = load_frozen_han_selection_calibration(
        frozen_path,
        repo_root=root,
        execution_units_path=execution_units_path,
        slim_scaling_factor=SLIM_SCALING_FACTOR,
        candidate_pool_diploids=CANDIDATE_POOL_DIPLOIDS,
    )
    auxiliary = {
        "schema": FROZEN_AUX_SCHEMA,
        "status": "frozen",
        "loader_compatible_frozen_path": frozen_path.relative_to(root).as_posix(),
        "loader_compatible_frozen_sha256": sha256_file(frozen_path),
        "production_loader_binding_sha256": _canonical_sha256(binding),
        "production_integration_status": "not_wired_into_campaign_executor",
        "model_mode": MODEL_MODE,
        "manifest_sha256": manifest_sha256,
        "endpoint_rule_changed_after_exploratory_screen": True,
        "exploratory_screen_inferential_use": False,
        "fresh_validation_only": True,
        "all_confirmation_and_sensitivity_gates_passed": True,
        "gamma_smc_statistics_used": False,
        "cells": cells,
        "seed_registry": manifest["seed_registry"],
        "runtime": manifest["runtime"],
        "implementation_sources": manifest["implementation_sources"],
        "source_snapshots": manifest["source_snapshots"],
        "artifacts": dict(sorted(artifacts.items())),
    }
    auxiliary_path = output / "han_fixed_v2_authorization.json"
    _immutable_json(auxiliary_path, auxiliary)
    return auxiliary


def load_frozen_fixed_v2(
    path: str | Path,
    *,
    repo_root: str | Path,
    manifest_path: str | Path,
) -> dict[str, Any]:
    root = Path(repo_root).resolve()
    auxiliary_path = _require_repo_path(path, root, label="authorization")
    try:
        payload = json.loads(auxiliary_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("fixed-v2 authorization is unreadable") from error
    manifest, _, manifest_sha256 = load_manifest(
        manifest_path, repo_root=root, require_current_sources=True
    )
    if (
        payload.get("schema") != FROZEN_AUX_SCHEMA
        or payload.get("status") != "frozen"
        or payload.get("manifest_sha256") != manifest_sha256
        or payload.get("production_integration_status")
        != "not_wired_into_campaign_executor"
        or payload.get("endpoint_rule_changed_after_exploratory_screen") is not True
        or payload.get("exploratory_screen_inferential_use") is not False
        or payload.get("fresh_validation_only") is not True
        or payload.get("all_confirmation_and_sensitivity_gates_passed") is not True
        or payload.get("gamma_smc_statistics_used") is not False
    ):
        raise ValueError("fixed-v2 authorization semantics differ")
    frozen = _require_repo_path(
        root / str(payload.get("loader_compatible_frozen_path", "")),
        root,
        label="loader-compatible frozen artifact",
    )
    if not frozen.is_file() or sha256_file(frozen) != payload.get(
        "loader_compatible_frozen_sha256"
    ):
        raise ValueError("fixed-v2 loader-compatible frozen artifact differs")
    execution_units = root / manifest["production_execution_units"]["path"]
    binding = load_frozen_han_selection_calibration(
        frozen,
        repo_root=root,
        execution_units_path=execution_units,
        slim_scaling_factor=SLIM_SCALING_FACTOR,
        candidate_pool_diploids=CANDIDATE_POOL_DIPLOIDS,
    )
    if _canonical_sha256(binding) != payload.get("production_loader_binding_sha256"):
        raise ValueError("fixed-v2 production loader binding differs")
    cells = payload.get("cells")
    if not isinstance(cells, Mapping) or len(cells) != 6:
        raise ValueError("fixed-v2 authorization does not contain six cells")
    for record in cells.values():
        if (
            int(record.get("confirmation_n_evaluable", -1)) != 100
            or int(record.get("confirmation_n_hits", -1)) < 10
            or int(record.get("sensitivity_10mb_n_evaluable", -1)) != 20
            or int(record.get("sensitivity_10mb_n_hits", -1)) < 2
        ):
            raise ValueError("fixed-v2 authorization cell failed a fresh gate")
    return payload


def _campaign_paths(
    repo_root: Path, campaign_dir: str | Path
) -> tuple[Path, Path, Path]:
    campaign = Path(campaign_dir)
    if not campaign.is_absolute():
        campaign = repo_root / campaign
    campaign = _require_repo_path(campaign, repo_root, label="campaign directory")
    output = _require_repo_path(
        campaign / "calibration/han_fixed_cessation_v2",
        repo_root,
        label="calibration output",
    )
    work = _require_repo_path(
        campaign / "work/han_fixed_cessation_v2",
        repo_root,
        label="calibration work",
    )
    return campaign, output, work


def _default_seed_exclusion_paths(campaign: Path) -> list[Path]:
    own_projection = (
        campaign / "calibration/han_fixed_cessation_v2/han_fixed_v2_all_phase_plan.tsv"
    ).resolve()
    candidates = [
        campaign / "execution_units.tsv",
        campaign / "calibration/exploratory_seed_provenance/"
        "exploratory_seed_reservation.tsv",
        campaign / "calibration/han_selection_end_plan.tsv",
        campaign / "calibration/han_selection_end_extension_plan.tsv",
        campaign / "calibration/han_selection_end_reconciliation_plan.tsv",
        campaign / "calibration/han_frequency_conditioned_all_phase_plan.tsv",
        campaign / "calibration/eas_selected/screen20_plan.tsv",
        campaign / "calibration/eas_selected/confirm100_plan.tsv",
        campaign / "calibration/eas_selected/sensitivity10mb20_plan.tsv",
    ]
    # Future isolated streams are automatically reserved if their canonical
    # projections exist before this manifest is created.
    retry_quarantine = (
        campaign / "calibration/han_fixed_v2_retry_quarantine"
    ).resolve()
    candidates.extend(
        path
        for path in sorted((campaign / "calibration").glob("**/*all_phase_plan.tsv"))
        if not path.resolve().is_relative_to(retry_quarantine)
    )
    unique = []
    seen = set()
    for path in candidates:
        resolved = path.resolve()
        # A repeated `plan` invocation must rebuild against the same upstream
        # reservations; treating this module's already-published projection as
        # an upstream stream would perturb every seed and break idempotence.
        if resolved != own_projection and resolved not in seen:
            seen.add(resolved)
            unique.append(resolved)
    absent = [path for path in unique if not path.is_file()]
    if absent:
        raise ValueError(
            "fixed-v2 seed exclusion artifact is absent: "
            + ", ".join(path.name for path in absent)
        )
    return unique


def _default_retry_provenance_paths(campaign: Path) -> list[Path]:
    quarantine = campaign / "calibration/han_fixed_v2_retry_quarantine"
    if not quarantine.is_dir():
        return []
    return sorted(quarantine.glob("*/quarantine_inventory.json"))


def _phase_prerequisites(phase: str) -> tuple[str, ...]:
    return {
        PHASE_CONFIRMATION: (),
        PHASE_SENSITIVITY: (PHASE_CONFIRMATION,),
    }[phase]


def _require_phase_prerequisites(
    phase: str,
    *,
    output: Path,
    manifest_sha256: str,
    manifest: Mapping[str, Any],
) -> None:
    for prerequisite in _phase_prerequisites(phase):
        _require_passed_audit(
            output / f"{prerequisite}_audit.json",
            phase=prerequisite,
            manifest_sha256=manifest_sha256,
            runtime=manifest["runtime"],
            implementation_sources=manifest["implementation_sources"],
        )


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Plan, run, audit, and freeze the isolated post-screen Han fixed-"
            "cessation v2 validation."
        )
    )
    parser.add_argument(
        "command",
        choices=(
            "plan",
            "quarantine-audit",
            "confirmation-run",
            "confirmation-audit",
            "sensitivity-run",
            "sensitivity-audit",
            "finalize",
        ),
    )
    parser.add_argument("--repo-root", type=Path, default=Path.cwd())
    parser.add_argument(
        "--campaign-dir", type=Path, default=Path("focused_selection_EAS_sim")
    )
    parser.add_argument(
        "--slim-bin", type=Path, default=Path(".native-stdpopsim/bin/slim")
    )
    parser.add_argument("--workers", type=int, default=4)
    parser.add_argument(
        "--timeout-seconds", type=float, default=DEFAULT_DRAW_TIMEOUT_SECONDS
    )
    parser.add_argument("--quarantine-dir", type=Path)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    if not 1 <= int(args.workers) <= 24:
        raise ValueError("fixed-v2 workers must be in [1, 24]")
    if not math.isclose(
        float(args.timeout_seconds), DEFAULT_DRAW_TIMEOUT_SECONDS, abs_tol=1e-12
    ):
        raise ValueError("fixed-v2 timeout is frozen at 1800 seconds")
    root = Path(args.repo_root).resolve()
    campaign, output, work = _campaign_paths(root, args.campaign_dir)
    if args.command == "quarantine-audit":
        if args.quarantine_dir is None:
            raise ValueError("fixed-v2 quarantine audit requires --quarantine-dir")
        quarantine = args.quarantine_dir
        if not quarantine.is_absolute():
            quarantine = root / quarantine
        payload = write_retry_quarantine_inventory(quarantine, repo_root=root)
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    slim = Path(args.slim_bin)
    if not slim.is_absolute():
        slim = root / slim
    slim = _require_repo_path(slim, root, label="SLiM executable")
    manifest_path = output / "han_fixed_v2_manifest.json"
    if args.command == "plan":
        manifest = build_atomic_manifest(
            HanFixedV2Design(),
            repo_root=root,
            slim_path=slim,
            excluded_seed_artifacts=_default_seed_exclusion_paths(campaign),
            retry_provenance_artifacts=_default_retry_provenance_paths(campaign),
        )
        written = write_atomic_manifest(manifest, manifest_path, repo_root=root)
        print(
            json.dumps(
                {
                    "status": "planned",
                    "manifest": str(manifest_path),
                    "manifest_sha256": sha256_file(manifest_path),
                    "draws": len(written["rows"]),
                    "phase_draws_per_cell": PHASE_DRAW_COUNTS,
                    "phase_required_hits_per_cell": PHASE_REQUIRED_HITS,
                    "all_phase_simulation_and_panel_seeds_reserved_atomically": True,
                    "exploratory_screen_inferential_use": False,
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 0
    manifest, frame, manifest_sha256 = load_manifest(
        manifest_path, repo_root=root, require_current_sources=True
    )
    command_to_phase = {
        "confirmation-run": PHASE_CONFIRMATION,
        "confirmation-audit": PHASE_CONFIRMATION,
        "sensitivity-run": PHASE_SENSITIVITY,
        "sensitivity-audit": PHASE_SENSITIVITY,
    }
    if args.command in command_to_phase:
        phase = command_to_phase[args.command]
        _require_phase_prerequisites(
            phase,
            output=output,
            manifest_sha256=manifest_sha256,
            manifest=manifest,
        )
        plan = frame[frame["phase"].astype(str).eq(phase)].reset_index(drop=True)
        phase_work = work / phase
        if args.command.endswith("-run"):
            ledger = run_phase(
                plan,
                repo_root=root,
                work_root=phase_work,
                slim_path=slim,
                manifest_sha256=manifest_sha256,
                implementation_sources=manifest["implementation_sources"],
                runtime=manifest["runtime"],
                workers=args.workers,
                timeout_seconds=args.timeout_seconds,
            )
            output.mkdir(parents=True, exist_ok=True)
            snapshot = output / f"{phase}_run_snapshot.tsv"
            _atomic_frame(snapshot, ledger)
            complete = bool(ledger["evaluable"].map(_coerce_boolean).all())
            print(
                json.dumps(
                    {
                        "phase": phase,
                        "status": "complete" if complete else "retry_required",
                        "planned": len(plan),
                        "evaluable": int(
                            ledger["evaluable"].map(_coerce_boolean).sum()
                        ),
                        "snapshot": str(snapshot),
                        "snapshot_sha256": sha256_file(snapshot),
                    },
                    indent=2,
                    sort_keys=True,
                )
            )
            return 0 if complete else 2
        audit = write_phase_audit(
            phase,
            repo_root=root,
            output_dir=output,
            work_root=phase_work,
            manifest_path=manifest_path,
        )
        print(json.dumps(audit, indent=2, sort_keys=True))
        return 0 if audit["status"] == "passed" else 2
    phase_roots = {phase: work / phase for phase in PHASE_DRAW_COUNTS}
    payload = finalize_fixed_v2(
        manifest_path=manifest_path,
        repo_root=root,
        output_dir=output,
        phase_work_roots=phase_roots,
    )
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
